{
  "name": "a3s-ui-website",
  "version": "0.0.0",
  "description": "Official A3S UI design system and component documentation.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prepare:assets && rspress build",
    "check:site": "node scripts/check-built-site.mjs",
    "dev": "npm run prepare:assets && rspress dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "preview": "rspress preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rspress/core": "^2.0.17",
    "chart.js": "^4.5.1",
    "monaco-editor": "0.53.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.1.17",
    "typescript": "^6.0.3"
  }
}
