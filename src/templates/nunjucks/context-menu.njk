{#
  Renders a context menu component.

  @param trigger {string} - HTML for the invocation surface.
  @param label {string} - Accessible menu label.
  @param id {string} [optional] - Unique component id.
  @param main_attrs {object} [optional] - Extra root attributes.
  @param trigger_attrs {object} [optional] - Extra invocation-surface attributes.
  @param menu_attrs {object} [optional] - Extra menu attributes.
#}
{% macro context_menu(
  trigger,
  label="Context menu",
  id=None,
  main_attrs={},
  trigger_attrs={},
  menu_attrs={}
) %}
{% set id = id or ("context-menu-" + (range(100000, 999999) | random | string)) %}

<div
  id="{{ id }}"
  class="context-menu {{ main_attrs.class }}"
  {% for key, value in main_attrs %}
    {% if key != "class" %}{{ key }}="{{ value }}"{% endif %}
  {% endfor %}
>
  <div
    id="{{ id }}-trigger"
    data-context-trigger
    tabindex="0"
    {% for key, value in trigger_attrs %}
      {% if key != "tabindex" %}{{ key }}="{{ value }}"{% endif %}
    {% endfor %}
  >
    {{ trigger | safe }}
  </div>
  <div
    id="{{ id }}-menu"
    data-context-content
    role="menu"
    aria-label="{{ label }}"
    aria-hidden="true"
    {% for key, value in menu_attrs %}
      {% if key != "role" and key != "aria-label" and key != "aria-hidden" %}{{ key }}="{{ value }}"{% endif %}
    {% endfor %}
  >
    {{ caller() if caller }}
  </div>
</div>
{% endmacro %}
