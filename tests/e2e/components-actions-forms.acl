        press "skip-disabled-option" { key = "ArrowDown" }
        expect "last-enabled-option-active" { visible = css("#select-disabled-option-trigger[aria-activedescendant=select-disabled-option-option-3]") }
        press "commit-enabled-option" { key = "Enter" }
        expect "enabled-option-selected" { visible = css("#select-disabled-option:has([role=option][data-value=pineapple][aria-selected=true]) #select-disabled-option-trigger[aria-expanded=false]:focus") }
        screenshot "select-keyboard-and-disabled-option" { path = "components/select-keyboard-and-disabled-option.png" }

        expect "disabled-trigger-locked" { visible = css("#select-disabled-trigger[disabled][aria-expanded=false]") }
        expect "invalid-field-presentation" { visible = css(".field[data-invalid=true]:has(#select-invalid-trigger[aria-invalid=true])") }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=select][data-preview-integration=complete] [data-preview-control=states]") }
