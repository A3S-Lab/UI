        fill "recover-owner-email" { target = css("#form-workspace-owner-en") value = "owner@example.com" }
        focus "focus-save-valid" { target = css("form[data-form-primary-demo=en] button[type=submit]") }
        press "submit-valid-form" { key = "Enter" }
        wait "submitting-state" { visible = css("form[data-form-primary-demo=en][data-state=submitting][aria-busy=true][data-form-submissions='1']:has(button[type=submit][disabled])") }
        expect "duplicate-submit-blocked-while-busy" { visible = css("form[data-form-primary-demo=en][aria-busy=true][data-form-submissions='1']:has(button[type=submit][disabled])") }
        click "repeat-while-busy" { target = css("form[data-form-primary-demo=en] button[type=submit][disabled]") }
        expect "submission-count-unchanged" { visible = css("form[data-form-primary-demo=en][data-form-submissions='1'][aria-busy=true]:has(button[type=submit][disabled])") }
        wait "success-state" { visible = css("form[data-form-primary-demo=en][data-state=success]:not([aria-busy]):not([aria-invalid])") }
        expect "success-preserves-values" { visible = css("form[data-form-primary-demo=en][data-state=success][data-form-submissions='1']:has(#form-workspace-name-en:not([aria-invalid])):has(#form-workspace-owner-en:not([aria-invalid])):has(#form-summary-en[hidden])") }
