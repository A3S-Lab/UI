    scenario "slider" {
        name = "Slider preserves unit-aware keyboard endpoints, disabled guidance, RTL direction, state matrix, and Chinese phone confirmation"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/slider.html" }
        wait "loaded" { load = "networkidle" }
