    scenario "select" {
        name = "Select exposes a named trigger and predictable keyboard and disabled-option behavior"
        surface = "web"
        timeout_ms = 75000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/select.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "trigger-is-named" { visible = css("#select-demo-trigger[aria-label='Fruit'][role=combobox]") }

        focus "focus-trigger" { target = css("#select-demo-trigger") }
        press "open-at-end" { key = "End" }
        expect "last-option-active" { visible = css("#select-demo-trigger[aria-expanded=true][aria-activedescendant=select-demo-option-5]") }
        press "choose-last-option" { key = "Enter" }
        expect "pineapple-selected" { visible = css("#select-demo:has([role=option][data-value=pineapple][aria-selected=true]) #select-demo-trigger[aria-expanded=false]:focus") }

        press "typeahead-banana" { key = "b" }
        expect "banana-active" { visible = css("#select-demo-trigger[aria-expanded=true][aria-activedescendant=select-demo-option-2]") }
        press "cancel-typeahead" { key = "Escape" }
        expect "cancel-preserves-value-and-focus" { visible = css("#select-demo:has([role=option][data-value=pineapple][aria-selected=true]) #select-demo-trigger[aria-expanded=false]:focus:not([aria-activedescendant])") }

        focus "focus-disabled-option-trigger" { target = css("#select-disabled-option-trigger") }
        press "open-disabled-option-list" { key = "Enter" }
        expect "disabled-option-trigger-expanded" { visible = css("#select-disabled-option-trigger[aria-expanded=true]") }
        expect "disabled-option-list-visible" { visible = css("#select-disabled-option [data-popover][aria-hidden=false]") }
        expect "disabled-option-is-semantic" { visible = css("#select-disabled-option:has(input[type=hidden][value='']) [role=option][data-value=grapes][aria-disabled=true]") }
        focus "restore-disabled-option-trigger" { target = css("#select-disabled-option-trigger") }
        press "move-home" { key = "Home" }
        expect "first-enabled-option-active" { visible = css("#select-disabled-option-trigger[aria-activedescendant=select-disabled-option-option-1]") }
        press "skip-disabled-option" { key = "ArrowDown" }
        expect "last-enabled-option-active" { visible = css("#select-disabled-option-trigger[aria-activedescendant=select-disabled-option-option-3]") }
        press "commit-enabled-option" { key = "Enter" }
        expect "enabled-option-selected" { visible = css("#select-disabled-option:has([role=option][data-value=pineapple][aria-selected=true]) #select-disabled-option-trigger[aria-expanded=false]:focus") }
        screenshot "select-keyboard-and-disabled-option" { path = "components/select-keyboard-and-disabled-option.png" }
