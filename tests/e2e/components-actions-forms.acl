        expect "primary-slider-is-named-and-unit-aware" { visible = css("[data-slider-primary-demo=en] #slider-primary[aria-valuetext='50 degrees Celsius']") }
        focus "focus-primary-slider" { target = css("#slider-primary") }
        press "move-to-start" { key = "Home" }
        expect "start-value-is-visible" { text = "0 °C" }
        expect "start-valuetext" { visible = css("#slider-primary:focus[aria-valuetext='0 degrees Celsius']") }
        press "move-one-step" { key = "ArrowRight" }
        expect "intermediate-value-is-visible" { text = "1 °C" }
        press "move-to-end" { key = "End" }
        expect "end-value-is-visible" { text = "100 °C" }
        expect "end-valuetext" { visible = css("#slider-primary:focus[aria-valuetext='100 degrees Celsius']") }
        screenshot "slider-end-focused-desktop" { path = "components/slider-end-focused-desktop.png" }

        click "use-dark-preview" { target = css(".a3s-preview:has(#slider-primary) [data-preview-control=appearance]") }
        expect "dark-preview-active" { visible = css(".a3s-preview:has(#slider-primary)[data-preview-scheme=dark] .a3s-preview__canvas[data-preview-scheme=dark]") }
        focus "refocus-dark-slider" { target = css("#slider-primary") }
        screenshot "slider-end-focused-dark" { path = "components/slider-end-focused-dark.png" }

        expect "disabled-value-remains-readable" { visible = css("#slider-disabled:disabled[aria-valuetext='50 degrees Celsius']") }
        expect "disabled-state-explains-why" { text = "This limit is managed by the workspace policy." }

        focus "focus-rtl-slider" { target = css("#slider-rtl") }
