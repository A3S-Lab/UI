    scenario "radio-group" {
        name = "Radio Group preserves one named native choice contract across keyboard, disabled, invalid, and theme states"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/radio-group.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "group-has-one-visible-name" { visible = css(".radio-group[role=radiogroup][aria-labelledby=density-label-en]:has(#r1):has(#r2):has(#r3)") }
        focus "focus-current-choice" { target = css("#r2") }
        press "choose-next-choice" { key = "ArrowRight" }
        expect "compact-selected" { visible = css("#r3:checked") }
        press "wrap-to-first-choice" { key = "ArrowRight" }
        expect "default-selected-after-wrap" { visible = css("#r1:checked") }
        press "move-backward" { key = "ArrowLeft" }
        expect "compact-selected-after-backward-move" { visible = css("#r3:checked:focus") }
        screenshot "radio-selected-focused" { path = "components/radio-selected-focused.png" }

        focus "focus-enabled-choice-after-disabled" { target = css("#disabled-2") }
        press "skip-disabled-choice" { key = "ArrowLeft" }
        expect "disabled-choice-skipped" { visible = css("#disabled-1:disabled:not(:checked) + section, #disabled-1:disabled:not(:checked) + label") }
        expect "wrapped-enabled-choice-selected" { visible = css("#disabled-3:checked:focus") }

        expect "required-group-starts-neutral" { visible = css("form[data-radio-group-validation-demo=en]:has(fieldset:not([data-invalid])):has(#invalid-email:required:invalid:not(:checked):not([aria-invalid])):has(#invalid-sms:not(:checked):not([aria-invalid])):has(#invalid-both:not(:checked):not([aria-invalid])):has(#notification-preference-error-en[role=alert][hidden])") }
        focus "focus-continue-without-selection" { target = css("#notification-preference-submit-en") }
        press "continue-without-selection" { key = "Enter" }
        expect "invalid-group-explains-recovery" { visible = css("fieldset[data-invalid]:has(#invalid-email:required:invalid:not(:checked)[aria-invalid=true][aria-describedby=notification-preference-error-en]):has(#invalid-sms:not(:checked)[aria-invalid=true]):has(#invalid-both:not(:checked)[aria-invalid=true]):has(#notification-preference-error-en[role=alert]:not([hidden]))") }
        expect "invalid-group-focuses-first-option" { visible = css("#invalid-email:focus") }
        focus "focus-reset-directly-from-invalid" { target = css("#notification-preference-reset-en") }
        press "reset-directly-from-invalid" { key = "Enter" }
        expect "direct-reset-clears-error-semantics" { visible = css("form[data-radio-group-validation-demo=en]:has(fieldset:not([data-invalid])):has(#invalid-email:not(:checked):not([aria-invalid])):has(#invalid-sms:not(:checked):not([aria-invalid])):has(#invalid-both:not(:checked):not([aria-invalid])):has(#notification-preference-error-en[role=alert][hidden])") }
        focus "focus-continue-after-direct-reset" { target = css("#notification-preference-submit-en") }
        press "continue-after-direct-reset" { key = "Enter" }
        expect "invalid-group-restores-recovery" { visible = css("fieldset[data-invalid]:has(#invalid-email:required:invalid:not(:checked)[aria-invalid=true][aria-describedby=notification-preference-error-en]):has(#invalid-sms:not(:checked)[aria-invalid=true]):has(#invalid-both:not(:checked)[aria-invalid=true]):has(#notification-preference-error-en[role=alert]:not([hidden]))") }
        expect "invalid-group-refocuses-first-option" { visible = css("#invalid-email:focus") }
        check "recover-with-email" { target = css("#invalid-email") }
        expect "valid-choice-clears-stale-error" { visible = css("form[data-radio-group-validation-demo=en]:has(fieldset:not([data-invalid])):has(#invalid-email:checked:not([aria-invalid])):has(#notification-preference-error-en[hidden])") }
        focus "focus-reset-required-group" { target = css("#notification-preference-reset-en") }
        press "reset-required-group" { key = "Enter" }
        expect "reset-restores-neutral-empty-group" { visible = css("form[data-radio-group-validation-demo=en]:has(fieldset:not([data-invalid])):has(#invalid-email:not(:checked):not([aria-invalid])):has(#invalid-sms:not(:checked):not([aria-invalid])):has(#invalid-both:not(:checked):not([aria-invalid])):has(#notification-preference-error-en[hidden])") }

        focus "focus-pro-card-choice" { target = css("#pro-plan") }
        press "choose-pro-card" { key = "Space" }
        expect "choice-card-selects-one-native-value" { visible = css(".field[data-variant=choice-card]:has(#pro-plan:checked):has(#pro-plan-description)") }
        expect "previous-choice-card-clears" { visible = css("#plus-plan:not(:checked)") }
        focus "focus-choice-card" { target = css("#pro-plan") }
        expect "choice-card-owns-focus" { visible = css(".field[data-variant=choice-card]:has(#pro-plan:focus)") }
        screenshot "radio-choice-card-focused" { path = "components/radio-choice-card-focused.png" }

        focus "focus-dark-preview-control" { target = css(".a3s-preview[aria-label='Radio Group component preview'] [data-preview-control=appearance]") }
        press "use-dark-preview" { key = "Enter" }
        expect "dark-preview-active" { visible = css(".a3s-preview[aria-label='Radio Group component preview'][data-preview-scheme=dark]") }
        focus "restore-focused-radio" { target = css("#r3") }
        screenshot "radio-selected-focused-dark" { path = "components/radio-selected-focused-dark.png" }
        accessibility "radio-group-accessibility" { path = "components/radio-group-accessibility.json" interactive = true }
        console "radio-group-console" { path = "components/radio-group-console.json" clear = false }
        page_errors "radio-group-page-errors" { path = "components/radio-group-page-errors.json" clear = false }
    }

    scenario "radio-group-zh" {
        name = "Chinese Radio Group fieldset keeps subscription choices interactive"
        surface = "web"
        timeout_ms = 45000
        viewport "phone" { width = 390 height = 844 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/components/radio-group.html#字段组" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "monthly-selected" { visible = css("#plan-monthly:checked") }
        check "choose-yearly" { target = label("按年（$99.99/年）") }
        expect "yearly-selected" { visible = css("#plan-yearly:checked") }
        expect "monthly-cleared" { visible = css("#plan-monthly:not(:checked)") }
        focus "focus-yearly" { target = css("#plan-yearly") }
        screenshot "field-radio-zh-phone" { path = "components/field-radio-zh-phone.png" }
    }

    scenario "radio-group-zh-compact" {
        name = "Chinese Radio Group keeps localized validation and reset recovery usable at phone width"
        surface = "web"
        timeout_ms = 60000
        viewport "phone" { width = 390 height = 844 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/components/radio-group.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "localized-public-preview" { visible = css(".a3s-preview[aria-label='单选组组件预览'] .radio-group[role=radiogroup][aria-labelledby=density-label-zh]") }
        focus "focus-continue" { target = css("#notification-preference-submit-zh") }
        press "submit-empty-group" { key = "Enter" }
        expect "localized-invalid-recovery" { visible = css("form[data-radio-group-validation-demo=zh]:has(fieldset[data-invalid]):has(#invalid-email:focus[aria-invalid=true]):has(#invalid-sms[aria-invalid=true]):has(#invalid-both[aria-invalid=true]):has(#notification-preference-error-zh[role=alert]:not([hidden]))") }
        focus "focus-reset" { target = css("#notification-preference-reset-zh") }
        press "reset-invalid-group" { key = "Enter" }
        expect "localized-reset-neutral" { visible = css("form[data-radio-group-validation-demo=zh]:has(fieldset:not([data-invalid])):has(#invalid-email:not(:checked):not([aria-invalid])):has(#invalid-sms:not(:checked):not([aria-invalid])):has(#invalid-both:not(:checked):not([aria-invalid])):has(#notification-preference-error-zh[role=alert][hidden])") }
        screenshot "radio-group-zh-phone" { path = "components/radio-group-zh-phone.png" }
        console "radio-group-zh-console" { path = "components/radio-group-zh-console.json" clear = false }
        page_errors "radio-group-zh-page-errors" { path = "components/radio-group-zh-page-errors.json" clear = false }
    }

    scenario "switch" {
        name = "Switch preserves geometry, state, focus, themes, sizes, direction, and touch behavior"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/switch.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }

        focus "focus-default-switch" { target = css("#airplane-mode") }
        press "enable-default-with-keyboard" { key = "Space" }
        expect "default-switch-checked" { visible = css("#airplane-mode:checked") }
        screenshot "switch-keyboard-focus-desktop" { path = "components/switch-keyboard-focus-desktop.png" }

        click "use-dark-preview" { target = css(".a3s-preview[data-preview-component=switch] button[aria-label='Preview in dark mode']") }
        expect "dark-preview-active" { visible = css(".a3s-preview[data-preview-component=switch][data-preview-scheme=dark]") }
        focus "refocus-dark-switch" { target = css("#airplane-mode") }
        press "disable-dark-switch" { key = "Space" }
        press "restore-dark-switch" { key = "Space" }
        expect "dark-switch-checked" { visible = css("#airplane-mode:checked") }
        screenshot "switch-dark-checked-desktop" { path = "components/switch-dark-checked-desktop.png" }

        navigate "disabled-state" { url = "http://127.0.0.1:4178/UI/en/components/switch.html#disabled" }
        wait "disabled-state-ready" { visible = css("#switch-disabled-unchecked:disabled") }
        screenshot "switch-disabled-desktop" { path = "components/switch-disabled-desktop.png" }

        navigate "invalid-state" { url = "http://127.0.0.1:4178/UI/en/components/switch.html#invalid" }
        wait "invalid-state-ready" { visible = css("#switch-invalid[aria-invalid=true]") }
        focus "focus-invalid-switch" { target = css("#switch-invalid") }
        press "exercise-invalid-switch" { key = "Space" }
        press "restore-invalid-switch" { key = "Space" }
        expect "invalid-switch-restored" { visible = css("#switch-invalid[aria-invalid=true]:not(:checked)") }
        screenshot "switch-invalid-focus-desktop" { path = "components/switch-invalid-focus-desktop.png" }

        navigate "size-state" { url = "http://127.0.0.1:4178/UI/en/components/switch.html#size" }
        wait "size-state-ready" { visible = css("#switch-size-sm[data-size=sm]") }
        focus "focus-small-switch" { target = css("#switch-size-sm") }
        press "enable-small-switch" { key = "Space" }
        expect "small-switch-checked" { visible = css("#switch-size-sm:checked") }
        screenshot "switch-small-focus-desktop" { path = "components/switch-small-focus-desktop.png" }

        navigate "rtl-state" { url = "http://127.0.0.1:4178/UI/en/components/switch.html#rtl" }
        wait "rtl-state-ready" { visible = css("#switch-rtl:checked:dir(rtl)") }
        focus "focus-rtl-switch" { target = css("#switch-rtl") }
        press "disable-rtl-switch" { key = "Space" }
        expect "rtl-switch-unchecked" { visible = css("#switch-rtl:not(:checked):dir(rtl)") }
        screenshot "switch-rtl-unchecked-focus-desktop" { path = "components/switch-rtl-unchecked-focus-desktop.png" }
        press "restore-rtl-switch" { key = "Space" }
        expect "rtl-switch-restored" { visible = css("#switch-rtl:checked:dir(rtl)") }
        screenshot "switch-rtl-checked-focus-desktop" { path = "components/switch-rtl-checked-focus-desktop.png" }

        viewport "phone" { width = 390 height = 844 }
        navigate "phone-state" { url = "http://127.0.0.1:4178/UI/en/components/switch.html" }
        wait "phone-state-ready" { visible = css("#airplane-mode:not(:checked)") }
        check "enable-airplane-mode" { target = label("Airplane Mode") }
        expect "switch-checked" { visible = css("#airplane-mode:checked") }
        screenshot "switch-checked-phone" { path = "components/switch-checked-phone.png" }
        click "disable-airplane-mode" { target = label("Airplane Mode") }
        expect "switch-unchecked" { visible = css("#airplane-mode:not(:checked)") }
        screenshot "switch-unchecked-phone" { path = "components/switch-unchecked-phone.png" }
        accessibility "switch-accessibility" { path = "components/switch-accessibility.json" interactive = true }
        console "switch-console" { path = "components/switch-console.json" clear = false }
        page_errors "switch-page-errors" { path = "components/switch-page-errors.json" clear = false }
    }

    scenario "slider" {
        name = "Slider preserves value, units, keyboard direction, disabled guidance, focus, themes, and responsive layouts"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/slider.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "primary-slider-is-named-and-unit-aware" { visible = css("#slider-primary[aria-valuetext='50 degrees Celsius']") }
        focus "focus-primary-slider" { target = css("#slider-primary") }
        press "move-to-start" { key = "Home" }
        expect "start-value-is-visible" { text = "0 °C" }
        expect "start-value-remains-focused" { visible = css("#slider-primary:focus") }
        press "move-one-step" { key = "ArrowRight" }
        expect "intermediate-value-is-visible" { text = "1 °C" }
        press "move-to-end" { key = "End" }
        expect "end-value-is-visible" { text = "100 °C" }
        expect "end-value-remains-focused" { visible = css("#slider-primary:focus") }
        screenshot "slider-end-focused-desktop" { path = "components/slider-end-focused-desktop.png" }

        click "use-dark-preview" { target = css(".a3s-preview:has(#slider-primary) [data-preview-control=appearance]") }
        expect "dark-preview-active" { visible = css(".a3s-preview:has(#slider-primary)[data-preview-scheme=dark] .a3s-preview__canvas[data-preview-scheme=dark]") }
        focus "refocus-dark-slider" { target = css("#slider-primary") }
        screenshot "slider-end-focused-dark" { path = "components/slider-end-focused-dark.png" }

        expect "disabled-value-remains-readable" { visible = css("#slider-disabled:disabled[aria-valuetext='50 degrees Celsius']") }
        expect "disabled-state-explains-why" { text = "This limit is managed by the workspace policy." }

        focus "focus-rtl-slider" { target = css("#slider-rtl") }
        press "rtl-arrow-right-decreases" { key = "ArrowRight" }
        expect "rtl-decreased-value" { visible = css("#slider-rtl:focus[aria-valuetext='49 بالمائة']") }
        press "rtl-arrow-left-increases" { key = "ArrowLeft" }
        expect "rtl-restored-value" { visible = css("#slider-rtl:focus[aria-valuetext='50 بالمائة']") }
        screenshot "slider-rtl-focused-desktop" { path = "components/slider-rtl-focused-desktop.png" }

        viewport "phone" { width = 390 height = 844 }
        navigate "reset-for-phone" { url = "http://127.0.0.1:4178/UI/en/components/slider.html" }
        wait "phone-ready" { visible = css("#slider-primary[aria-valuetext='50 degrees Celsius']") }
        focus "focus-slider-on-phone" { target = css("#slider-primary") }
        screenshot "slider-focused-phone" { path = "components/slider-focused-phone.png" }

        viewport "zoom-equivalent" { width = 640 height = 900 }
        expect "slider-survives-zoom-equivalent-layout" { visible = css("#slider-primary[aria-valuetext='50 degrees Celsius']") }
        screenshot "slider-zoom-equivalent" { path = "components/slider-zoom-equivalent.png" }
        accessibility "slider-accessibility" { path = "components/slider-accessibility.json" interactive = true }
        console "slider-console" { path = "components/slider-console.json" clear = false }
        page_errors "slider-page-errors" { path = "components/slider-page-errors.json" clear = false }
    }

    scenario "label" {
        name = "Label preview activates its wrapped checkbox"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/label.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        check "accept-terms" { target = label("Accept terms and conditions") }
        expect "wrapped-control-checked" { visible = css(".a3s-preview[data-preview-component=label] input:checked") }
    }

    scenario "combobox" {
        name = "Combobox preview opens and filters framework options"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/combobox.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        click "open-frameworks" { target = css("#framework-combobox > input[role=combobox]") }
        wait "options-open" { visible = css("#framework-combobox [data-popover][aria-hidden=false]") }
        fill "filter-frameworks" { target = css("#framework-combobox > input[role=combobox]") value = "Astro" }
        wait "options-visible" { visible = css("#framework-combobox [data-popover][aria-hidden=false]") }
        expect "astro-visible" { visible = css("#framework-combobox [role=option][data-value='Astro']:not([aria-hidden=true])") }
        screenshot "filtered-combobox" { path = "components/combobox.png" }
    }

    scenario "filter-bar" {
        name = "Filter Bar restores required selection after removal and clears the complete query"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/filter-bar.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "filter-ready" { visible = css("#filter-bar-demo-en[data-filter-bar-initialized=true]") }
        click "remove-active-state" { target = css("#filter-bar-demo-en [data-filter-chip] [data-filter-remove]") }
        expect "required-fallback-selected" { visible = css("#filter-bar-demo-en [data-filter-value=all][aria-pressed=true]") }
        click "choose-paused" { target = css("#filter-bar-demo-en [data-filter-value=paused]") }
        expect "paused-selected" { visible = css("#filter-bar-demo-en [data-filter-value=paused][aria-pressed=true]") }
        fill "search-projects" { target = css("#filter-bar-demo-en input[type=search]") value = "release" }
        expect "compound-query-active" { visible = css("#filter-bar-demo-en[data-filters=active] input[type=search]:not(:placeholder-shown)") }
        click "clear-filters" { target = css("#filter-bar-demo-en [data-filter-clear]") }
        expect "required-default-restored" { visible = css("#filter-bar-demo-en [data-filter-value=all][aria-pressed=true]") }
        expect "search-cleared" { visible = css("#filter-bar-demo-en input[type=search]:placeholder-shown") }
    }
}
