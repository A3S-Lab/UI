        expect "state-specimen-indeterminate" { visible = css(".a3s-component-state-matrix[open][data-component=checkbox] [data-state-specimen=indeterminate] input[type=checkbox]") }
        expect "state-specimen-checked" { visible = css(".a3s-component-state-matrix[open][data-component=checkbox] [data-state-specimen=checked] input[type=checkbox]") }
