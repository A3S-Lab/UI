        press "choose-chinese-paused" { key = "Enter" }
        wait "chinese-paused-ready" { visible = css("#filter-bar-demo-zh [data-filter-toggle][data-filter-value=paused][aria-pressed=true]") }
        fill "chinese-search" { target = css("#filter-bar-demo-zh input[type=search]") value = "发布" }
        wait "chinese-compound-ready" { visible = css("#filter-bar-demo-zh[data-filters=active] input[type=search]:not(:placeholder-shown)") }
        focus "focus-chinese-clear" { target = css("#filter-bar-demo-zh [data-filter-clear]") }
        press "clear-chinese-filters" { key = "Enter" }
        wait "chinese-default-ready" { visible = css("#filter-bar-demo-zh [data-filter-toggle][data-filter-value=all][aria-pressed=true]") }
        expect "chinese-search-cleared" { visible = css("#filter-bar-demo-zh input[type=search]:placeholder-shown") }
        screenshot "filter-bar-chinese-phone" { path = "components/filter-bar-chinese-phone.png" }
        accessibility "filter-bar-accessibility" { path = "components/filter-bar-accessibility.json" interactive = true }
        console "filter-bar-console" { path = "components/filter-bar-console.json" clear = false }
        page_errors "filter-bar-errors" { path = "components/filter-bar-errors.json" clear = false }
    }
}

