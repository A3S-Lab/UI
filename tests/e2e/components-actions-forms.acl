        press "chinese-move-to-end" { key = "End" }
        expect "chinese-end-value" { text = "100 °C" }
        expect "chinese-end-valuetext" { visible = css("[data-slider-primary-demo=zh] #slider-primary:focus[aria-valuetext='100 摄氏度']") }
        screenshot "slider-chinese-phone" { path = "components/slider-chinese-phone.png" }
