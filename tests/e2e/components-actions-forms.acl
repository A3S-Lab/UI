        press "rtl-arrow-left-increases" { key = "ArrowLeft" }
        expect "rtl-restored-value" { visible = css("#slider-rtl:focus[aria-valuetext='50 بالمائة']") }
        screenshot "slider-rtl-focused-desktop" { path = "components/slider-rtl-focused-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=slider][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=slider]") }
        expect "state-specimen-disabled" { visible = css(".a3s-component-state-matrix[open][data-component=slider] [data-state-specimen=disabled]") }
        screenshot "slider-states" { path = "components/slider-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=slider][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/slider.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-slider-primary-demo=zh] #slider-primary[aria-valuetext='50 摄氏度']") }
