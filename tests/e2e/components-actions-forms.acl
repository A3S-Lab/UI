        fill "enter-multiline-note" { target = label("Release note") value = "Verification passed.\nRollback to version 0.2.9." }
        expect "multiline-count-updated" { text = "47 / 320 characters" }

        expect "validation-starts-neutral" { visible = css("form[data-textarea-validation-demo=en] .field:not([data-invalid]):has(#textarea-validation-en[required][minlength='40'][maxlength='320'][aria-describedby=textarea-validation-help-en]:not([aria-invalid])):has(#textarea-validation-error-en[role=alert][hidden]):has(#textarea-validation-count-en[aria-label='Character count'][aria-live=off])") }
        click "submit-empty-handoff" { target = role("button", "Save handoff") }
        expect "validation-preserves-value-and-focuses-recovery" { visible = css("form[data-textarea-validation-demo=en] .field[data-invalid=true]:has(#textarea-validation-en:focus[aria-invalid=true][aria-describedby='textarea-validation-help-en textarea-validation-error-en']:invalid):has(#textarea-validation-error-en[role=alert]:not([hidden]))") }
        fill "recover-valid-handoff" { target = css("#textarea-validation-en") value = "Verification passed. Restore version 0.2.9 if health checks fail." }
        expect "valid-handoff-clears-stale-error" { visible = css("form[data-textarea-validation-demo=en] .field:not([data-invalid]):has(#textarea-validation-en:valid[aria-describedby=textarea-validation-help-en]:not([aria-invalid])):has(#textarea-validation-error-en[hidden])") }
        fill "enter-short-handoff" { target = css("#textarea-validation-en") value = "Verification passed." }
        click "resubmit-short-handoff" { target = role("button", "Save handoff") }
        expect "short-handoff-restores-error" { visible = css("#textarea-validation-en:focus[aria-invalid=true]:invalid") }
        click "reset-validation" { target = role("button", "Reset") }
        expect "reset-clears-error-and-count" { visible = css("form[data-textarea-validation-demo=en] .field:not([data-invalid]):has(#textarea-validation-en[aria-describedby=textarea-validation-help-en]:not([aria-invalid])):has(#textarea-validation-error-en[hidden]):has(#textarea-validation-count-en[aria-label='Character count'][aria-live=off])") }
        expect "reset-count-visible" { text = "0 / 320 characters" }

        expect "disabled-retains-native-state-and-reason" { visible = css("form[data-textarea-availability=en] .field[data-disabled=true]:has(#textarea-disabled-en.textarea[disabled][name=archivedReleaseNote][aria-describedby=textarea-disabled-reason-en]):has(#textarea-disabled-reason-en[data-field-description])") }
        expect "readonly-retains-submission-and-reason" { visible = css("form[data-textarea-availability=en] .field[data-readonly=true]:has(#textarea-readonly-en.textarea[readonly][name=approvedReleaseNote][aria-describedby=textarea-readonly-reason-en]):has(#textarea-readonly-reason-en[data-field-description])") }
        screenshot "textarea-desktop-ltr" { path = "components/textarea-desktop-ltr.png" }

        focus "focus-dark-preview-control" { target = css(".a3s-preview[data-preview-component=textarea][data-preview-integration=complete] [data-preview-control=appearance]") }
        press "use-dark-preview" { key = "Enter" }
        wait "dark-preview-active" { visible = css(".a3s-preview[data-preview-component=textarea][data-preview-integration=complete][data-preview-scheme=dark] .a3s-preview__canvas[data-a3s-theme=dark]") }
        focus "focus-rtl-preview-control" { target = css(".a3s-preview[data-preview-component=textarea][data-preview-integration=complete] [data-preview-control=direction]") }
        press "use-rtl-preview" { key = "Enter" }
        wait "dark-rtl-preview-active" { visible = css(".a3s-preview[data-preview-component=textarea][data-preview-integration=complete][data-preview-scheme=dark][data-preview-direction=rtl]") }
        click "open-state-acceptance" { target = css(".a3s-preview[data-preview-component=textarea][data-preview-integration=complete] [data-preview-control=states]") }
        wait "state-context-ready" { visible = css(".a3s-component-state-matrix[open][data-component=textarea] [data-state-specimen=invalid] [data-state-specimen-mount=invalid][dir=rtl][data-a3s-theme=dark]") }
        expect "empty-state-is-neutral" { visible = css(".a3s-component-state-matrix[open][data-component=textarea] [data-state-specimen=empty] .a3s-component-state-matrix__field-specimen:not([data-invalid]):has(textarea.textarea:not([aria-invalid]):not([disabled]):not([readonly])):has([data-state-specimen-feedback]:not([role=alert]))") }
        expect "ready-state-is-editable" { visible = css(".a3s-component-state-matrix[open][data-component=textarea] [data-state-specimen=ready] .a3s-component-state-matrix__field-specimen:has(textarea.textarea:not([aria-invalid]):not([disabled]):not([readonly]))") }
        expect "disabled-state-is-native" { visible = css(".a3s-component-state-matrix[open][data-component=textarea] [data-state-specimen=disabled] .a3s-component-state-matrix__field-specimen[data-disabled]:has(textarea.textarea[disabled]):has([data-state-specimen-feedback])") }
        expect "invalid-state-has-local-recovery" { visible = css(".a3s-component-state-matrix[open][data-component=textarea] [data-state-specimen=invalid] .a3s-component-state-matrix__field-specimen[data-invalid]:has(textarea.textarea[required][aria-invalid=true]:invalid):has([data-state-specimen-feedback][role=alert][data-error])") }
        expect "readonly-state-is-native" { visible = css(".a3s-component-state-matrix[open][data-component=textarea] [data-state-specimen=readonly] .a3s-component-state-matrix__field-specimen[data-readonly]:has(textarea.textarea[readonly]):has([data-state-specimen-feedback])") }
        screenshot "textarea-states-dark-rtl" { path = "components/textarea-states-dark-rtl.png" }
        press "close-state-acceptance" { key = "Escape" }
        expect "state-trigger-focus-restored" { visible = css(".a3s-preview[data-preview-component=textarea][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "reset-for-phone" { url = "http://127.0.0.1:4178/UI/en/components/textarea.html" }
        wait "phone-ready" { visible = css("#textarea-release-note-en") }
        focus "focus-primary-textarea-phone" { target = css("#textarea-release-note-en") }
