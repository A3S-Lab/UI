        press "reset-form" { key = "Enter" }
        expect "reset-restores-authored-draft" { visible = css("form[data-form-primary-demo=en][data-state=ready]:not([aria-invalid]):has(#form-summary-en[hidden]):has(#form-workspace-name-en[value=Research]:not([aria-invalid])):has(#form-workspace-owner-en[value='owner@example.com']:not([aria-invalid]))") }

        expect "readonly-demo-blocks-editing" { visible = css("form.form[data-form-readonly-demo=en][data-readonly][data-state='read-only']:has(#form-readonly-name-en[readonly][value='Runtime Core']):has(#form-readonly-owner-en[readonly][value='release-owner@example.com']):has(button[type=submit][disabled])") }

