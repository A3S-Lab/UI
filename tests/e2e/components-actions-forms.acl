        expect "state-specimen-invalid" { visible = css(".a3s-component-state-matrix[open][data-component=form] [data-state-specimen=invalid] form.form[data-state-specimen-root=invalid][data-state=invalid][aria-invalid=true]") }
        screenshot "form-states" { path = "components/form-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=form][data-preview-integration=complete] [data-preview-control=states]:focus") }

