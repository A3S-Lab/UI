suite "a3s-ui-product-task-creation" {
    version = 1

    scenario "created-session-empty-recovery" {
        name = "A direct current-session route explains how to recover when no task exists"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }

        navigate "open-empty-session" { url = "http://127.0.0.1:4178/UI/playground/sessions/current.html" }
        wait "loaded" { load = "networkidle" }
        wait "missing-state" { visible = css("[data-product-surface=session][data-session-state=missing]") }
        expect "missing-heading" { text = "没有可恢复的任务" }
        expect "recovery-action" { visible = css("[data-session-state=missing] a[href$='/playground.html']") }

        screenshot "empty-state" { path = "product/task-session-empty.png" }
        console "console" { path = "product/task-session-empty-console.json" clear = false }
        page_errors "page-errors" { path = "product/task-session-empty-page-errors.json" clear = false }
    }

    scenario "create-task-desktop" {
        name = "A desktop task becomes a persistent conversation with context and follow-ups"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        wait "composer-ready" { visible = css(".product-start [role=textbox][aria-label='任务指令']") }

        click "open-workspaces" { target = css(".product-start [data-composer-control=workspace] > button") }
        click "choose-workspace" { target = css(".product-start [data-workspace-options] [role=option]:first-child") }
        click "open-execution-mode" { target = css(".product-start [data-composer-control=mode] > button") }
        click "allow-edits" { target = css(".product-start [data-mode-options] [role=option]:nth-child(3)") }
        click "open-run-settings" { target = css(".product-start [data-composer-control=run] > button") }
        click "open-model-picker" { target = css(".product-start [data-run-settings-row] > div > button:last-child") }
        click "choose-default-model" { target = css(".product-start #product-model-option-1") }
        fill "task" { target = css(".product-start [role=textbox][aria-label='任务指令']") value = "整理导航交互并补充移动端回归" }
        click "create" { target = role("button", "发送任务") }

        wait "created-url" { url = "http://127.0.0.1:4178/UI/playground/sessions/current.html" }
        wait "session-ready" { visible = css("[data-product-surface=session][data-session-state=ready][data-variant=created]") }
        expect "dynamic-title" { visible = css(".product-session__header h1") }
        expect "original-task" { text = "整理导航交互并补充移动端回归" }
        expect "recent-task" { visible = css(".product-sidebar__history a[data-created-task][aria-current=page]") }
        expect "context-ready" { visible = css(".product-session-context[open]") }
        expect "workspace-preserved" { text = "A3S UI 体验优化" }
        expect "model-preserved" { text = "当前默认模型" }
        expect "permissions-preserved" { text = "允许修改" }

        fill "follow-up" { target = css(".product-session__composer [role=textbox][aria-label='任务指令']") value = "先确认触控目标和返回后的焦点位置" }
        press "queue-follow-up" { key = "Enter" }
        expect "follow-up-queued" { visible = css(".product-follow-up-queue") }
        expect "queued-copy-visible" { text = "先确认触控目标和返回后的焦点位置" }

        click "leave-session" { target = css(".product-sidebar__primary > a:first-of-type") }
        wait "start-url" { url = "http://127.0.0.1:4178/UI/playground.html" }
        click "return-from-recent" { target = css(".product-sidebar__history a[data-created-task]") }
        wait "returned-url" { url = "http://127.0.0.1:4178/UI/playground/sessions/current.html" }
        expect "returned-follow-up" { text = "先确认触控目标和返回后的焦点位置" }

        navigate "reload-directly" { url = "http://127.0.0.1:4178/UI/playground/sessions/current.html" }
        wait "restored-session" { visible = css("[data-product-surface=session][data-session-state=ready]") }
        expect "restored-task" { text = "整理导航交互并补充移动端回归" }
        expect "restored-follow-up" { text = "先确认触控目标和返回后的焦点位置" }

        screenshot "desktop-session" { path = "product/task-session-desktop.png" }
        console "console" { path = "product/task-session-desktop-console.json" clear = false }
        page_errors "page-errors" { path = "product/task-session-desktop-page-errors.json" clear = false }
    }

    scenario "create-task-mobile" {
        name = "Task creation closes the mobile drawer and keeps the recent task reachable"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        fill "task" { target = css(".product-start [role=textbox][aria-label='任务指令']") value = "检查移动端任务导航" }
        click "create" { target = role("button", "发送任务") }
        wait "created-url" { url = "http://127.0.0.1:4178/UI/playground/sessions/current.html" }
        expect "drawer-closed" { visible = css("button[aria-label='打开应用导航']") }
        expect "mobile-composer" { visible = css(".product-session__composer .ProseMirror") }

        click "open-navigation" { target = role("button", "打开应用导航") }
        expect "recent-task-current" { visible = css(".product-sidebar[data-mobile-open=true] a[data-created-task][aria-current=page]") }
        click "close-through-task" { target = css(".product-sidebar[data-mobile-open=true] a[data-created-task]") }
        expect "drawer-closed-again" { visible = css("button[aria-label='打开应用导航']") }

        screenshot "mobile-session" { path = "product/task-session-mobile.png" }
        console "console" { path = "product/task-session-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/task-session-mobile-page-errors.json" clear = false }
    }

    scenario "create-task-english" {
        name = "English task creation preserves the localized current-session route"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/en/playground.html" }
        wait "loaded" { load = "networkidle" }
        fill "task" { target = css(".product-start [role=textbox][aria-label='Task instruction']") value = "Review navigation continuity across breakpoints" }
        click "create" { target = role("button", "Send task") }
        wait "created-url" { url = "http://127.0.0.1:4178/UI/en/playground/sessions/current.html" }
        wait "session-ready" { visible = css("[data-product-surface=session][data-session-state=ready][data-variant=created]") }
        expect "english-title" { text = "Review navigation continuity across breakpoints" }
        expect "english-recent-task" { visible = css(".product-sidebar__history a[data-created-task][aria-current=page]") }

        fill "follow-up" { target = css(".product-session__composer [role=textbox][aria-label='Task instruction']") value = "Keep keyboard focus visible after returning" }
        press "queue-follow-up" { key = "Enter" }
        expect "english-queue" { visible = css(".product-follow-up-queue") }
        expect "english-follow-up" { text = "Keep keyboard focus visible after returning" }

        screenshot "english-session" { path = "product/task-session-english.png" }
        console "console" { path = "product/task-session-english-console.json" clear = false }
        page_errors "page-errors" { path = "product/task-session-english-page-errors.json" clear = false }
    }

    scenario "created-session-dark" {
        name = "A created conversation keeps readable hierarchy in dark mode"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        fill "task" { target = css(".product-start [role=textbox][aria-label='任务指令']") value = "检查深色会话的层级与可读性" }
        click "create" { target = role("button", "发送任务") }
        wait "session-ready" { visible = css("[data-product-surface=session][data-session-state=ready][data-variant=created]") }

        click "open-settings" { target = role("button", "设置") }
        click "open-personalization" { target = role("button", "个性化") }
        click "choose-dark" { target = role("button", "深色") }
        expect "dark-session-visible" { visible = css("html.dark [data-product-surface=session][data-variant=created]") }
        click "close-settings" { target = role("button", "关闭设置") }

        screenshot "dark-session" { path = "product/task-session-dark.png" }
        console "console" { path = "product/task-session-dark-console.json" clear = false }
        page_errors "page-errors" { path = "product/task-session-dark-page-errors.json" clear = false }
    }
}
