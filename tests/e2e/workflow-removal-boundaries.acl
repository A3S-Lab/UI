suite "a3s-ui-workflow-removal-boundaries" {
    version = 1

    scenario "workflow-chapter-removed" {
        name = "The removed Workflow chapter resolves to a recoverable not-found surface"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open-retired-route" { url = "http://127.0.0.1:4178/UI/workflow/" }
        wait "loaded" { load = "networkidle" }
        wait "not-found-ready" { visible = css(".a3s-not-found:has(h1)") }
        expect "workflow-preview-absent" { visible = css(".a3s-not-found:not(:has(.a3s-preview)):not(:has([data-a3s-components]))") }
        expect "workflow-navigation-absent" { visible = css("body:not(:has(a[href*='/workflow']))") }
        screenshot "not-found-evidence" { path = "workflow-removal/workflow-chapter.png" }
        accessibility "not-found-accessibility" { path = "workflow-removal/workflow-chapter-accessibility.json" interactive = true }
        click "recover-to-components" { target = role("link", "浏览组件") }
        wait "component-catalog-url" { url = "http://127.0.0.1:4178/UI/components/index.html" }
        wait "component-catalog-ready" { visible = css("[data-component-catalog]") }
        console "console" { path = "workflow-removal/workflow-chapter-console.json" clear = false }
        page_errors "errors" { path = "workflow-removal/workflow-chapter-errors.json" clear = false }
    }

    scenario "workflow-chapter-removed-en" {
        name = "The removed English Workflow chapter resolves to the localized recovery surface"
