        screenshot "not-found-evidence" { path = "workflow-removal/workflow-chapter-en.png" }
        accessibility "not-found-accessibility" { path = "workflow-removal/workflow-chapter-en-accessibility.json" interactive = true }
        click "recover-to-components" { target = role("link", "Browse components") }
        wait "component-catalog-url" { url = "http://127.0.0.1:4178/UI/en/components/index.html" }
        wait "component-catalog-ready" { visible = css("[data-component-catalog]") }
