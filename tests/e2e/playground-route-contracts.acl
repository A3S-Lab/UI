suite "a3s-ui-playground-route-contracts" {
    version = 1

    scenario "playground-route-start" {
        name = "New Task route preserves its desktop and compact application contract"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        wait "route-ready" { visible = css("[data-product-application][data-view=start]") }
        expect "surface-ready" { visible = css("[data-product-application][data-view=start] [data-product-surface=start]") }
        focus "focus-search" { target = css("[data-product-application][data-view=start] .product-sidebar__window button[aria-label='搜索']") }
        expect "search-focused" { visible = css("[data-product-application][data-view=start] .product-sidebar__window button[aria-label='搜索']:focus") }
        screenshot "capture-desktop" { path = "playground/routes/playground-start-desktop.png" }

        viewport "compact" { width = 390 height = 844 }
        expect "closed-navigation-inert" { visible = css("[data-product-application][data-view=start]:has(.product-sidebar[inert])") }
        focus "focus-mobile-navigation" { target = css("[data-product-application][data-view=start] .product-application__mobile-menu") }
        press "open-mobile-navigation" { key = "Enter" }
        expect "mobile-navigation-open" { visible = css("[data-product-application][data-view=start] .product-sidebar[data-mobile-open=true]:not([inert])") }
        screenshot "compact-open" { path = "playground/routes/playground-start-compact.png" }
        focus "focus-mobile-close" { target = css("[data-product-application][data-view=start] .product-sidebar__window button[aria-label='关闭应用导航']") }
        press "close-mobile-navigation" { key = "Enter" }
        wait "mobile-navigation-closed" { visible = css("[data-product-application][data-view=start]:has(.product-sidebar[inert])") }
        accessibility "tree" { path = "playground/routes/playground-start-accessibility.json" interactive = true }
        console "console" { path = "playground/routes/playground-start-console.json" clear = false }
        page_errors "errors" { path = "playground/routes/playground-start-errors.json" clear = false }
    }

