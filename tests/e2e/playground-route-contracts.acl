        expect "search-focused" { visible = css("[data-product-application][data-view=assistant] .product-sidebar__window button[aria-label='搜索']:focus") }
        screenshot "capture-desktop" { path = "playground/routes/playground-assistant-desktop.png" }

        viewport "compact" { width = 390 height = 844 }
        expect "closed-navigation-inert" { visible = css("[data-product-application][data-view=assistant]:has(.product-sidebar[inert])") }
        focus "focus-mobile-navigation" { target = css("[data-product-application][data-view=assistant] .product-application__mobile-menu") }
