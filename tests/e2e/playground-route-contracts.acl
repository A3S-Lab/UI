        expect "mobile-navigation-open" { visible = css("[data-product-application][data-view=assistant] .product-sidebar[data-mobile-open=true]:not([inert])") }
        screenshot "compact-open" { path = "playground/routes/playground-assistant-compact.png" }
        focus "focus-mobile-close" { target = css("[data-product-application][data-view=assistant] .product-sidebar__window button[aria-label='关闭应用导航']") }
        press "close-mobile-navigation" { key = "Enter" }
