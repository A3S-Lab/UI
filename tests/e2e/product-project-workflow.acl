suite "a3s-ui-product-project-workflow" {
    version = 1

    scenario "project-workspace-and-session" {
        name = "Project navigation keeps workspace and child-task context"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open-projects" { url = "http://127.0.0.1:4178/UI/playground/projects.html" }
        wait "projects-loaded" { load = "networkidle" }
        wait "projects-ready" { visible = css("[data-product-surface=projects]") }
        expect "project-card-is-link" { visible = css(".product-projects__owned > a[href$='a3s-ui-experience.html']") }

        click "open-project" { target = css(".product-projects__owned > a") }
        wait "workspace-mounted" { visible = css("[data-product-surface=project]") }
        expect "workspace-visible" { visible = css("[data-product-surface=project]") }
        expect "projects-nav-current" { visible = css(".product-sidebar__primary a[href$='/playground/projects.html'][aria-current=page]") }
        expect "project-group-expanded" { visible = css(".product-sidebar__project-group[data-expanded=true]") }
        expect "project-composer" { visible = css(".product-project-workspace__composer .product-composer:not([data-docked]) .ProseMirror") }
        expect "project-composer-context" { visible = css(".product-project-workspace__composer:has([data-composer-control=target]):has([data-composer-control=workspace]):has([data-composer-control=mode])") }
        expect "activity-tab-selected" { visible = css(".product-project-workspace__tabs [role=tab][aria-selected=true]:nth-child(1)") }
        expect "configuration-visible" { visible = css("aside[aria-label='项目配置']") }
        expect "activity-actions-visible" { visible = css("button[data-activity-compose]") }
        click "open-project-update" { target = role("button", "发布留言") }
        fill "write-project-update" { target = label("项目留言") value = "设备预览与文件工作台已进入验收" }
        click "publish-project-update" { target = css(".product-project-workspace__activity-composer button[type=submit]") }
        expect "project-update-visible" { visible = css(".product-project-workspace__activity li[data-posted]") }
        click "open-plan" { target = role("tab", "计划") }
        expect "plan-visible" { visible = css(".product-project-plan") }
        expect "backlog-group" { visible = css(".product-project-plan button[aria-label='折叠待开始']") }
        expect "active-group" { visible = css(".product-project-plan button[aria-label='折叠进行中']") }
        expect "paused-group" { visible = css(".product-project-plan button[aria-label='折叠已暂停']") }
        expect "complete-group" { visible = css(".product-project-plan button[aria-label='折叠已完成']") }
        expect "product-flow-copy" { text = "统一产品体验与任务流" }
        press "move-to-tasks" { key = "ArrowRight" }
        expect "tasks-visible" { visible = css(".product-project-workspace__tabs [role=tab][aria-selected=true]:nth-child(3)") }

        click "open-child-task" { target = css(".product-sidebar__project-task") }
        wait "session-mounted" { visible = css("[data-product-surface=project-session]") }
        expect "session-visible" { visible = css("[data-product-surface=project-session]") }
        expect "child-task-current" { visible = css(".product-sidebar__project-task[aria-current=page]") }
        expect "project-path" { visible = css("nav[aria-label='项目路径']") }
        expect "collaboration-state" { text = "协同中" }
        expect "empty-send-disabled" { visible = css(".product-session__composer button[aria-label='发送任务']:disabled") }
        expect "readiness-report" { visible = css(".product-project-session__report:has(h2#product-project-readiness-title)") }
        expect "readiness-evidence-complete" { visible = css(".product-project-session__report tbody:has(tr:nth-child(5))") }
        expect "primary-deliverable" { visible = css("button[data-project-deliverable]:has(strong)") }
        expect "all-artifacts-entry" { text = "查看所有产物 (3)" }
        expect "copy-action-icon" { visible = css(".product-project-session .product-session__message-actions button[aria-label='复制回复'] svg[data-icon=copy]") }
        expect "helpful-action-icon" { visible = css(".product-project-session .product-session__message-actions button[aria-label='回复有帮助'] svg[data-icon=thumb-up]") }
        expect "unhelpful-action-icon" { visible = css(".product-project-session .product-session__message-actions button[aria-label='回复没有帮助'] svg[data-icon=thumb-down]") }
        expect "speech-action-icon" { visible = css(".product-project-session .product-session__message-actions button[aria-label='朗读回复'] svg[data-icon=volume]") }
        expect "more-action-icon" { visible = css(".product-project-session .product-session__message-menu > summary[aria-label='更多回复操作'] svg[data-icon=more]") }

        focus "focus-open-search" { target = css("button[aria-label='在项目会话中搜索']") }
        press "open-search" { key = "Enter" }
        wait "search-ready" { visible = css(".product-session__search input[aria-label='搜索项目会话']") }
        fill "search-project" { target = css(".product-session__search input[aria-label='搜索项目会话']") value = "项目" }
        expect "search-results" { text = "7 个结果" }
        screenshot "search-evidence" { path = "product/project-session-search.png" }
        click "close-search" { target = role("button", "关闭项目会话搜索") }

        click "open-primary-deliverable" { target = css("button[data-project-deliverable]") }
        expect "artifacts-view-selected" { visible = css("aside[aria-label='项目详情'] [role=tab][aria-selected=true]:has(svg[data-icon=document])") }
        expect "all-artifacts-visible" { visible = css("aside[aria-label='项目详情'] .product-inspector-file-list:has(button:nth-child(3))") }
        screenshot "artifact-evidence" { path = "product/project-session-artifacts.png" }
        click "close-artifact-details" { target = role("button", "关闭项目详情") }
        expect "deliverable-focus-restored" { visible = css("button[data-project-deliverable]:focus") }

        click "mark-response-helpful" { target = role("button", "回复有帮助") }
        expect "helpful-selected" { visible = css(".product-project-session .product-session__message-actions button[aria-label='回复有帮助'][aria-pressed=true]") }
        expect "helpful-status" { text = "已标记为有帮助" }
        screenshot "response-actions-evidence" { path = "product/project-session-response-actions.png" }

        expect "details-hidden-by-default" { visible = css("[data-product-surface=project-session]:not(:has(aside[aria-label='项目详情']))") }
        click "reopen-details" { target = role("button", "打开项目详情") }
        expect "details-visible-again" { visible = css("aside[aria-label='项目详情']") }
        press "close-details" { key = "Escape" }
        expect "details-trigger-restored" { visible = css("button[aria-label='打开项目详情']:focus") }

        fill "continue-task" { target = css(".product-session__composer [role=textbox][aria-label='任务指令']") value = "继续执行暗色模式验收" }
        click "send-follow-up" { target = role("button", "发送任务") }
        expect "follow-up-visible" { text = "继续执行暗色模式验收" }

        screenshot "desktop-evidence" { path = "product/project-workflow-desktop.png" }
        console "console" { path = "product/project-workflow-desktop-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workflow-desktop-page-errors.json" clear = false }
    }

    scenario "project-session-mobile" {
        name = "Project child task retains context and composer on mobile"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open-session" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience/sessions/release-readiness.html" }
        wait "session-loaded" { load = "networkidle" }
        wait "session-ready" { visible = css("[data-product-surface=project-session]") }
        expect "mobile-menu" { visible = css("button[aria-label='打开应用导航']") }
        expect "mobile-composer" { visible = css(".product-session__composer .ProseMirror") }
        expect "mobile-readiness-report" { visible = css(".product-project-session__report tbody:has(tr:nth-child(5))") }
        expect "mobile-deliverable" { visible = css("button[data-project-deliverable]") }
        expect "mobile-response-actions" { visible = css(".product-project-session .product-session__message-actions:has(svg[data-icon=copy]):has(svg[data-icon=thumb-up]):has(svg[data-icon=thumb-down]):has(svg[data-icon=volume])") }

        screenshot "mobile-conversation-evidence" { path = "product/project-session-mobile.png" }

        click "open-navigation" { target = role("button", "打开应用导航") }
        expect "mobile-project-current" { visible = css(".product-sidebar__project-task[aria-current=page]") }
        focus "focus-close-navigation" { target = css(".product-sidebar[data-mobile-open=true] .product-sidebar__window > div > button:first-child") }
        press "close-navigation" { key = "Enter" }
        wait "navigation-closed" { visible = css("button[aria-label='打开应用导航']") }

        focus "focus-mobile-details" { target = css("button[aria-label='打开项目详情']") }
        press "open-mobile-details" { key = "Enter" }
        wait "mobile-details" { visible = css("aside[aria-label='项目详情']") }

        screenshot "mobile-evidence" { path = "product/project-workflow-mobile.png" }
        press "close-mobile-details" { key = "Escape" }
        expect "mobile-details-trigger-restored" { visible = css("button[aria-label='打开项目详情']:focus") }
        expect "mobile-conversation-restored" { visible = css("[data-product-surface=project-session]:has(.product-project-session__report):has(.product-session__composer .ProseMirror):not(:has(aside[aria-label='项目详情']))") }
        screenshot "mobile-restored-evidence" { path = "product/project-session-mobile-restored.png" }
        console "console" { path = "product/project-workflow-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workflow-mobile-page-errors.json" clear = false }
    }

    scenario "project-workspace-mobile" {
        name = "Project workspace and asset workbenches remain usable on mobile"
        surface = "web"
        timeout_ms = 90000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open-project" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience.html" }
        wait "project-loaded" { load = "networkidle" }
        wait "project-ready" { visible = css("[data-product-surface=project]") }
        expect "mobile-menu" { visible = css("button[aria-label='打开应用导航']") }
        expect "project-composer" { visible = css(".product-project-workspace__composer .product-composer:not([data-docked]) .ProseMirror") }
        expect "project-composer-context" { visible = css(".product-project-workspace__composer:has([data-composer-control=target]):has([data-composer-control=workspace]):has([data-composer-control=mode])") }
        expect "activity-tab-selected" { visible = css(".product-project-workspace__tabs [role=tab][aria-selected=true]:nth-child(1)") }
        click "open-tasks" { target = role("tab", "任务") }
        expect "project-task" { visible = css(".product-project-workspace__task-list a[href$='release-readiness.html']") }
        expect "mobile-privacy-note" { visible = css("[data-task-privacy][aria-label='未分享的任务仅你可见，分享后项目成员可以协作']") }
        click "open-configuration" { target = role("button", "打开项目配置") }
        expect "mobile-configuration" { visible = css("aside[aria-label='项目配置']") }
        press "close-configuration" { key = "Escape" }
        expect "configuration-trigger-restored" { visible = css("button[aria-label='打开项目配置']:focus") }

        screenshot "mobile-workspace-evidence" { path = "product/project-workspace-mobile.png" }

        click "open-mobile-assets" { target = role("tab", "资产") }
        expect "mobile-asset-toolbar" { visible = css("[data-asset-toolbar]") }
        expect "mobile-assets" { visible = css("[data-asset-row]") }
        expect "mobile-name-column" { visible = css("[data-asset-table-scroll] th:nth-child(2)") }
        expect "mobile-upload" { visible = css("[data-asset-upload]") }
        expect "mobile-filter" { visible = css("[data-asset-type-filter] select") }
        click "select-mobile-asset" { target = css("[data-asset-id=design-md] [data-asset-select]") }
        expect "mobile-asset-selected" { visible = css("[data-asset-id=design-md][data-selected=true] [data-asset-select]:checked") }
        expect "mobile-asset-action" { visible = css(".product-project-workspace__context-actions [data-asset-action-bar]") }
        expect "mobile-selection-retains-composer" { visible = css(".product-project-workspace__workbench:has([data-asset-action-bar]):has(> .product-project-workspace__composer .product-composer:not([data-docked]))") }
        expect "mobile-selection-retains-context" { visible = css(".product-project-workspace__workbench:has([data-asset-action-bar]):has([data-composer-control=target]):has([data-composer-control=workspace]):has([data-composer-control=mode])") }
        expect "mobile-selection-actions-overlay-context" {
            target = css("[data-asset-action-bar]")
            relative_to = css(".product-project-workspace__composer [data-composer-context-bar]")
            layout = "overlaps"
            tolerance_px = 0
        }
        expect "mobile-linked-task-pointer-reachable" { pointer_reachable = role("button", "创建关联任务") }
        screenshot "mobile-assets-evidence" { path = "product/project-assets-mobile.png" }
        click "clear-mobile-asset" { target = role("button", "清除资产选择") }
        expect "mobile-asset-cleared" { visible = css("[data-asset-id=design-md]:not([data-selected=true]) [data-asset-select]:not(:checked)") }
        expect "mobile-composer-remains-full" { visible = css(".product-project-workspace__composer .product-composer:not([data-docked])") }

        click "open-mobile-code-workbench" { target = css("[data-asset-id=design-md] [data-asset-open]") }
        expect "mobile-asset-preview-dialog" { visible = css("dialog[data-project-asset-dialog][open][aria-modal=true]") }
        expect "mobile-code-workbench" { visible = css("dialog[data-project-asset-dialog][open] [data-workbench-kind=code][data-presentation=dialog]") }
        expect "mobile-preview-fills-viewport" {
            target = css("dialog[data-project-asset-dialog][open]")
            relative_to = css("html")
            layout = "same_size"
            tolerance_px = 0
        }
        expect "mobile-project-context-retained" { visible = css("[data-product-surface=project]:has(.product-project-workspace__tabs):has([data-asset-row]):has(.product-project-workspace__composer)") }
        expect "mobile-close-action-semantic" { visible = css("dialog[data-project-asset-dialog][open] [data-file-workbench-close][aria-label='关闭文件预览'] svg[data-icon=close]") }
        screenshot "mobile-code-evidence" { path = "product/project-asset-code-mobile.png" }
        press "close-mobile-code-preview" { key = "Escape" }
        expect "mobile-file-focus-restored" { visible = css("[data-asset-id=design-md] [data-asset-open]:focus") }
        expect "mobile-composer-unfocused" { visible = css(".product-project-workspace__composer .agent-composer-editor__content:not(:focus)") }

        click "open-mobile-folder" { target = css("[data-asset-id=visual-acceptance] [data-asset-open]") }
        expect "mobile-pdf-asset" { visible = css("[data-asset-id=visual-report][data-asset-row]") }
        click "open-mobile-pdf" { target = css("[data-asset-id=visual-report] [data-asset-open]") }
        expect "mobile-pdf-workbench" { visible = css("[data-project-asset-workbench] [data-workbench-kind=pdf]") }
        wait "mobile-pdf-canvas" { visible = css("[aria-label='PDF 页面画布']") }
        wait "mobile-pdf-content-ready" { visible = css("input[aria-label='页码'][value='1']") }
        wait "mobile-pdf-renderer-ready" { visible = css(".work-pdf-embed[data-ready=true]") }
        click "open-mobile-pdf-navigation" { target = role("button", "打开 PDF 页面导航") }
        wait "mobile-pdf-first-page-rendered" { visible = css(".work-pdf-thumbnail-preview > img") }
        click "select-mobile-pdf-second-page" { target = role("button", "第 2 页") }
        wait "mobile-pdf-second-page-selected" { visible = css("input[aria-label='页码'][value='2']") }
        click "reopen-mobile-pdf-navigation" { target = role("button", "打开 PDF 页面导航") }
        wait "mobile-pdf-second-thumbnail-rendered" { visible = css("[data-pdf-page-index='1'] .work-pdf-thumbnail-preview > img") }
        click "restore-mobile-pdf-first-page" { target = role("button", "第 1 页") }
        wait "mobile-pdf-first-page-restored" { visible = css("input[aria-label='页码'][value='1']") }
        expect "mobile-pdf-navigation-closed" { visible = css(".work-pdf-workspace[data-mobile-page-navigation=closed]") }
        screenshot "mobile-pdf-evidence" { path = "product/project-asset-pdf-mobile.png" }
        click "close-mobile-pdf" { target = role("button", "关闭文件预览") }
        expect "mobile-pdf-focus-restored" { visible = css("[data-asset-id=visual-report] [data-asset-open]:focus") }
        click "return-from-mobile-folder" { target = css("[data-asset-back]") }

        click "open-mobile-office" { target = css("[data-asset-id=experience-brief] [data-asset-open]") }
        expect "mobile-office-workbench" { visible = css("[data-project-asset-workbench] [data-workbench-kind=document]") }
        expect "mobile-office-preview-tools" { visible = css("[data-office-load-state=ready] [aria-label='文字预览工具']") }
        expect "mobile-office-preview-document" { visible = css("[aria-label='文字预览'] [aria-label='文档内容编辑区域']") }
        screenshot "mobile-office-evidence" { path = "product/project-asset-office-mobile.png" }
        accessibility "mobile-office-accessibility" { path = "product/project-asset-office-mobile-accessibility.json" interactive = true }
        click "close-mobile-office" { target = role("button", "关闭文件预览") }
        expect "mobile-office-focus-restored" { visible = css("[data-asset-id=experience-brief] [data-asset-open]:focus") }
        console "console" { path = "product/project-workspace-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workspace-mobile-page-errors.json" clear = false }
    }

    scenario "project-session-dark" {
        name = "Project child task preserves hierarchy in dark mode"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }

        navigate "open-session" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience/sessions/release-readiness.html" }
        wait "session-loaded" { load = "networkidle" }
        wait "session-ready" { visible = css("[data-product-surface=project-session]") }

        click "open-settings" { target = role("button", "设置") }
        expect "settings-visible" { visible = css("dialog[aria-label='设置']") }
        click "open-personalization" { target = role("button", "个性化") }
        click "choose-dark" { target = role("button", "深色") }
        expect "dark-applied" { visible = css("html.dark [data-product-surface=project-session]") }
        click "close-settings" { target = role("button", "关闭设置") }

        screenshot "dark-evidence" { path = "product/project-workflow-dark.png" }
        console "console" { path = "product/project-workflow-dark-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workflow-dark-page-errors.json" clear = false }
    }
}
