suite "a3s-ui-product-project-workflow" {
    version = 1

    scenario "project-workspace-and-session" {
        name = "Project navigation keeps workspace and child-task context"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open-projects" { url = "http://127.0.0.1:4178/UI/playground/projects.html" }
        wait "projects-loaded" { load = "networkidle" }
        wait "projects-ready" { visible = css("[data-product-surface=projects]") }
        expect "project-card-is-link" { visible = css(".product-projects__owned > a[href$='a3s-ui-experience.html']") }

        navigate "open-project" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience.html" }
        expect "workspace-visible" { visible = css("[data-product-surface=project]") }
        expect "projects-nav-current" { visible = css(".product-sidebar__primary a[href$='/playground/projects.html'][aria-current=page]") }
        expect "project-group-expanded" { visible = css(".product-sidebar__project-group[data-expanded=true]") }
        expect "project-composer" { visible = css(".product-project-workspace__composer .ProseMirror") }
        expect "activity-tab-selected" { visible = css(".product-project-workspace__tabs [role=tab][aria-selected=true]:nth-child(1)") }
        expect "configuration-visible" { visible = css("aside[aria-label='项目配置']") }
        expect "activity-actions-visible" { visible = css("button[data-activity-compose]") }
        click "open-project-update" { target = role("button", "发布留言") }
        fill "write-project-update" { target = label("项目留言") value = "设备预览与文件工作台已进入验收" }
        click "publish-project-update" { target = css(".product-project-workspace__activity-composer button[type=submit]") }
        expect "project-update-visible" { visible = css(".product-project-workspace__activity li[data-posted]") }
        click "open-plan" { target = role("tab", "计划") }
        expect "plan-visible" { visible = css(".product-project-plan") }
        expect "backlog-group" { visible = css(".product-project-plan button[aria-label='折叠待开始']") }
        expect "active-group" { visible = css(".product-project-plan button[aria-label='折叠进行中']") }
        expect "paused-group" { visible = css(".product-project-plan button[aria-label='折叠已暂停']") }
        expect "complete-group" { visible = css(".product-project-plan button[aria-label='折叠已完成']") }
        expect "product-flow-copy" { text = "统一产品体验与任务流" }
        press "move-to-tasks" { key = "ArrowRight" }
        expect "tasks-visible" { visible = css(".product-project-workspace__tabs [role=tab][aria-selected=true]:nth-child(3)") }

        click "open-child-task" { target = css(".product-sidebar__project-task") }
        expect "session-visible" { visible = css("[data-product-surface=project-session]") }
        expect "child-task-current" { visible = css(".product-sidebar__project-task[aria-current=page]") }
        expect "project-path" { visible = css("nav[aria-label='项目路径']") }
        expect "collaboration-state" { text = "协同中" }
        expect "empty-send-disabled" { visible = css(".product-session__composer button[aria-label='发送任务']:disabled") }

        focus "focus-open-search" { target = css("button[aria-label='在项目会话中搜索']") }
        press "open-search" { key = "Enter" }
        wait "search-ready" { visible = css(".product-session__search input[aria-label='搜索项目会话']") }
        fill "search-project" { target = css(".product-session__search input[aria-label='搜索项目会话']") value = "项目" }
        expect "search-results" { text = "7 个结果" }
        click "close-search" { target = role("button", "关闭项目会话搜索") }

        expect "details-hidden-by-default" { visible = css("[data-product-surface=project-session]:not(:has(aside[aria-label='项目详情']))") }
        click "reopen-details" { target = role("button", "打开项目详情") }
        expect "details-visible-again" { visible = css("aside[aria-label='项目详情']") }
        press "close-details" { key = "Escape" }
        expect "details-trigger-restored" { visible = css("button[aria-label='打开项目详情']:focus") }

        fill "continue-task" { target = css(".product-session__composer [role=textbox][aria-label='任务指令']") value = "继续执行暗色模式验收" }
        click "send-follow-up" { target = role("button", "发送任务") }
        expect "follow-up-visible" { text = "继续执行暗色模式验收" }

        screenshot "desktop-evidence" { path = "product/project-workflow-desktop.png" }
        console "console" { path = "product/project-workflow-desktop-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workflow-desktop-page-errors.json" clear = false }
    }

    scenario "project-session-mobile" {
        name = "Project child task retains context and composer on mobile"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open-session" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience/sessions/release-readiness.html" }
        wait "session-loaded" { load = "networkidle" }
        wait "session-ready" { visible = css("[data-product-surface=project-session]") }
        expect "mobile-menu" { visible = css("button[aria-label='打开应用导航']") }
        expect "mobile-composer" { visible = css(".product-session__composer .ProseMirror") }

        screenshot "mobile-conversation-evidence" { path = "product/project-session-mobile.png" }

        click "open-navigation" { target = role("button", "打开应用导航") }
        expect "mobile-project-current" { visible = css(".product-sidebar__project-task[aria-current=page]") }
        focus "focus-close-navigation" { target = css(".product-sidebar[data-mobile-open=true] .product-sidebar__window > div > button:first-child") }
        press "close-navigation" { key = "Enter" }
        wait "navigation-closed" { visible = css("button[aria-label='打开应用导航']") }

        focus "focus-mobile-details" { target = css("button[aria-label='打开项目详情']") }
        press "open-mobile-details" { key = "Enter" }
        wait "mobile-details" { visible = css("aside[aria-label='项目详情']") }

        screenshot "mobile-evidence" { path = "product/project-workflow-mobile.png" }
        console "console" { path = "product/project-workflow-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workflow-mobile-page-errors.json" clear = false }
    }

    scenario "project-workspace-mobile" {
        name = "Project workspace remains usable on mobile"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open-project" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience.html" }
        wait "project-loaded" { load = "networkidle" }
        wait "project-ready" { visible = css("[data-product-surface=project]") }
        expect "mobile-menu" { visible = css("button[aria-label='打开应用导航']") }
        expect "project-composer" { visible = css(".product-project-workspace__composer .ProseMirror") }
        expect "activity-tab-selected" { visible = css(".product-project-workspace__tabs [role=tab][aria-selected=true]:nth-child(1)") }
        click "open-tasks" { target = role("tab", "任务") }
        expect "project-task" { visible = css(".product-project-workspace__task-list a[href$='release-readiness.html']") }
        click "open-configuration" { target = role("button", "打开项目配置") }
        expect "mobile-configuration" { visible = css("aside[aria-label='项目配置']") }
        press "close-configuration" { key = "Escape" }
        expect "configuration-trigger-restored" { visible = css("button[aria-label='打开项目配置']:focus") }

        screenshot "mobile-workspace-evidence" { path = "product/project-workspace-mobile.png" }
        console "console" { path = "product/project-workspace-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workspace-mobile-page-errors.json" clear = false }
    }

    scenario "project-session-dark" {
        name = "Project child task preserves hierarchy in dark mode"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1280 height = 900 }

        navigate "open-session" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience/sessions/release-readiness.html" }
        wait "session-loaded" { load = "networkidle" }
        wait "session-ready" { visible = css("[data-product-surface=project-session]") }

        click "open-settings" { target = role("button", "设置") }
        expect "settings-visible" { visible = css("dialog[aria-label='设置']") }
        click "open-personalization" { target = role("button", "个性化") }
        click "choose-dark" { target = role("button", "深色") }
        expect "dark-applied" { visible = css("html.dark [data-product-surface=project-session]") }
        click "close-settings" { target = role("button", "关闭设置") }

        screenshot "dark-evidence" { path = "product/project-workflow-dark.png" }
        console "console" { path = "product/project-workflow-dark-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-workflow-dark-page-errors.json" clear = false }
    }
}
