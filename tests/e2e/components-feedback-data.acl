    scenario "log-viewer" {
        name = "Log Viewer filters stderr, covers ready through empty matrix, and confirms Chinese title"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/log-viewer.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=log-viewer][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-log-viewer-primary-demo=en].log-viewer[data-log-filter=all]") }
        expect "title-copy" { text = "Build output" }
        expect "selected-filter-visible" { visible = css("[data-log-viewer-primary-demo=en] [data-log-actions] [data-log-filter-value=all][aria-pressed=true]") }
        expect "stderr-visible" { visible = css("[data-log-viewer-primary-demo=en] [data-log-record][data-stream=stderr]") }
        expect "compaction-visible" { visible = css("[data-log-viewer-primary-demo=en] [data-log-gap]") }
        click "filter-stderr" { target = css("[data-log-viewer-primary-demo=en] [data-log-filter-value=stderr]") }
        expect "stderr-filter-active" { visible = css("[data-log-viewer-primary-demo=en][data-log-filter=stderr] [data-log-filter-value=stderr][aria-pressed=true]") }
        expect "stdout-hidden" { hidden = css("[data-log-viewer-primary-demo=en][data-log-filter=stderr] [data-log-record][data-stream=stdout]") }
        expect "stderr-still-visible" { visible = css("[data-log-viewer-primary-demo=en][data-log-filter=stderr] [data-log-record][data-stream=stderr]:not([hidden])") }
        screenshot "log-viewer-desktop" { path = "components/log-viewer-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=log-viewer][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=log-viewer]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=log-viewer] [data-state-specimen=ready]") }
        expect "state-specimen-streaming" { visible = css(".a3s-component-state-matrix[open][data-component=log-viewer] [data-state-specimen=streaming]") }
        expect "state-specimen-paused" { visible = css(".a3s-component-state-matrix[open][data-component=log-viewer] [data-state-specimen=paused]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=log-viewer] [data-state-specimen=error]") }
        expect "state-specimen-empty" { visible = css(".a3s-component-state-matrix[open][data-component=log-viewer] [data-state-specimen=empty]") }
        screenshot "log-viewer-states" { path = "components/log-viewer-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=log-viewer][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/log-viewer.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-log-viewer-primary-demo=zh] [data-log-viewer-title]") }
        expect "chinese-title" { text = "构建输出" }
        click "filter-chinese-stderr" { target = css("[data-log-viewer-primary-demo=zh] [data-log-filter-value=stderr]") }
        expect "chinese-stderr-filter-active" { visible = css("[data-log-viewer-primary-demo=zh][data-log-filter=stderr] [data-log-filter-value=stderr][aria-pressed=true]") }
        screenshot "log-viewer-chinese-phone" { path = "components/log-viewer-chinese-phone.png" }
        accessibility "log-viewer-accessibility" { path = "components/log-viewer-accessibility.json" interactive = true }
        console "log-viewer-console" { path = "components/log-viewer-console.json" clear = false }
