        screenshot "property-list-chinese-phone" { path = "components/property-list-chinese-phone.png" }
        accessibility "property-list-accessibility" { path = "components/property-list-accessibility.json" interactive = true }
        console "property-list-console" { path = "components/property-list-console.json" clear = false }
        page_errors "property-list-errors" { path = "components/property-list-errors.json" clear = false }
    }

    scenario "stepper" {
        name = "Stepper exposes completed, current, and pending stages, covers state matrix, and confirms Chinese stages"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/stepper.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=stepper][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-stepper-primary-demo=en]") }
        expect "completed-stage" { visible = css("[data-stepper-primary-demo=en] [data-stepper-step=desired][data-state=success]") }
        expect "current-stage" { visible = css("[data-stepper-primary-demo=en] [data-stepper-step=health][data-state=active][aria-current=step]") }
        expect "pending-stage" { visible = css("[data-stepper-primary-demo=en] [data-stepper-step=route]:not([data-state])") }
        expect "health-copy" { text = "Health proof" }
        focus "focus-scrollable-stepper" { target = css("[data-stepper-primary-demo=en][tabindex='0']") }
        expect "stepper-focused" { visible = css("[data-stepper-primary-demo=en]:focus") }
        screenshot "stepper-desktop" { path = "components/stepper-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=stepper][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=stepper]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=stepper] [data-state-specimen=ready]") }
        expect "state-specimen-active" { visible = css(".a3s-component-state-matrix[open][data-component=stepper] [data-state-specimen=active]") }
        expect "state-specimen-success" { visible = css(".a3s-component-state-matrix[open][data-component=stepper] [data-state-specimen=success]") }
        screenshot "stepper-states" { path = "components/stepper-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=stepper][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/stepper.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-stepper-primary-demo=zh] [data-stepper-step=health][aria-current=step]") }
        expect "chinese-health" { text = "健康证明" }
        expect "chinese-desired" { text = "期望状态" }
        focus "focus-chinese-stepper" { target = css("[data-stepper-primary-demo=zh][tabindex='0']") }
        screenshot "stepper-chinese-phone" { path = "components/stepper-chinese-phone.png" }
        accessibility "stepper-accessibility" { path = "components/stepper-accessibility.json" interactive = true }
        console "stepper-console" { path = "components/stepper-console.json" clear = false }
        page_errors "stepper-errors" { path = "components/stepper-errors.json" clear = false }
    }

