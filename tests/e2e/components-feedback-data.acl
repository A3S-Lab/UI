suite "a3s-ui-feedback-and-data" {
    version = 1

    scenario "alert" {
        name = "Alert exposes success and info variants, covers state matrix, and confirms Chinese copy"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/alert.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=alert][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-alert-primary-demo=en] [data-alert-item=success][data-variant=success]") }
        expect "info-variant" { visible = css("[data-alert-primary-demo=en] [data-alert-item=info][data-variant=info]") }
        expect "success-title" { text = "Payment successful" }
        screenshot "alert-desktop" { path = "components/alert-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=alert][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=alert]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=alert] [data-state-specimen=ready]") }
        expect "state-specimen-success" { visible = css(".a3s-component-state-matrix[open][data-component=alert] [data-state-specimen=success]") }
        screenshot "alert-states" { path = "components/alert-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=alert][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/alert.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-alert-primary-demo=zh] [data-alert-item=success]") }
        expect "chinese-title" { text = "付款成功" }
        screenshot "alert-chinese-phone" { path = "components/alert-chinese-phone.png" }
        accessibility "alert-accessibility" { path = "components/alert-accessibility.json" interactive = true }
        console "alert-console" { path = "components/alert-console.json" clear = false }
        page_errors "alert-errors" { path = "components/alert-errors.json" clear = false }
    }

    scenario "badge" {
        name = "Badge exposes semantic variants, covers state matrix, and confirms Chinese labels"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/badge.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=badge][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-badge-primary-demo=en] [data-badge-item=default]") }
        expect "secondary-badge" { visible = css("[data-badge-primary-demo=en] [data-badge-item=secondary][data-variant=secondary]") }
        expect "destructive-badge" { visible = css("[data-badge-primary-demo=en] [data-badge-item=destructive][data-variant=destructive]") }
        expect "outline-badge" { visible = css("[data-badge-primary-demo=en] [data-badge-item=outline][data-variant=outline]") }
        expect "destructive-copy" { text = "Destructive" }
        screenshot "badge-desktop" { path = "components/badge-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=badge][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=badge]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=badge] [data-state-specimen=ready]") }
        expect "state-specimen-destructive" { visible = css(".a3s-component-state-matrix[open][data-component=badge] [data-state-specimen=destructive]") }
        screenshot "badge-states" { path = "components/badge-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=badge][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/badge.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-badge-primary-demo=zh] [data-badge-item=destructive]") }
        expect "chinese-version" { text = "当前版本" }
        expect "chinese-blocking" { text = "2 个阻塞项" }
        screenshot "badge-chinese-phone" { path = "components/badge-chinese-phone.png" }
        accessibility "badge-accessibility" { path = "components/badge-accessibility.json" interactive = true }
        console "badge-console" { path = "components/badge-console.json" clear = false }
        page_errors "badge-errors" { path = "components/badge-errors.json" clear = false }
    }

    scenario "status-badge" {
        name = "Status Badge exposes all operational states, covers state matrix, and confirms Chinese labels"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/status-badge.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=status-badge][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-status-badge-primary-demo=en] [data-status-item=active][data-state=active][data-indicator]") }
        expect "success-status" { visible = css("[data-status-badge-primary-demo=en] [data-status-item=success][data-state=success]") }
        expect "warning-status" { visible = css("[data-status-badge-primary-demo=en] [data-status-item=warning][data-state=warning]") }
        expect "danger-status" { visible = css("[data-status-badge-primary-demo=en] [data-status-item=danger][data-state=danger]") }
        expect "running-copy" { text = "Running" }
        screenshot "status-badge-desktop" { path = "components/status-badge-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=status-badge][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=status-badge]") }
        wait "state-specimen-neutral" { visible = css(".a3s-component-state-matrix[open][data-component=status-badge] [data-state-specimen=neutral]") }
        expect "state-specimen-active" { visible = css(".a3s-component-state-matrix[open][data-component=status-badge] [data-state-specimen=active]") }
        screenshot "status-badge-states" { path = "components/status-badge-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=status-badge][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/status-badge.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-status-badge-primary-demo=zh] [data-status-item=active]") }
        expect "chinese-running" { text = "运行中" }
        expect "chinese-failed" { text = "失败" }
        screenshot "status-badge-chinese-phone" { path = "components/status-badge-chinese-phone.png" }
        accessibility "status-badge-accessibility" { path = "components/status-badge-accessibility.json" interactive = true }
        console "status-badge-console" { path = "components/status-badge-console.json" clear = false }
        page_errors "status-badge-errors" { path = "components/status-badge-errors.json" clear = false }
    }

    scenario "empty" {
        name = "Empty keeps recovery actions keyboard-reachable, covers state matrix, and confirms Chinese create path"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/empty.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=empty][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-empty-primary-demo=en] .empty, [data-empty-primary-demo=en]") }
        expect "empty-title" { text = "No Projects Yet" }
        focus "focus-empty-recovery" { target = css("[data-empty-primary-demo=en] [data-empty-action=create]") }
        expect "create-focused" { visible = css("[data-empty-primary-demo=en] [data-empty-action=create]:focus") }
        press "activate-create" { key = "Enter" }
        expect "create-activated" { visible = css("[data-empty-primary-demo=en][data-empty-status=create]") }
        screenshot "empty-desktop" { path = "components/empty-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=empty][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=empty]") }
        wait "state-specimen-empty" { visible = css(".a3s-component-state-matrix[open][data-component=empty] [data-state-specimen=empty]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=empty] [data-state-specimen=error]") }
        screenshot "empty-states" { path = "components/empty-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=empty][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/empty.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-empty-primary-demo=zh] [data-empty-action=create]") }
        expect "chinese-title" { text = "还没有项目" }
        click "create-chinese" { target = css("[data-empty-primary-demo=zh] [data-empty-action=create]") }
        expect "chinese-create-activated" { visible = css("[data-empty-primary-demo=zh][data-empty-status=create]") }
        screenshot "empty-chinese-phone" { path = "components/empty-chinese-phone.png" }
        accessibility "empty-accessibility" { path = "components/empty-accessibility.json" interactive = true }
        console "empty-console" { path = "components/empty-console.json" clear = false }
        page_errors "empty-errors" { path = "components/empty-errors.json" clear = false }
    }

    scenario "progress" {
        name = "Progress exposes synchronized value, complete/reset controls, state matrix, and Chinese status"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/progress.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=progress][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-progress-primary-demo=en] [data-progress-bar][aria-valuenow='66'] > span[style*='66%']") }
        expect "status-66" { text = "66% complete" }
        click "complete-progress" { target = css("[data-progress-primary-demo=en] [data-progress-action=set-100]") }
        expect "progress-complete" { visible = css("[data-progress-primary-demo=en] [data-progress-bar][aria-valuenow='100'] > span[style*='100%']") }
        expect "status-100" { text = "100% complete" }
        click "reset-progress" { target = css("[data-progress-primary-demo=en] [data-progress-action=set-0]") }
        expect "progress-reset" { visible = css("[data-progress-primary-demo=en] [data-progress-bar][aria-valuenow='0']") }
        expect "status-0" { text = "0% complete" }
        screenshot "progress-desktop" { path = "components/progress-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=progress][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=progress]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=progress] [data-state-specimen=ready]") }
        expect "state-specimen-complete" { visible = css(".a3s-component-state-matrix[open][data-component=progress] [data-state-specimen=complete]") }
        screenshot "progress-states" { path = "components/progress-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=progress][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/progress.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-progress-primary-demo=zh] [data-progress-bar][aria-valuenow='66']") }
        click "complete-chinese" { target = css("[data-progress-primary-demo=zh] [data-progress-action=set-100]") }
        expect "chinese-status" { text = "已完成 100%" }
        screenshot "progress-chinese-phone" { path = "components/progress-chinese-phone.png" }
        accessibility "progress-accessibility" { path = "components/progress-accessibility.json" interactive = true }
        console "progress-console" { path = "components/progress-console.json" clear = false }
        page_errors "progress-errors" { path = "components/progress-errors.json" clear = false }
    }

    scenario "skeleton" {
        name = "Skeleton preserves loading structure, covers state matrix, and confirms Chinese busy label"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/skeleton.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=skeleton][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-skeleton-primary-demo=en][aria-busy=true]") }
        expect "avatar-placeholder" { visible = css("[data-skeleton-primary-demo=en] [data-skeleton-part=avatar].skeleton") }
        expect "title-placeholder" { visible = css("[data-skeleton-primary-demo=en] [data-skeleton-part=title].skeleton") }
        screenshot "skeleton-desktop" { path = "components/skeleton-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=skeleton][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=skeleton]") }
        wait "state-specimen-loading" { visible = css(".a3s-component-state-matrix[open][data-component=skeleton] [data-state-specimen=loading]") }
        screenshot "skeleton-states" { path = "components/skeleton-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=skeleton][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/skeleton.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-skeleton-primary-demo=zh][aria-busy=true]") }
        expect "chinese-busy-label" { visible = css("[data-skeleton-primary-demo=zh][aria-label='正在加载资料']") }
        screenshot "skeleton-chinese-phone" { path = "components/skeleton-chinese-phone.png" }
        accessibility "skeleton-accessibility" { path = "components/skeleton-accessibility.json" interactive = true }
        console "skeleton-console" { path = "components/skeleton-console.json" clear = false }
        page_errors "skeleton-errors" { path = "components/skeleton-errors.json" clear = false }
    }

    scenario "spinner" {
        name = "Spinner exposes accessible loading status, covers state matrix, and confirms Chinese copy"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/spinner.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=spinner][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-spinner-primary-demo=en][aria-busy=true] [data-spinner-status][role=status][aria-label=Loading]") }
        expect "processing-copy" { text = "Processing payment..." }
        screenshot "spinner-desktop" { path = "components/spinner-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=spinner][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=spinner]") }
        wait "state-specimen-loading" { visible = css(".a3s-component-state-matrix[open][data-component=spinner] [data-state-specimen=loading]") }
        screenshot "spinner-states" { path = "components/spinner-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=spinner][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/spinner.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-spinner-primary-demo=zh] [data-spinner-status][role=status]") }
        expect "chinese-title" { text = "正在处理付款..." }
        expect "chinese-status-label" { visible = css("[data-spinner-primary-demo=zh] [data-spinner-status][aria-label='加载中']") }
        screenshot "spinner-chinese-phone" { path = "components/spinner-chinese-phone.png" }
        accessibility "spinner-accessibility" { path = "components/spinner-accessibility.json" interactive = true }
        console "spinner-console" { path = "components/spinner-console.json" clear = false }
        page_errors "spinner-errors" { path = "components/spinner-errors.json" clear = false }
    }

    scenario "toast" {
        name = "Toast creates from trigger, dismisses cleanly, covers state matrix, and confirms Chinese success copy"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/toast.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=toast][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-toast-primary-demo=en] [data-toast-trigger]") }
        expect "status-idle" { text = "No toast yet" }
        focus "focus-create-toast" { target = css("[data-toast-primary-demo=en] [data-toast-trigger]") }
        press "create-toast" { key = "Enter" }
        wait "toast-ready" { visible = css("[data-toast-primary-demo=en] [data-toast-toaster] .toast:has([data-toast-cancel]):not([aria-hidden=true])") }
        expect "toast-title" { text = "Success" }
        expect "status-visible" { text = "Success toast visible" }
        focus "focus-dismiss" { target = css("[data-toast-primary-demo=en] [data-toast-toaster] .toast [data-toast-cancel]") }
        screenshot "toast-desktop" { path = "components/toast-desktop.png" }
        press "dismiss-toast" { key = "Enter" }
        wait "toast-dismissed" { visible = css("[data-toast-primary-demo=en] [data-toast-toaster]:not(:has([data-toast-cancel]))") }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=toast][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=toast]") }
        wait "state-specimen-open" { visible = css(".a3s-component-state-matrix[open][data-component=toast] [data-state-specimen=open]") }
        expect "state-specimen-success" { visible = css(".a3s-component-state-matrix[open][data-component=toast] [data-state-specimen=success]") }
        screenshot "toast-states" { path = "components/toast-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=toast][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/toast.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-toast-primary-demo=zh] [data-toast-trigger]") }
        click "create-chinese-toast" { target = css("[data-toast-primary-demo=zh] [data-toast-trigger]") }
        wait "chinese-toast-ready" { visible = css("[data-toast-primary-demo=zh] [data-toast-toaster] .toast:has([data-toast-cancel])") }
        expect "chinese-title" { text = "操作成功" }
