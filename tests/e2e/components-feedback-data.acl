    scenario "tree" {
        name = "Tree preserves hierarchy, selection, disabled-node skipping, state matrix, and localized Chinese copy"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/tree.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=tree][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-tree-primary-demo=en]#tree-demo[data-tree-initialized=true]") }
        focus "focus-root-branch" { target = css("#tree-demo-src") }
        press "collapse-root-branch" { key = "ArrowLeft" }
        expect "root-collapsed" { visible = css("#tree-demo-src[aria-expanded=false]:focus") }
        press "expand-root-branch" { key = "ArrowRight" }
        press "enter-root-branch" { key = "ArrowRight" }
        expect "components-focused" { visible = css("#tree-demo-components:focus") }
        press "enter-components" { key = "ArrowRight" }
        expect "first-file-focused" { visible = css("#tree-demo [role=treeitem][aria-label='button.css']:focus") }
        press "move-to-selected-file" { key = "ArrowDown" }
        expect "tree-file-focused" { visible = css("#tree-demo-tree-css:focus") }
        press "skip-disabled-file" { key = "ArrowDown" }
        expect "tests-focused" { visible = css("#tree-demo-tests:focus") }
        press "select-tests" { key = "Space" }
        expect "tests-selected" { visible = css("#tree-demo-tests[aria-selected=true]") }
        click "expand-tests" { target = css("#tree-demo-tests > [data-tree-row]") }
        expect "tests-expanded" { visible = css("#tree-demo-tests[aria-expanded=true] > [role=group]:not([hidden])") }
        screenshot "tree-desktop" { path = "components/tree-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=tree][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=tree]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=tree] [data-state-specimen=ready]") }
        screenshot "tree-states" { path = "components/tree-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=tree][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese" { url = "http://127.0.0.1:4178/UI/components/tree.html" }
        wait "chinese-loaded" { load = "networkidle" }
        wait "chinese-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "localized-tree-title" { text = "树形控件" }
        expect "localized-project-tree" { visible = css("[data-tree-primary-demo=zh]#tree-demo[aria-label='项目文件'][data-tree-initialized=true]") }
        screenshot "tree-chinese-phone" { path = "components/tree-chinese-phone.png" }
        accessibility "tree-accessibility" { path = "components/tree-accessibility.json" interactive = true }
        console "tree-console" { path = "components/tree-console.json" clear = false }
        page_errors "tree-errors" { path = "components/tree-errors.json" clear = false }
    }

    scenario "data-grid" {
        name = "Data Grid synchronizes partial and full selection, bulk scope, and reversible sorting"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/data-grid.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "grid-ready" { visible = css("#data-grid-demo-en[data-data-grid-initialized=true][data-selection=some]") }
        check "select-all" { target = css("#data-grid-demo-en [data-grid-select-all]") }
        expect "all-selected" { visible = css("#data-grid-demo-en[data-selection=all] [data-selected-count]") }
        uncheck "exclude-staging" { target = css("#data-grid-demo-en [data-grid-select][value=staging]") }
        expect "partial-selection-restored" { visible = css("#data-grid-demo-en[data-selection=some] .bulk-action-bar:not([hidden])") }
        check "restore-staging" { target = css("#data-grid-demo-en [data-grid-select][value=staging]") }
        expect "full-selection-restored" { visible = css("#data-grid-demo-en[data-selection=all] [data-selected-count]") }
        focus "focus-sort-name" { target = css("#data-grid-demo-en [data-grid-sort=name]") }
        press "sort-name" { key = "Enter" }
        wait "name-ascending-ready" { visible = css("#data-grid-demo-en th[aria-sort=ascending] [data-grid-sort=name]") }
        expect "name-ascending" { visible = css("#data-grid-demo-en th[aria-sort=ascending] [data-grid-sort=name]") }
        focus "focus-reverse-name-sort" { target = css("#data-grid-demo-en th[aria-sort=ascending] [data-grid-sort=name]") }
        press "reverse-name-sort" { key = "Enter" }
        wait "name-descending-ready" { visible = css("#data-grid-demo-en th[aria-sort=descending] [data-grid-sort=name]") }
        expect "name-descending" { visible = css("#data-grid-demo-en th[aria-sort=descending] [data-grid-sort=name]") }
        focus "focus-clear-selection" { target = css("#data-grid-demo-en [data-grid-clear-selection]") }
        press "clear-selection" { key = "Enter" }
        expect "selection-cleared" { visible = css("#data-grid-demo-en[data-selection=none]") }
        expect "selection-focus-returned" { visible = css("#data-grid-demo-en [data-grid-select-all]:focus") }
        viewport "phone" { width = 390 height = 844 }
        expect "stacked-row-visible" { visible = css("#data-grid-demo-en[data-responsive=stack] tbody tr:first-child td[data-label=Name]") }
    }

    scenario "bulk-action-bar" {
        name = "Bulk Action Bar initializes a controlled selection and exits the temporary action region"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/bulk-action-bar.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "bulk-actions-visible" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar] .bulk-action-bar[data-bulk-action-bar-initialized=true][data-state=selected]:not([hidden])") }
        focus "focus-archive-action" { target = css(".a3s-preview[data-preview-component=bulk-action-bar] [data-bulk-action=archive]") }
        expect "archive-action-focused" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar] [data-bulk-action=archive]:focus") }
        press "start-archive" { key = "Enter" }
        expect "archive-loading" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar] .bulk-action-bar[data-state=loading][aria-busy=true] [data-bulk-action=archive][data-pending=true]") }
        expect "archive-disabled" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar] [data-bulk-action=archive]:disabled") }
        wait "archive-error" { text = "Archive failed. Check permissions and retry." }
        expect "archive-recovered" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar] .bulk-action-bar[data-state=selected][data-result=error]") }
        focus "focus-clear-action" { target = css(".a3s-preview[data-preview-component=bulk-action-bar] [data-bulk-clear]") }
        press "clear-selection" { key = "Enter" }
        expect "bulk-actions-hidden" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar]:has(.bulk-action-bar[data-state=empty][hidden])") }
        expect "focus-returned" { visible = css("#bulk-action-bar-collection-en:focus") }
    }
}
