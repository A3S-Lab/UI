suite "a3s-ui-feedback-and-data" {
    version = 1

    scenario "alert" {
        name = "Alert preview exposes status feedback"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/alert.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "alert-visible" { visible = css(".a3s-preview[data-preview-component=alert] .alert") }
    }

    scenario "badge" {
        name = "Badge preview renders semantic variants"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/badge.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "destructive-badge-visible" { visible = css(".a3s-preview[data-preview-component=badge] .badge[data-variant=destructive]") }
    }

    scenario "status-badge" {
        name = "Status Badge preview exposes every operational state with text"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/status-badge.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "active-status-visible" { visible = css(".a3s-preview[data-preview-component=status-badge] .status-badge[data-state=active][data-indicator]") }
        expect "success-status-visible" { visible = css(".a3s-preview[data-preview-component=status-badge] .status-badge[data-state=success]") }
        expect "warning-status-visible" { visible = css(".a3s-preview[data-preview-component=status-badge] .status-badge[data-state=warning]") }
        expect "danger-status-visible" { visible = css(".a3s-preview[data-preview-component=status-badge] .status-badge[data-state=danger]") }
    }

    scenario "empty" {
        name = "Empty preview presents recovery actions"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/empty.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "empty-state-visible" { visible = css(".a3s-preview[data-preview-component=empty] .empty") }
        expect "empty-action-visible" { visible = css(".a3s-preview[data-preview-component=empty] .empty .btn") }
    }

    scenario "progress" {
        name = "Progress preview exposes a synchronized value"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/progress.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "progress-synchronized" { visible = css("#progress-demo[aria-valuenow='66'] > span[style*='66%']") }
    }

    scenario "skeleton" {
        name = "Skeleton preview renders loading placeholders"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/skeleton.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "skeleton-visible" { visible = css(".a3s-preview[data-preview-component=skeleton] .skeleton") }
    }

    scenario "spinner" {
        name = "Spinner preview exposes an accessible loading status"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/spinner.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "spinner-visible" { visible = css(".a3s-preview[data-preview-component=spinner] [role=status][aria-label=Loading]") }
    }

    scenario "toast" {
        name = "Toast stays compact, supports keyboard focus, and dismisses cleanly"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/toast.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        viewport "phone" { width = 390 height = 844 }
        click "create-toast" { target = role("button", "Toast from front-end") }
        expect "toast-visible" { visible = css("#toaster .toast:not([aria-hidden=true])") }
        expect "toast-title-visible" { visible = css(".rp-not-doc #toaster .toast h2") }
        expect "toast-description-visible" { visible = css(".rp-not-doc #toaster .toast p") }
        focus "focus-dismiss" { target = css("#toaster [data-toast-cancel]") }
        screenshot "toast-phone-focused" { path = "components/toast-phone-focused.png" }
        click "dismiss-toast" { target = css("#toaster [data-toast-cancel]") }
        expect "toast-dismissed" { visible = css("#toaster:not(:has(.toast:not([aria-hidden=true])))") }
    }

    scenario "accordion" {
        name = "Accordion preview switches the expanded disclosure"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/accordion.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        click "open-return-policy" { target = css(".a3s-preview[data-preview-component=accordion] details:nth-of-type(2) > summary") }
        expect "return-policy-open" { visible = css(".a3s-preview[data-preview-component=accordion] details:nth-of-type(2)[open]") }
    }

    scenario "avatar" {
        name = "Avatar preview uses local resilient imagery"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/avatar.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "local-avatar-visible" { visible = css(".a3s-preview[data-preview-component=avatar] .avatar img[src^='/UI/assets/images/avatar-']") }
    }

    scenario "card" {
        name = "Card fills its mobile preview and keeps compact variants reachable"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/card.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        viewport "phone" { width = 390 height = 844 }
        fill "enter-email" { target = css(".a3s-preview[data-preview-component=card] input[type=email]") value = "tester@example.test" }
        fill "enter-password" { target = css(".a3s-preview[data-preview-component=card] input[type=password]") value = "correct-horse-battery-staple" }
        expect "card-visible" { visible = css(".a3s-preview[data-preview-component=card] .card") }
        expect "small-card-visible" { visible = css(".a3s-preview[data-preview-component=card] .card[data-size=sm]") }
        focus "focus-login" { target = css(".a3s-preview[data-preview-component=card] .card:first-child footer .btn:first-child") }
        expect "login-focused" { visible = css(".a3s-preview[data-preview-component=card] .card:first-child footer .btn:first-child:focus") }
        screenshot "card-phone" { path = "components/card-phone.png" }
    }

    scenario "chart" {
        name = "Chart preview mounts a responsive canvas"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/chart.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "chart-visible" { visible = css(".a3s-preview[data-preview-component=chart] canvas[aria-label='bar chart preview']") }
    }

    scenario "item" {
        name = "Item preview exposes contextual actions and native button rows"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/item.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "item-visible" { visible = css(".a3s-preview[data-preview-component=item] .item[data-variant=outline]") }
        expect "item-action-visible" { visible = css(".a3s-preview[data-preview-component=item] .item .btn") }
        expect "button-item-visible" { visible = css(".a3s-preview[data-preview-component=item] button.item > [data-item-content] + [data-item-actions]") }
    }

    scenario "kbd" {
        name = "Kbd preview renders keyboard shortcut tokens"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/kbd.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "keyboard-token-visible" { visible = css(".a3s-preview[data-preview-component=kbd] kbd.kbd") }
    }

    scenario "table" {
        name = "Table preview renders its caption and data rows"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/table.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "table-visible" { visible = css(".a3s-preview[data-preview-component=table] .table-container table.table") }
        expect "caption-visible" { visible = css(".a3s-preview[data-preview-component=table] table > caption") }
    }

    scenario "property-list" {
        name = "Property List preview preserves native operational metadata"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/property-list.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "property-list-visible" { visible = css(".a3s-preview[data-preview-component=property-list] dl.property-list") }
        expect "provider-pair-visible" { visible = css(".a3s-preview[data-preview-component=property-list] .property-list > div:first-child > dt + dd") }
        viewport "phone" { width = 390 height = 844 }
        expect "property-list-phone-visible" { visible = css(".a3s-preview[data-preview-component=property-list] dl.property-list") }
    }

    scenario "stepper" {
        name = "Stepper preview exposes completed, current, and pending process stages"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/stepper.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "completed-stage-visible" { visible = css(".a3s-preview[data-preview-component=stepper] .stepper > li[data-state=success]") }
        expect "current-stage-visible" { visible = css(".a3s-preview[data-preview-component=stepper] .stepper > li[data-state=active][aria-current=step]") }
        expect "pending-stage-visible" { visible = css(".a3s-preview[data-preview-component=stepper] .stepper > li:not([data-state])") }
        viewport "phone" { width = 390 height = 844 }
        focus "focus-scrollable-stepper" { target = css(".a3s-preview[data-preview-component=stepper] .stepper[tabindex=0]") }
        expect "phone-stepper-visible" { visible = css(".a3s-preview[data-preview-component=stepper] .stepper") }
        screenshot "stepper-phone" { path = "components/stepper-phone.png" }
    }

    scenario "timeline" {
        name = "Timeline preview exposes completed, current, and pending events"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/timeline.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "completed-event-visible" { visible = css(".a3s-preview[data-preview-component=timeline] .timeline > li[data-state=success]") }
        expect "current-event-visible" { visible = css(".a3s-preview[data-preview-component=timeline] .timeline > li[data-state=active][aria-current=step]") }
        expect "pending-event-visible" { visible = css(".a3s-preview[data-preview-component=timeline] .timeline > li:not([data-state])") }
    }

    scenario "log-viewer" {
        name = "Log Viewer preview keeps ordered stream records and compaction evidence"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/log-viewer.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "log-region-visible" { visible = css(".a3s-preview[data-preview-component=log-viewer] .log-viewer [role=log][aria-live=polite][tabindex=0]") }
        expect "selected-filter-visible" { visible = css(".a3s-preview[data-preview-component=log-viewer] [data-log-actions] button[aria-pressed=true]") }
        expect "stderr-visible" { visible = css(".a3s-preview[data-preview-component=log-viewer] [data-log-record][data-stream=stderr]") }
        expect "compaction-visible" { visible = css(".a3s-preview[data-preview-component=log-viewer] [data-log-gap]") }
        viewport "phone" { width = 390 height = 844 }
        focus "focus-log-region" { target = css(".a3s-preview[data-preview-component=log-viewer] [role=log]") }
        expect "log-region-focused" { visible = css(".a3s-preview[data-preview-component=log-viewer] [role=log]:focus") }
        screenshot "log-viewer-phone" { path = "components/log-viewer-phone.png" }
    }

    scenario "tree" {
        name = "Tree preserves hierarchy, selection, disabled-node skipping, and localized copy"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/tree.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "tree-initialized" { visible = css("#tree-demo[data-tree-initialized=true]") }
        focus "focus-root-branch" { target = css("#tree-demo-src") }
        press "collapse-root-branch" { key = "ArrowLeft" }
        expect "root-collapsed" { visible = css("#tree-demo-src[aria-expanded=false]:focus") }
        press "expand-root-branch" { key = "ArrowRight" }
        press "enter-root-branch" { key = "ArrowRight" }
        expect "components-focused" { visible = css("#tree-demo-components:focus") }
        press "enter-components" { key = "ArrowRight" }
        expect "first-file-focused" { visible = css("#tree-demo [role=treeitem][aria-label='button.css']:focus") }
        press "move-to-selected-file" { key = "ArrowDown" }
        expect "tree-file-focused" { visible = css("#tree-demo-tree-css:focus") }
        press "skip-disabled-file" { key = "ArrowDown" }
        expect "tests-focused" { visible = css("#tree-demo-tests:focus") }
        press "select-tests" { key = "Space" }
        expect "tests-selected" { visible = css("#tree-demo-tests[aria-selected=true]") }
        click "expand-tests" { target = css("#tree-demo-tests > [data-tree-row]") }
        expect "tests-expanded" { visible = css("#tree-demo-tests[aria-expanded=true] > [role=group]:not([hidden])") }
        viewport "phone" { width = 390 height = 844 }
        screenshot "tree-phone" { path = "components/tree-phone.png" }
        navigate "open-chinese" { url = "http://127.0.0.1:4178/UI/components/tree.html" }
        wait "chinese-loaded" { load = "networkidle" }
        wait "chinese-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "localized-tree-title" { text = "树形控件" }
        expect "localized-project-tree" { visible = css("#tree-demo[aria-label='项目文件'][data-tree-initialized=true]") }
    }
}
