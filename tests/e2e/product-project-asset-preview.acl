suite "a3s-ui-product-project-asset-preview" {
    version = 1

    scenario "project-asset-preview-desktop" {
        name = "Project asset previews retain desktop context and restore focus"
        surface = "web"
        timeout_ms = 120000
        viewport "desktop" { width = 1440 height = 900 }

        navigate "open-project" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience.html" }
        wait "project-loaded" { load = "networkidle" }
        wait "project-ready" { visible = css("[data-product-surface=project]") }
        click "open-assets" { target = role("tab", "资产") }
        expect "asset-context-ready" { visible = css("[data-product-surface=project]:has(.product-project-workspace__tabs):has([data-asset-row]):has(.product-project-workspace__composer):has(aside[aria-label='项目配置'])") }

        click "open-code-preview" { target = css("[data-asset-id=design-md] [data-asset-open]") }
        expect "code-dialog" { visible = css("dialog[data-project-asset-dialog][open][aria-modal=true] [data-workbench-kind=code][data-presentation=dialog]") }
        expect "context-retained" { visible = css("[data-product-surface=project]:has(.product-project-workspace__tabs):has([data-asset-row]):has(.product-project-workspace__composer):has(aside[aria-label='项目配置'])") }
        expect "close-semantic" { visible = css("[data-file-workbench-close][aria-label='关闭文件预览'] svg[data-icon=close]") }
        expect "initial-focus" { visible = css("[data-file-workbench-close]:focus") }
        hover "close-pointer-reachable" { target = role("button", "关闭文件预览") }
        accessibility "code-accessibility" { path = "product/project-asset-preview-desktop-accessibility.json" interactive = true }
        press "close-code-with-escape" { key = "Escape" }
        expect "code-focus-restored" { visible = css("[data-asset-id=design-md] [data-asset-open]:focus") }

        click "open-evidence-folder" { target = css("[data-asset-id=visual-acceptance] [data-asset-open]") }
        click "open-pdf-preview" { target = css("[data-asset-id=visual-report] [data-asset-open]") }
        expect "pdf-dialog" { visible = css("dialog[data-project-asset-dialog][open] [data-workbench-kind=pdf][data-presentation=dialog]") }
        wait "pdf-ready" { visible = css("input[aria-label='页码'][value='1']") }
        click "close-pdf" { target = role("button", "关闭文件预览") }
        expect "pdf-focus-restored" { visible = css("[data-asset-id=visual-report] [data-asset-open]:focus") }
        click "return-to-root" { target = css("[data-asset-back]") }

        click "open-office-preview" { target = css("[data-asset-id=experience-brief] [data-asset-open]") }
        expect "office-dialog" { visible = css("dialog[data-project-asset-dialog][open] [data-workbench-kind=document][data-presentation=dialog]") }
        expect "office-preview-tools" { visible = css("[data-office-load-state=ready] [aria-label='文字预览工具']") }
        expect "office-preview-document" { visible = css("[aria-label='文字预览'] [aria-label='文档内容编辑区域']") }
        accessibility "office-accessibility" { path = "product/project-asset-preview-desktop-office-accessibility.json" interactive = true }
        click "close-office" { target = role("button", "关闭文件预览") }
        expect "office-focus-restored" { visible = css("[data-asset-id=experience-brief] [data-asset-open]:focus") }

        console "console" { path = "product/project-asset-preview-desktop-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-asset-preview-desktop-page-errors.json" clear = false }
    }

    scenario "project-asset-preview-mobile" {
        name = "Project asset preview fills the mobile viewport and restores focus"
        surface = "web"
        timeout_ms = 90000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open-project" { url = "http://127.0.0.1:4178/UI/playground/projects/a3s-ui-experience.html" }
        wait "project-loaded" { load = "networkidle" }
        wait "project-ready" { visible = css("[data-product-surface=project]") }
        click "open-assets" { target = role("tab", "资产") }
        expect "mobile-context-ready" { visible = css("[data-product-surface=project]:has(.product-project-workspace__tabs):has([data-asset-row]):has(.product-project-workspace__composer)") }

        click "open-code-preview" { target = css("[data-asset-id=design-md] [data-asset-open]") }
        expect "mobile-dialog" { visible = css("dialog[data-project-asset-dialog][open][aria-modal=true] [data-workbench-kind=code][data-presentation=dialog]") }
        expect "mobile-dialog-fills-viewport" { visible = css("dialog[data-project-asset-dialog][open].product-project-assets-dialog") }
        expect "mobile-close-semantic" { visible = css("[data-file-workbench-close][aria-label='关闭文件预览'] svg[data-icon=close]") }
        expect "mobile-initial-focus" { visible = css("[data-file-workbench-close]:focus") }
        hover "mobile-close-pointer-reachable" { target = role("button", "关闭文件预览") }
        accessibility "mobile-accessibility" { path = "product/project-asset-preview-mobile-accessibility.json" interactive = true }
        press "close-with-escape" { key = "Escape" }
        expect "mobile-focus-restored" { visible = css("[data-asset-id=design-md] [data-asset-open]:focus") }

        console "console" { path = "product/project-asset-preview-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/project-asset-preview-mobile-page-errors.json" clear = false }
    }
}
