suite "a3s-ui-navigation-and-overlays" {
    version = 1

    scenario "activity-bar" {
        name = "Activity Bar updates current destination, keeps compact labels accessible, and confirms Chinese phone selection"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/activity-bar.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=activity-bar][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-activity-bar-primary-demo=en] [data-activity-item=overview][aria-current=page]") }
        expect "status-overview" { text = "Overview" }
        focus "focus-traces" { target = css("[data-activity-bar-primary-demo=en] [data-activity-item=traces]") }
        press "open-traces" { key = "Enter" }
        expect "traces-current" { visible = css("[data-activity-bar-primary-demo=en] [data-activity-item=traces][aria-current=page]") }
        expect "overview-cleared" { visible = css("[data-activity-bar-primary-demo=en]:has([data-activity-item=overview]:not([aria-current]))") }
        expect "status-traces" { text = "Traces" }
        expect "compact-labels-hidden" { visible = css("[data-activity-bar-primary-demo=en] [data-activity-compact][data-labels=hidden] [data-activity-item=compact-overview][aria-label=Overview]") }
        screenshot "activity-bar-current" { path = "components/activity-bar-current.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=activity-bar][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=activity-bar]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=activity-bar] [data-state-specimen=ready]") }
        screenshot "activity-bar-states" { path = "components/activity-bar-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=activity-bar][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/activity-bar.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-activity-bar-primary-demo=zh] [data-activity-item=overview][aria-current=page]") }
        focus "focus-chinese-settings" { target = css("[data-activity-bar-primary-demo=zh] [data-activity-item=settings]") }
        press "activate-chinese-settings" { key = "Enter" }
        expect "chinese-settings-current" { visible = css("[data-activity-bar-primary-demo=zh] [data-activity-item=settings][aria-current=page]") }
        expect "chinese-status" { text = "设置" }
        screenshot "activity-bar-chinese-phone" { path = "components/activity-bar-chinese-phone.png" }
        accessibility "activity-bar-accessibility" { path = "components/activity-bar-accessibility.json" interactive = true }
        console "activity-bar-console" { path = "components/activity-bar-console.json" clear = false }
        page_errors "activity-bar-errors" { path = "components/activity-bar-errors.json" clear = false }
    }

    scenario "breadcrumb" {
        name = "Breadcrumb exposes current page, keeps ancestors keyboard-reachable, and confirms Chinese compact path"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/breadcrumb.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=breadcrumb][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-breadcrumb-primary-demo=en][aria-label=Breadcrumb]") }
        expect "current-page" { visible = css("[data-breadcrumb-primary-demo=en] [data-breadcrumb-current][aria-current=page]") }
        expect "current-copy" { text = "Breadcrumb" }
        focus "focus-home" { target = css("[data-breadcrumb-primary-demo=en] [data-breadcrumb-link=home]") }
        expect "home-focused" { visible = css("[data-breadcrumb-primary-demo=en] [data-breadcrumb-link=home]:focus") }
        focus "focus-components" { target = css("[data-breadcrumb-primary-demo=en] [data-breadcrumb-link=components]") }
        expect "components-focused" { visible = css("[data-breadcrumb-primary-demo=en] [data-breadcrumb-link=components]:focus") }
        screenshot "breadcrumb-desktop" { path = "components/breadcrumb-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=breadcrumb][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=breadcrumb]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=breadcrumb] [data-state-specimen=ready]") }
        screenshot "breadcrumb-states" { path = "components/breadcrumb-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=breadcrumb][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/breadcrumb.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-breadcrumb-primary-demo=zh][aria-label=面包屑] [data-breadcrumb-current][aria-current=page]") }
        expect "chinese-current-copy" { text = "面包屑" }
        focus "focus-chinese-components" { target = css("[data-breadcrumb-primary-demo=zh] [data-breadcrumb-link=components]") }
        expect "chinese-components-focused" { visible = css("[data-breadcrumb-primary-demo=zh] [data-breadcrumb-link=components]:focus") }
        screenshot "breadcrumb-chinese-phone" { path = "components/breadcrumb-chinese-phone.png" }
        accessibility "breadcrumb-accessibility" { path = "components/breadcrumb-accessibility.json" interactive = true }
        console "breadcrumb-console" { path = "components/breadcrumb-console.json" clear = false }
        page_errors "breadcrumb-errors" { path = "components/breadcrumb-errors.json" clear = false }
    }

    scenario "tabs" {
        name = "Tabs switches panels with Home/End, skips disabled tabs, preserves RTL arrows, and confirms Chinese phone activation"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/tabs.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-tabs-primary-demo=en]#demo-tabs-with-panels") }
        focus "focus-first-tab" { target = css("#demo-tabs-with-panels-tab-1") }
        press "move-to-end-tab" { key = "End" }
        wait "second-tab-selected" { visible = css("#demo-tabs-with-panels-tab-2[aria-selected=true]:focus") }
        expect "second-panel-visible" { visible = css("#demo-tabs-with-panels-panel-2:not([hidden])") }
        press "move-to-start-tab" { key = "Home" }
        wait "first-tab-selected" { visible = css("#demo-tabs-with-panels-tab-1[aria-selected=true]:focus") }
        expect "first-panel-visible" { visible = css("#demo-tabs-with-panels-panel-1:not([hidden])") }
        screenshot "tabs-home-end" { path = "components/tabs-home-end.png" }

        focus "focus-disabled-home" { target = css("#tabs-disabled-tab-home") }
        press "skip-disabled-tab" { key = "ArrowRight" }
        expect "disabled-tab-skipped" { visible = css("#tabs-disabled-tab-home[aria-selected=true]:focus") }
        expect "disabled-tab-locked" { visible = css("#tabs-disabled-tab-settings[disabled]") }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=tabs]") }
        expect "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=tabs] [data-state-specimen=ready]") }
        screenshot "tabs-states" { path = "components/tabs-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/tabs.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-tabs-primary-demo=zh]#demo-tabs-with-panels #demo-tabs-with-panels-tab-1[aria-selected=true]") }
        focus "focus-chinese-second-tab" { target = css("[data-tabs-primary-demo=zh] #demo-tabs-with-panels-tab-2") }
        press "activate-chinese-second-tab" { key = "Enter" }
        wait "chinese-second-active" { visible = css("[data-tabs-primary-demo=zh] #demo-tabs-with-panels-tab-2[aria-selected=true]") }
        expect "chinese-second-panel" { visible = css("[data-tabs-primary-demo=zh] #demo-tabs-with-panels-panel-2:not([hidden])") }
        expect "chinese-password-heading" { text = "密码" }
        screenshot "tabs-chinese-phone" { path = "components/tabs-chinese-phone.png" }

        navigate "open-rtl-phone" { url = "http://127.0.0.1:4178/UI/en/components/tabs.html" }
        wait "rtl-phone-loaded" { load = "domcontentloaded" }
        wait "rtl-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        focus "focus-first-rtl-tab" { target = css("#tabs-rtl-tab-overview") }
        press "move-right-in-rtl" { key = "ArrowRight" }
        expect "rtl-last-tab-active" { visible = css("#tabs-rtl-tab-settings[aria-selected=true]:focus") }
        expect "rtl-last-panel-visible" { visible = css("#tabs-rtl-panel-settings:not([hidden])") }
        screenshot "tabs-compact-rtl" { path = "components/tabs-compact-rtl.png" }
        accessibility "tabs-accessibility" { path = "components/tabs-accessibility.json" interactive = true }
        console "tabs-console" { path = "components/tabs-console.json" clear = false }
        page_errors "tabs-errors" { path = "components/tabs-errors.json" clear = false }
    }

    scenario "pagination" {
        name = "Pagination moves current page with keyboard, previous/next, outline sync, and Chinese phone confirmation"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/pagination.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=pagination][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-pagination-primary-demo=en] [data-pagination-page='2'][aria-current=page][data-variant=outline]") }
        expect "status-page-two" { text = "Page 2" }
        focus "focus-page-three" { target = css("[data-pagination-primary-demo=en] [data-pagination-page='3']") }
        press "select-page-three" { key = "Enter" }
        expect "page-three-current" { visible = css("[data-pagination-primary-demo=en] [data-pagination-page='3'][aria-current=page][data-variant=outline]") }
        expect "page-two-cleared" { visible = css("[data-pagination-primary-demo=en] [data-pagination-page='2'][data-variant=ghost]:not([aria-current])") }
        expect "status-page-three" { text = "Page 3" }
        click "go-previous" { target = css("[data-pagination-primary-demo=en] [data-pagination-direction=previous]") }
        expect "page-two-restored" { visible = css("[data-pagination-primary-demo=en] [data-pagination-page='2'][aria-current=page][data-variant=outline]") }
        click "go-next" { target = css("[data-pagination-primary-demo=en] [data-pagination-direction=next]") }
        expect "page-three-from-next" { visible = css("[data-pagination-primary-demo=en] [data-pagination-page='3'][aria-current=page]") }
        expect "ellipsis-present" { visible = css("[data-pagination-primary-demo=en] [data-pagination-ellipsis][aria-hidden=true]") }
        screenshot "pagination-desktop" { path = "components/pagination-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=pagination][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=pagination]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=pagination] [data-state-specimen=ready]") }
        screenshot "pagination-states" { path = "components/pagination-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=pagination][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/pagination.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-pagination-primary-demo=zh] [data-pagination-page='2'][aria-current=page]") }
        focus "focus-chinese-page-one" { target = css("[data-pagination-primary-demo=zh] [data-pagination-page='1']") }
        press "select-chinese-page-one" { key = "Enter" }
        expect "chinese-page-one-current" { visible = css("[data-pagination-primary-demo=zh] [data-pagination-page='1'][aria-current=page][data-variant=outline]") }
        expect "chinese-status" { text = "第 1 页" }
        expect "chinese-next-label" { text = "下一页" }
        screenshot "pagination-chinese-phone" { path = "components/pagination-chinese-phone.png" }
        accessibility "pagination-accessibility" { path = "components/pagination-accessibility.json" interactive = true }
        console "pagination-console" { path = "components/pagination-console.json" clear = false }
        page_errors "pagination-errors" { path = "components/pagination-errors.json" clear = false }
    }

    scenario "sidebar" {
        name = "Sidebar stays contained, toggles desktop navigation, restores mobile Escape focus, and confirms Chinese phone open"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/sidebar.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=sidebar][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-sidebar-primary-demo=en] #demo-sidebar nav") }
        expect "current-page" { visible = css("[data-sidebar-primary-demo=en] #demo-sidebar a[aria-current=page]") }
        click "toggle-sidebar" { target = css("[data-sidebar-primary-demo=en] [data-sidebar-toggle]") }
        wait "sidebar-closed" { visible = css("[data-sidebar-primary-demo=en]:has(#demo-sidebar[aria-hidden=true]) main h2") }
        expect "sidebar-closed-copy" { text = "Contained product navigation" }
        screenshot "sidebar-desktop-closed" { path = "components/sidebar-desktop-closed.png" }
        click "reopen-sidebar" { target = css("[data-sidebar-primary-demo=en] [data-sidebar-toggle]") }
        wait "sidebar-reopened" { visible = css("[data-sidebar-primary-demo=en] #demo-sidebar[aria-hidden=false] nav") }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=sidebar][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=sidebar]") }
        expect "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=sidebar] [data-state-specimen=ready]") }
        screenshot "sidebar-states" { path = "components/sidebar-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=sidebar][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/sidebar.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-sidebar-primary-demo=zh] [data-sidebar-toggle]") }
        click "open-chinese-sidebar" { target = css("[data-sidebar-primary-demo=zh] [data-sidebar-toggle]") }
        wait "chinese-sidebar-open" { visible = css("[data-sidebar-primary-demo=zh] #demo-sidebar[aria-hidden=false] nav a") }
        wait "chinese-nav-focus" { visible = css("[data-sidebar-primary-demo=zh] #demo-sidebar nav a:first-of-type:focus") }
        expect "chinese-overview" { text = "概览" }
        screenshot "sidebar-chinese-phone" { path = "components/sidebar-chinese-phone.png" }
        press "close-chinese-sidebar" { key = "Escape" }
        wait "chinese-sidebar-closed" { visible = css("[data-sidebar-primary-demo=zh]:has(#demo-sidebar[aria-hidden=true]) [data-sidebar-toggle]") }
        expect "chinese-toggle-restored" { visible = css("[data-sidebar-primary-demo=zh] [data-sidebar-toggle]:focus") }
        accessibility "sidebar-accessibility" { path = "components/sidebar-accessibility.json" interactive = true }
        console "sidebar-console" { path = "components/sidebar-console.json" clear = false }
        page_errors "sidebar-errors" { path = "components/sidebar-errors.json" clear = false }
    }

    scenario "alert-dialog" {
        name = "Alert Dialog focuses cancel safely, restores the trigger, and confirms Chinese destructive copy"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/alert-dialog.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=alert-dialog][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-alert-dialog-primary-demo=en] #demo-alert-dialog[role=alertdialog]") }
        expect "consequence-named" { text = "This action cannot be undone." }
        focus "focus-open-dialog" { target = css("[data-alert-dialog-primary-demo=en] [data-alert-dialog-trigger]") }
        press "open-dialog" { key = "Enter" }
        wait "dialog-open" { visible = css("[data-alert-dialog-primary-demo=en] #demo-alert-dialog[open] > div") }
        expect "cancel-focused" { visible = css("[data-alert-dialog-primary-demo=en] [data-alert-dialog-cancel]:focus") }
        expect "confirm-destructive" { visible = css("[data-alert-dialog-primary-demo=en] [data-alert-dialog-confirm][data-variant=destructive]") }
        screenshot "alert-dialog-desktop" { path = "components/alert-dialog-desktop.png" }
        press "cancel-dialog" { key = "Enter" }
        expect "dialog-trigger-restored" { visible = css("[data-alert-dialog-primary-demo=en] [data-alert-dialog-trigger]:focus") }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=alert-dialog][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=alert-dialog]") }
        wait "state-specimen-open" { visible = css(".a3s-component-state-matrix[open][data-component=alert-dialog] [data-state-specimen=open] dialog.alert-dialog[open]") }
        expect "state-specimen-closed" { visible = css(".a3s-component-state-matrix[open][data-component=alert-dialog] [data-state-specimen=closed]:has(dialog.alert-dialog:not([open]))") }
        screenshot "alert-dialog-states" { path = "components/alert-dialog-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=alert-dialog][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/alert-dialog.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-alert-dialog-primary-demo=zh] [data-alert-dialog-trigger]") }
        focus "focus-open-chinese" { target = css("[data-alert-dialog-primary-demo=zh] [data-alert-dialog-trigger]") }
        press "open-chinese" { key = "Enter" }
        wait "chinese-dialog-open" { visible = css("[data-alert-dialog-primary-demo=zh] #demo-alert-dialog[open] > div") }
        expect "chinese-title" { text = "删除账户？" }
        expect "chinese-cancel-focused" { visible = css("[data-alert-dialog-primary-demo=zh] [data-alert-dialog-cancel]:focus") }
        screenshot "alert-dialog-chinese-phone" { path = "components/alert-dialog-chinese-phone.png" }
        press "cancel-chinese" { key = "Enter" }
        expect "chinese-trigger-restored" { visible = css("[data-alert-dialog-primary-demo=zh] [data-alert-dialog-trigger]:focus") }
        accessibility "alert-dialog-accessibility" { path = "components/alert-dialog-accessibility.json" interactive = true }
        console "alert-dialog-console" { path = "components/alert-dialog-console.json" clear = false }
        page_errors "alert-dialog-errors" { path = "components/alert-dialog-errors.json" clear = false }
    }

    scenario "dialog" {
        name = "Dialog accepts edits, restores Escape focus, and confirms Chinese profile editing"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/dialog.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=dialog][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-dialog-primary-demo=en] [data-dialog-trigger]") }
        focus "focus-open-dialog" { target = css("[data-dialog-primary-demo=en] [data-dialog-trigger]") }
