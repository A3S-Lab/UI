        press "reopen-context-menu" { key = "Shift+F10" }
        click "disable-watch" { target = css("[data-context-primary-demo=en] [role=menuitemcheckbox][data-value=watch]") }
        expect "watch-selection-closed-menu" { visible = css("[data-context-primary-demo=en][data-state=closed] [data-context-trigger]:focus") }
        press "reopen-to-check-state" { key = "Shift+F10" }
        expect "watch-state-preserved" { visible = css("[data-context-primary-demo=en] [role=menuitemcheckbox][data-value=watch][aria-checked=false]") }
        screenshot "context-menu-desktop" { path = "components/context-menu-desktop.png" }
        press "close-context-menu" { key = "Escape" }
        expect "trigger-restored" { visible = css("[data-context-primary-demo=en] [data-context-trigger]:focus") }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=context-menu][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=context-menu]") }
        wait "state-specimen-open" { visible = css(".a3s-component-state-matrix[open][data-component=context-menu] [data-state-specimen=open]") }
        expect "state-specimen-closed" { visible = css(".a3s-component-state-matrix[open][data-component=context-menu] [data-state-specimen=closed]") }
        screenshot "context-menu-states" { path = "components/context-menu-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=context-menu][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/context-menu.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-context-primary-demo=zh][data-context-menu-initialized=true] [data-context-trigger]") }
        focus "focus-chinese-trigger" { target = css("[data-context-primary-demo=zh] [data-context-trigger]") }
        press "open-chinese-menu" { key = "Shift+F10" }
        expect "chinese-menu-open" { visible = css("[data-context-primary-demo=zh][data-state=open] > [data-context-content][aria-hidden=false]") }
        expect "chinese-help" { text = "右键单击，或聚焦后按 Shift + F10。" }
        screenshot "context-menu-chinese-phone" { path = "components/context-menu-chinese-phone.png" }
        press "close-chinese-menu" { key = "Escape" }
        expect "chinese-trigger-restored" { visible = css("[data-context-primary-demo=zh] [data-context-trigger]:focus") }
        accessibility "context-menu-accessibility" { path = "components/context-menu-accessibility.json" interactive = true }
        console "context-menu-console" { path = "components/context-menu-console.json" clear = false }
        page_errors "context-menu-errors" { path = "components/context-menu-errors.json" clear = false }
    }

    scenario "back-to-bottom" {
        name = "Back to Bottom clears unread on activate, keeps always-visible demo, and confirms Chinese copy"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/back-to-bottom.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=back-to-bottom][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-back-to-bottom-primary-demo=en] .back-to-bottom[data-always-visible][data-unread='3']:not([hidden])") }
        expect "unread-badge" { visible = css("[data-back-to-bottom-primary-demo=en] [data-unread-count]:not([hidden])") }
        expect "status-unread" { text = "3 unread updates waiting" }
        click "activate-back-to-bottom" { target = css("[data-back-to-bottom-primary-demo=en] [data-back-to-bottom-trigger]") }
        expect "unread-cleared" { visible = css("[data-back-to-bottom-primary-demo=en] .back-to-bottom[data-unread='0']:not([hidden])") }
        expect "status-returned" { text = "Returned to latest output" }
        screenshot "back-to-bottom-desktop" { path = "components/back-to-bottom-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=back-to-bottom][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=back-to-bottom]") }
        expect "state-specimen-visible" { visible = css(".a3s-component-state-matrix[open][data-component=back-to-bottom] [data-state-specimen=visible]") }
        expect "state-specimen-unread" { visible = css(".a3s-component-state-matrix[open][data-component=back-to-bottom] [data-state-specimen=unread]") }
        screenshot "back-to-bottom-states" { path = "components/back-to-bottom-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=back-to-bottom][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/back-to-bottom.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-back-to-bottom-primary-demo=zh] .back-to-bottom[data-unread='3']") }
        expect "chinese-label" { text = "回到最新内容" }
        click "activate-chinese" { target = css("[data-back-to-bottom-primary-demo=zh] [data-back-to-bottom-trigger]") }
        expect "chinese-status" { text = "已回到最新内容" }
        screenshot "back-to-bottom-chinese-phone" { path = "components/back-to-bottom-chinese-phone.png" }
        accessibility "back-to-bottom-accessibility" { path = "components/back-to-bottom-accessibility.json" interactive = true }
        console "back-to-bottom-console" { path = "components/back-to-bottom-console.json" clear = false }
        page_errors "back-to-bottom-errors" { path = "components/back-to-bottom-errors.json" clear = false }
    }

    scenario "floating-panel" {
        name = "Floating Panel closes with focus restore, reopens from trigger, and confirms Chinese close"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/floating-panel.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=floating-panel][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-floating-panel-primary-demo=en] .floating-panel[data-state=open]:not([hidden])") }
        expect "status-open" { text = "Inspector open" }
        focus "focus-close" { target = css("[data-floating-panel-primary-demo=en] [data-floating-panel-action=close]") }
        press "close-panel" { key = "Enter" }
        wait "panel-closed" { visible = css("[data-floating-panel-primary-demo=en]:has(.floating-panel[data-state=closed][hidden])") }
        expect "status-closed" { text = "Inspector closed" }
        click "reopen-panel" { target = css("[data-floating-panel-primary-demo=en] [data-floating-panel-reopen]") }
        wait "panel-reopened" { visible = css("[data-floating-panel-primary-demo=en] .floating-panel[data-state=open]:not([hidden])") }
        expect "status-reopened" { text = "Inspector open" }
        screenshot "floating-panel-desktop" { path = "components/floating-panel-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=floating-panel][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=floating-panel]") }
        expect "state-specimen-open" { visible = css(".a3s-component-state-matrix[open][data-component=floating-panel] [data-state-specimen=open]") }
        expect "state-specimen-closed" { visible = css(".a3s-component-state-matrix[open][data-component=floating-panel] [data-state-specimen=closed]") }
        screenshot "floating-panel-states" { path = "components/floating-panel-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=floating-panel][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/floating-panel.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-floating-panel-primary-demo=zh] .floating-panel[data-state=open]") }
        expect "chinese-title" { text = "检查器" }
        click "close-chinese" { target = css("[data-floating-panel-primary-demo=zh] [data-floating-panel-action=close]") }
        wait "chinese-closed" { visible = css("[data-floating-panel-primary-demo=zh]:has(.floating-panel[data-state=closed][hidden])") }
        expect "chinese-status" { text = "检查器已关闭" }
        screenshot "floating-panel-chinese-phone" { path = "components/floating-panel-chinese-phone.png" }
        accessibility "floating-panel-accessibility" { path = "components/floating-panel-accessibility.json" interactive = true }
        console "floating-panel-console" { path = "components/floating-panel-console.json" clear = false }
        page_errors "floating-panel-errors" { path = "components/floating-panel-errors.json" clear = false }
    }

    scenario "table-of-contents" {
        name = "Table of Contents updates current location from keyboard, covers state matrix, and confirms Chinese navigation"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/table-of-contents.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=table-of-contents][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-toc-primary-demo=en] [data-toc-item=overview][aria-current=location]") }
        focus "focus-contract" { target = css("[data-toc-primary-demo=en] [data-toc-item=contract]") }
        press "activate-contract" { key = "Enter" }
        expect "contract-current" { visible = css("[data-toc-primary-demo=en] [data-toc-item=contract][aria-current=location]") }
        expect "overview-cleared" { visible = css("[data-toc-primary-demo=en]:has([data-toc-item=overview]:not([aria-current]))") }
        screenshot "table-of-contents-desktop" { path = "components/table-of-contents-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=table-of-contents][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=table-of-contents]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=table-of-contents] [data-state-specimen=ready]") }
        screenshot "table-of-contents-states" { path = "components/table-of-contents-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=table-of-contents][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/table-of-contents.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-toc-primary-demo=zh][aria-label=本页目录] [data-toc-item=overview][aria-current=location]") }
        focus "focus-chinese-a11y" { target = css("[data-toc-primary-demo=zh] [data-toc-item=accessibility]") }
        press "activate-chinese-a11y" { key = "Enter" }
        expect "chinese-a11y-current" { visible = css("[data-toc-primary-demo=zh] [data-toc-item=accessibility][aria-current=location]") }
        expect "chinese-a11y-copy" { text = "无障碍" }
        screenshot "table-of-contents-chinese-phone" { path = "components/table-of-contents-chinese-phone.png" }
        accessibility "table-of-contents-accessibility" { path = "components/table-of-contents-accessibility.json" interactive = true }
        console "table-of-contents-console" { path = "components/table-of-contents-console.json" clear = false }
        page_errors "table-of-contents-errors" { path = "components/table-of-contents-errors.json" clear = false }
    }
}
