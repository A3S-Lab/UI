suite "a3s-ui-component-framework-docs" {
    version = 1

    scenario "framework-preview-integration-desktop" {
        name = "Component previews expose localized HTML, React, and Vue integration code"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open-chinese" { url = "http://127.0.0.1:4178/UI/components/tabs.html" }
        wait "chinese-loaded" { load = "networkidle" }
        wait "chinese-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "complete-preview" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete]") }
        expect "fluid-control-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=viewport][data-preview-viewport-option=fluid][aria-pressed=true] svg[data-preview-icon=viewport-fluid]") }
        expect "dark-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=appearance][data-preview-target=dark][aria-label='切换为深色预览'] svg[data-preview-icon=theme-dark]") }
        click "preview-dark" { target = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=appearance]") }
        expect "restore-light-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete][data-preview-scheme=dark] button[data-preview-control=appearance][data-preview-target=light][aria-label='恢复文档主题'] svg[data-preview-icon=theme-light]") }
        click "restore-preview-theme" { target = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=appearance]") }
        expect "rtl-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=direction][data-preview-target=rtl] [data-preview-icon=direction-rtl]") }
        click "preview-rtl" { target = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=direction]") }
        expect "ltr-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete][data-preview-direction=rtl] button[data-preview-control=direction][data-preview-target=ltr] [data-preview-icon=direction-ltr]") }
        click "restore-preview-direction" { target = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=direction]") }
        expect "source-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=source] svg[data-preview-icon=source-code]") }
        expect "copy-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=copy] svg[data-preview-icon=copy]") }
        click "show-integration" { target = role("button", "展开接入代码") }
        expect "integrated-source" { visible = css(".a3s-preview__source > .a3s-preview-integration[data-mode=complete]") }
        expect "html-selected" { visible = css(".a3s-preview-integration [role=tab][aria-selected=true]") }
        expect "install" { text = "安装" }
        expect "workspace" { visible = css(".a3s-preview-integration__workspace") }
        expect "example" { visible = css(".a3s-preview-integration__source[data-code-file=example]") }
        click "react" { target = role("tab", "React") }
        expect "react-selected" { visible = css(".a3s-preview-integration [role=tab][aria-selected=true]") }
        expect "react-hook" { text = "useTabs" }
        expect "react-install" { text = "npm install @a3s-lab/ui react react-dom" }
        screenshot "chinese-react" { path = "documentation/framework-preview-integration-react.png" }

        navigate "open-english" { url = "http://127.0.0.1:4178/UI/en/components/tabs.html" }
        wait "english-loaded" { load = "networkidle" }
        wait "english-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "english-dark-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=appearance][data-preview-target=dark][aria-label='Preview in dark mode'] svg[data-preview-icon=theme-dark]") }
        expect "english-rtl-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=tabs][data-preview-integration=complete] button[data-preview-control=direction][data-preview-target=rtl] [data-preview-icon=direction-rtl]") }
        click "show-english-integration" { target = role("button", "Show integration code") }
        click "vue" { target = role("tab", "Vue") }
        expect "english-install" { text = "Install" }
        expect "english-example" { text = "Example" }
        expect "english-entry" { text = "Entry" }
        expect "vue-composable" { text = "Composable" }
        expect "vue-install" { text = "npm install @a3s-lab/ui vue" }
        screenshot "english-vue" { path = "documentation/framework-preview-integration-vue-en.png" }

        navigate "open-published-version" { url = "http://127.0.0.1:4178/UI/v0.3.0/components/tabs.html" }
        wait "published-loaded" { load = "networkidle" }
        wait "published-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "published-semantic-contract" { visible = css(".a3s-preview[data-framework-contract=semantic][data-preview-integration=complete]") }
        click "show-published-integration" { target = role("button", "展开接入代码") }
        click "published-react" { target = role("tab", "React") }
        expect "published-install" { text = "npm install @a3s-lab/ui@0.3.0 react react-dom" }
        click "published-entry" { target = role("tab", "入口 main.ts") }
        expect "published-runtime" { text = "@a3s-lab/ui/all" }
        expect "published-boundary" { text = "尚未提供框架适配器" }
        screenshot "published-react-evidence" { path = "documentation/framework-preview-integration-published-react.png" }

        accessibility "desktop-tree" { path = "documentation/framework-preview-integration-accessibility.json" interactive = true }
        console "desktop-console" { path = "documentation/framework-preview-integration-console.json" clear = false }
        page_errors "desktop-errors" { path = "documentation/framework-preview-integration-errors.json" clear = false }
    }

    scenario "framework-preview-integration-mobile" {
        name = "Framework integration stays usable inside a narrow component preview"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/components/agent-composer.html" }
        wait "loaded" { load = "networkidle" }
        wait "ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "complete-preview" { visible = css(".a3s-preview[data-preview-component=agent-composer][data-preview-integration=complete]") }
        expect "mobile-fluid-control-matches-icon" { visible = css(".a3s-preview[data-preview-component=agent-composer][data-preview-integration=complete] button[data-preview-control=viewport][data-preview-viewport-option=fluid][aria-pressed=true] svg[data-preview-icon=viewport-fluid]") }
        expect "mobile-dark-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=agent-composer][data-preview-integration=complete] button[data-preview-control=appearance][data-preview-target=dark] svg[data-preview-icon=theme-dark]") }
        expect "mobile-rtl-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=agent-composer][data-preview-integration=complete] button[data-preview-control=direction][data-preview-target=rtl] [data-preview-icon=direction-rtl]") }
        click "show-integration" { target = role("button", "展开接入代码") }
        focus "react-tab-in-view" { target = css(".a3s-preview[data-preview-component=agent-composer] .a3s-preview-integration [role=tab][id$='-react-tab']") }
        click "react" { target = css(".a3s-preview[data-preview-component=agent-composer] .a3s-preview-integration [role=tab][id$='-react-tab']") }
        wait "react-panel-active" { visible = css(".a3s-preview[data-preview-component=agent-composer] .a3s-preview-integration[data-framework=react] > .a3s-preview-integration__panel[role=tabpanel]") }
        expect "react-example-visible" { visible = css(".a3s-preview[data-preview-component=agent-composer] .a3s-preview-integration[data-framework=react] .a3s-preview-integration__source[data-code-file=example][data-code-filename='AgentComposerExample.tsx']") }
        expect "react-install-visible" { visible = css(".a3s-preview[data-preview-component=agent-composer] .a3s-preview-integration[data-framework=react] .a3s-preview-integration__install .a3s-preview-integration__code") }
        screenshot "mobile-react" { path = "documentation/framework-preview-integration-mobile.png" }
        console "mobile-console" { path = "documentation/framework-preview-integration-mobile-console.json" clear = false }
        page_errors "mobile-errors" { path = "documentation/framework-preview-integration-mobile-errors.json" clear = false }
    }

    scenario "framework-preview-integration-harness" {
        name = "Harness framework examples share their live preview source disclosure"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/harness/grid-view.html" }
        wait "loaded" { load = "networkidle" }
        wait "ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "complete-preview" { visible = css(".a3s-preview[data-preview-component=grid-view][data-preview-integration=complete]") }
        expect "harness-fluid-control-matches-icon" { visible = css(".a3s-preview[data-preview-component=grid-view][data-preview-integration=complete] button[data-preview-control=viewport][data-preview-viewport-option=fluid] svg[data-preview-icon=viewport-fluid]") }
        expect "harness-dark-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=grid-view][data-preview-integration=complete] button[data-preview-control=appearance][data-preview-target=dark] svg[data-preview-icon=theme-dark]") }
        expect "harness-rtl-action-matches-icon" { visible = css(".a3s-preview[data-preview-component=grid-view][data-preview-integration=complete] button[data-preview-control=direction][data-preview-target=rtl] [data-preview-icon=direction-rtl]") }
        click "show-integration" { target = role("button", "展开接入代码") }
        click "vue" { target = role("tab", "Vue") }
        expect "vue-install" { text = "dockview-vue@8.1.0" }
        expect "vue-composable" { text = "useGridview" }
        screenshot "harness-vue" { path = "documentation/framework-preview-integration-harness.png" }
        console "harness-console" { path = "documentation/framework-preview-integration-harness-console.json" clear = false }
        page_errors "harness-errors" { path = "documentation/framework-preview-integration-harness-errors.json" clear = false }
    }
}
