suite "a3s-ui-component-framework-docs" {
    version = 1

    scenario "framework-quick-start-desktop" {
        name = "Component guides expose localized HTML, React, and Vue quick starts"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open-chinese" { url = "http://127.0.0.1:4178/UI/components/tabs.html" }
        wait "chinese-loaded" { load = "networkidle" }
        wait "chinese-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "complete-quick-start" { visible = css(".component-intro[data-component-intro=tabs][data-mode=complete]") }
        expect "html-selected" { visible = css(".component-intro [role=tab][aria-selected=true]") }
        expect "install" { text = "安装" }
        expect "setup" { text = "项目入口" }
        expect "example" { text = "最小示例" }
        click "react" { target = role("tab", "React") }
        expect "react-selected" { visible = css(".component-intro [role=tab][aria-selected=true]") }
        expect "react-hook" { text = "useTabs" }
        expect "react-install" { text = "npm install @a3s-lab/ui react react-dom" }
        screenshot "chinese-react" { path = "documentation/framework-quick-start-react.png" }

        navigate "open-english" { url = "http://127.0.0.1:4178/UI/en/components/tabs.html" }
        wait "english-loaded" { load = "networkidle" }
        wait "english-ready" { visible = css("html:not([data-a3s-defer-init])") }
        click "vue" { target = role("tab", "Vue") }
        expect "english-install" { text = "Install" }
        expect "english-setup" { text = "Project entry" }
        expect "english-example" { text = "Minimal example" }
        expect "vue-composable" { text = "Composable" }
        expect "vue-install" { text = "npm install @a3s-lab/ui vue" }
        screenshot "english-vue" { path = "documentation/framework-quick-start-vue-en.png" }

        navigate "open-published-version" { url = "http://127.0.0.1:4178/UI/v0.3.0/components/tabs.html" }
        wait "published-loaded" { load = "networkidle" }
        wait "published-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "published-semantic-contract" { visible = css(".component-intro[data-framework-contract=semantic][data-mode=complete]") }
        click "published-react" { target = role("tab", "React") }
        expect "published-install" { text = "npm install @a3s-lab/ui@0.3.0 react react-dom" }
        expect "published-runtime" { text = "@a3s-lab/ui/all" }
        expect "published-boundary" { text = "尚未提供框架适配器" }
        screenshot "published-react-evidence" { path = "documentation/framework-quick-start-published-react.png" }

        accessibility "desktop-tree" { path = "documentation/framework-quick-start-accessibility.json" interactive = true }
        console "desktop-console" { path = "documentation/framework-quick-start-console.json" clear = false }
        page_errors "desktop-errors" { path = "documentation/framework-quick-start-errors.json" clear = false }
    }

    scenario "framework-quick-start-mobile" {
        name = "Framework quick start stays usable on a narrow component guide"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/components/agent-composer.html" }
        wait "loaded" { load = "networkidle" }
        wait "ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "quick-start" { visible = css(".component-intro[data-component-intro=agent-composer][data-mode=complete]") }
        click "react" { target = role("tab", "React") }
        expect "controller-hook" { text = "useAgentComposer" }
        expect "editor-hook" { text = "useAgentComposerEditor" }
        expect "tiptap-install" { text = "@tiptap/react" }
        screenshot "mobile-react" { path = "documentation/framework-quick-start-mobile.png" }
        console "mobile-console" { path = "documentation/framework-quick-start-mobile-console.json" clear = false }
        page_errors "mobile-errors" { path = "documentation/framework-quick-start-mobile-errors.json" clear = false }
    }
}
