suite "a3s-ui-workflow-surface-contracts" {
    version = 1

    scenario "workflow-dag-embedding" {
        name = "Flow 1.0 DAG Node Configuration proves node-specific edit, rejection, recovery, disclosure, and run behavior"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/components/form-system/workflow-node-embedding.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "surface-ready" { visible = css(".a3s-doc-workflow-studio[data-panel-open=true]") }
        expect "selected-node" { visible = css(".a3s-form-workflow-node-preview[data-selected=true]") }
        expect "initial-step-selected" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.step'][data-selected=true]") }
        focus "focus-open-library" { target = css(".a3s-doc-workflow-studio__library-toggle") }
        press "open-library" { key = "Enter" }
        expect "node-library-open" { visible = css(".a3s-doc-workflow-studio[data-palette-open=true] .a3s-doc-workflow-library") }
        type "filter-condition" { target = css(".a3s-doc-workflow-library input[aria-label='搜索节点']") value = "条件" }
        expect "condition-result" { visible = css(".a3s-doc-workflow-library__list button[data-node-tone=cyan]") }
        focus "focus-condition-result" { target = css(".a3s-doc-workflow-library__list button[data-node-tone=cyan]") }
        press "select-condition" { key = "Enter" }
        wait "condition-selected" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.condition'][data-selected=true]") }
        expect "condition-panel-matched" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition']") }
        expect "library-closed-after-selection" { visible = css(".a3s-doc-workflow-studio[data-palette-open=false]") }

        fill "edit-node-field" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") value = "input.riskApproved" }
        type "synchronize-edit-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") value = "x" }
        focus "focus-edit-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") }
        press "remove-edit-sentinel" { key = "Backspace" }
        expect "edited-value-visible" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") value = "input.riskApproved" }
        focus "focus-apply-edit" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-actions button[data-variant=primary]") }
        expect "edited-draft-preserved" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") value = "input.riskApproved" }
        press "apply-valid-edit" { key = "Enter" }
        expect "edit-applied" { text = "已应用「条件分支」配置。" }

        fill "enter-invalid-value" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") value = "" }
        type "synchronize-invalid-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") value = "x" }
        focus "focus-invalid-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") }
        press "remove-invalid-sentinel" { key = "Backspace" }
        focus "focus-apply-invalid" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-actions button[data-variant=primary]") }
        expect "invalid-draft-preserved" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] input[aria-label='要判断的字段']") value = "" }
        press "reject-invalid-value" { key = "Enter" }
        wait "invalid-state-visible" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression][data-invalid=true]:has(:focus)") }
        expect "invalid-message-visible" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] .a3s-form-error[role=alert]") }
        screenshot "capture-invalid" { path = "workflow/contracts/workflow-dag-embedding-invalid.png" }

        focus "focus-reset" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-workflow-node-panel-header button[aria-label='恢复默认值']") }
        press "request-reset" { key = "Enter" }
        expect "reset-confirmation" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-workflow-node-panel-header button[aria-label='再次点击确认恢复']:focus") }
        press "confirm-reset" { key = "Enter" }
        wait "default-restored" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] .a3s-form-flow-expression[data-mode=compare] input[aria-label='要判断的字段'][value='input.approved']") }
        expect "validation-cleared" { valid = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] .a3s-form-flow-expression") }
        expect "reset-announced" { text = "已恢复「条件分支」默认配置。" }

        focus "focus-close-panel" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-workflow-node-panel-header button[aria-label='关闭面板']") }
        press "close-panel" { key = "Enter" }
        wait "panel-closed" { visible = css(".a3s-doc-workflow-studio[data-panel-open=false]") }
        wait "node-focus-restored" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.condition'] > .a3s-form-workflow-node-preview-select:focus") }
        press "reopen-panel" { key = "Enter" }
        wait "panel-reopened" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition']") }
        expect "recovered-context-preserved" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-field[data-a3s-form-path=expression] .a3s-form-flow-expression[data-mode=compare] input[aria-label='要判断的字段'][value='input.approved']") }

        focus "focus-run-node" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-workflow-node-panel-header button[aria-label='运行节点']") }
        press "run-node" { key = "Enter" }
        wait "running-state" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.condition'][data-status=running]") }
        wait "successful-state" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.condition'][data-status=success]") }
        focus "focus-last-run" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-form-workflow-node-tabs > button:nth-child(2)") }
        press "show-last-run" { key = "Enter" }
        expect "successful-result" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-doc-workflow-run-result[data-status=success]") }
        screenshot "capture-desktop" { path = "workflow/contracts/workflow-dag-embedding-desktop.png" }

        viewport "compact" { width = 390 height = 844 }
        expect "compact-surface" { visible = css(".a3s-doc-workflow-studio[data-panel-open=true]") }
        expect "compact-panel" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition']") }
        expect "compact-result" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.condition'] .a3s-doc-workflow-run-result[data-status=success]") }
        screenshot "capture-compact" { path = "workflow/contracts/workflow-dag-embedding-compact.png" }
        accessibility "tree" { path = "workflow/contracts/workflow-dag-embedding-accessibility.json" interactive = true }
        console "console" { path = "workflow/contracts/workflow-dag-embedding-console.json" clear = false }
        page_errors "errors" { path = "workflow/contracts/workflow-dag-embedding-errors.json" clear = false }
    }

    scenario "workflow-node-start" {
        name = "Workflow Start proves node-specific edit, rejection, recovery, disclosure, and run behavior"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/components/form-system/a3s-flow/start.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "surface-ready" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.start']") }
        expect "configuration-panel" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start']") }

        fill "edit-node-field" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") value = "records.audit" }
        type "synchronize-edit-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") value = "x" }
        focus "focus-edit-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") }
        press "remove-edit-sentinel" { key = "Backspace" }
        expect "edited-value-visible" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") value = "records.audit" }
        focus "focus-apply-edit" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-actions button[data-variant=primary]") }
        expect "edited-draft-preserved" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") value = "records.audit" }
        press "apply-valid-edit" { key = "Enter" }
        expect "edit-applied" { text = "已应用「工作流开始」配置。" }

        fill "enter-invalid-value" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") value = "" }
        type "synchronize-invalid-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") value = "x" }
        focus "focus-invalid-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") }
        press "remove-invalid-sentinel" { key = "Backspace" }
        focus "focus-apply-invalid" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-actions button[data-variant=primary]") }
        expect "invalid-draft-preserved" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") value = "" }
        press "reject-invalid-value" { key = "Enter" }
        wait "invalid-state-visible" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name][data-invalid=true]:has(input[aria-invalid=true]:focus)") }
        expect "invalid-message-visible" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] .a3s-form-error[role=alert]") }
        screenshot "capture-invalid" { path = "workflow/contracts/workflow-start-invalid.png" }

        focus "focus-reset" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-workflow-node-panel-header button[aria-label='恢复默认值']") }
        press "request-reset" { key = "Enter" }
        expect "reset-confirmation" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-workflow-node-panel-header button[aria-label='再次点击确认恢复']:focus") }
        press "confirm-reset" { key = "Enter" }
        wait "default-restored" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input[value='workflow.main']") }
        expect "validation-cleared" { valid = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input") }
        expect "reset-announced" { text = "已恢复「工作流开始」默认配置。" }

        focus "focus-close-panel" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-workflow-node-panel-header button[aria-label='关闭面板']") }
        press "close-panel" { key = "Enter" }
        wait "panel-closed" { visible = css(".a3s-doc-workflow-studio[data-panel-open=false]") }
        wait "node-focus-restored" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.start'] > .a3s-form-workflow-node-preview-select:focus") }
        press "reopen-panel" { key = "Enter" }
        wait "panel-reopened" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start']") }
        expect "recovered-context-preserved" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-field[data-a3s-form-path=workflow_name] input[value='workflow.main']") }

        focus "focus-run-node" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-workflow-node-panel-header button[aria-label='运行节点']") }
        press "run-node" { key = "Enter" }
        wait "running-state" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.start'][data-status=running]") }
        wait "successful-state" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.start'][data-status=success]") }
        focus "focus-last-run" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-form-workflow-node-tabs > button:nth-child(2)") }
        press "show-last-run" { key = "Enter" }
        expect "successful-result" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-doc-workflow-run-result[data-status=success]") }
        screenshot "capture-desktop" { path = "workflow/contracts/workflow-start-desktop.png" }

        viewport "compact" { width = 390 height = 844 }
        expect "compact-surface" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.start']") }
        expect "compact-panel" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start']") }
        expect "compact-result" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.start'] .a3s-doc-workflow-run-result[data-status=success]") }
        screenshot "capture-compact" { path = "workflow/contracts/workflow-start-compact.png" }
        accessibility "tree" { path = "workflow/contracts/workflow-start-accessibility.json" interactive = true }
        console "console" { path = "workflow/contracts/workflow-start-console.json" clear = false }
        page_errors "errors" { path = "workflow/contracts/workflow-start-errors.json" clear = false }
    }

    scenario "workflow-node-step" {
        name = "Run Step proves node-specific edit, rejection, recovery, disclosure, and run behavior"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/components/form-system/a3s-flow/step.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "surface-ready" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.step']") }
        expect "configuration-panel" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step']") }

        fill "edit-node-field" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") value = "records.audit" }
        type "synchronize-edit-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") value = "x" }
        focus "focus-edit-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") }
        press "remove-edit-sentinel" { key = "Backspace" }
        expect "edited-value-visible" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") value = "records.audit" }
        focus "focus-apply-edit" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-actions button[data-variant=primary]") }
        expect "edited-draft-preserved" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") value = "records.audit" }
        press "apply-valid-edit" { key = "Enter" }
        expect "edit-applied" { text = "已应用「执行步骤」配置。" }

        fill "enter-invalid-value" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") value = "" }
        type "synchronize-invalid-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") value = "x" }
        focus "focus-invalid-input" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") }
        press "remove-invalid-sentinel" { key = "Backspace" }
        focus "focus-apply-invalid" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-actions button[data-variant=primary]") }
        expect "invalid-draft-preserved" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") value = "" }
        press "reject-invalid-value" { key = "Enter" }
        wait "invalid-state-visible" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name][data-invalid=true]:has(input[aria-invalid=true]:focus)") }
        expect "invalid-message-visible" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] .a3s-form-error[role=alert]") }
        screenshot "capture-invalid" { path = "workflow/contracts/workflow-step-invalid.png" }

        focus "focus-reset" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-workflow-node-panel-header button[aria-label='恢复默认值']") }
        press "request-reset" { key = "Enter" }
        expect "reset-confirmation" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-workflow-node-panel-header button[aria-label='再次点击确认恢复']:focus") }
        press "confirm-reset" { key = "Enter" }
        wait "default-restored" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input[value='task.run']") }
        expect "validation-cleared" { valid = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input") }
        expect "reset-announced" { text = "已恢复「执行步骤」默认配置。" }

        focus "focus-close-panel" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-workflow-node-panel-header button[aria-label='关闭面板']") }
        press "close-panel" { key = "Enter" }
        wait "panel-closed" { visible = css(".a3s-doc-workflow-studio[data-panel-open=false]") }
        wait "node-focus-restored" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.step'] > .a3s-form-workflow-node-preview-select:focus") }
        press "reopen-panel" { key = "Enter" }
        wait "panel-reopened" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step']") }
        expect "recovered-context-preserved" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-field[data-a3s-form-path=step_name] input[value='task.run']") }

        focus "focus-run-node" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-workflow-node-panel-header button[aria-label='运行节点']") }
        press "run-node" { key = "Enter" }
        wait "running-state" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.step'][data-status=running]") }
        wait "successful-state" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.step'][data-status=success]") }
        focus "focus-last-run" { target = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-form-workflow-node-tabs > button:nth-child(2)") }
        press "show-last-run" { key = "Enter" }
        expect "successful-result" { visible = css(".a3s-form-flow-node-panel[data-node-type='flow.step'] .a3s-doc-workflow-run-result[data-status=success]") }
        screenshot "capture-desktop" { path = "workflow/contracts/workflow-step-desktop.png" }

        viewport "compact" { width = 390 height = 844 }
        expect "compact-surface" { visible = css(".a3s-form-workflow-node-preview[data-node-type='flow.step']") }
