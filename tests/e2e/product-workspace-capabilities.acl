suite "a3s-ui-product-workspace-capabilities" {
    version = 1

    scenario "sidebar-control-semantics" {
        name = "Every sidebar icon communicates and performs the action named by its control"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-playground" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        wait "navigation-ready" { visible = css(".product-sidebar__footer") }

        expect "notification-icon-matches-control" { visible = css("[data-product-control=notifications] svg[data-icon=notification]") }
        click "open-notifications" { target = css("[data-product-control=notifications]") }
        expect "notification-result" { visible = css(".product-sidebar__notifications[aria-label='消息中心']") }
        press "close-notifications" { key = "Escape" }
        expect "notification-focus-restored" { visible = css("[data-product-control=notifications]:focus") }

        expect "settings-icon-matches-control" { visible = css("[data-product-control=settings] svg[data-icon=settings]") }
        click "open-settings" { target = css("[data-product-control=settings]") }
        expect "settings-result" { visible = css(".product-settings[open] aside button[aria-current=page]") }
        expect "system-section-open" { text = "系统设置" }
        screenshot "sidebar-controls" { path = "product/sidebar-control-semantics.png" }
        click "close-settings" { target = role("button", "关闭设置") }

        console "console" { path = "product/sidebar-control-semantics-console.json" clear = false }
        page_errors "page-errors" { path = "product/sidebar-control-semantics-page-errors.json" clear = false }
    }

    scenario "all-file-workbenches" {
        name = "Every admitted A3S file type opens in a task-appropriate workbench"
        surface = "web"
        timeout_ms = 120000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-files" { url = "http://127.0.0.1:4178/UI/playground/resources/files.html" }
        wait "loaded" { load = "networkidle" }
        click "open-workspace" { target = role("tab", "工作区") }
        wait "files-ready" { visible = css(".product-file-manager[data-file-manager-initialized=true]") }

        fill "find-code" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "release-readiness.md" }
        click "select-code" { target = css(".product-file-manager [data-file-manager-item]") }
        press "quick-look-code" { key = "Enter" }
        click "open-code" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }
        expect "code-workbench" { visible = css(".product-file-workbench[data-workbench-kind=code] .product-code-workbench") }
        click "preview-markdown" { target = role("button", "预览文件") }
        expect "markdown-preview" { visible = css(".product-code-workbench [data-markdown-preview]") }
        click "back-from-code" { target = css("[data-file-workbench-back]") }

        fill "find-document" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "experience-brief.docx" }
        click "select-document" { target = css(".product-file-manager [data-file-manager-item]") }
        press "quick-look-document" { key = "Enter" }
        click "open-document" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }
        wait "document-workbench" { visible = css(".product-file-workbench[data-workbench-kind=document] .work-document-editor") }
        click "document-review" { target = role("tab", "审阅") }
        expect "document-review-toolbar" { text = "修订" }
        click "back-from-document" { target = css("[data-file-workbench-back]") }

        fill "find-spreadsheet" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "quality-scorecard.xlsx" }
        click "select-spreadsheet" { target = css(".product-file-manager [data-file-manager-item]") }
        press "quick-look-spreadsheet" { key = "Enter" }
        click "open-spreadsheet" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }
        wait "spreadsheet-workbench" { visible = css(".product-file-workbench[data-workbench-kind=spreadsheet] .work-spreadsheet-editor") }
        click "spreadsheet-data" { target = role("tab", "数据") }
        expect "spreadsheet-data-toolbar" { text = "自动筛选" }
        click "back-from-spreadsheet" { target = css("[data-file-workbench-back]") }

        fill "find-presentation" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "release-review.pptx" }
        click "select-presentation" { target = css(".product-file-manager [data-file-manager-item]") }
        press "quick-look-presentation" { key = "Enter" }
        click "open-presentation" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }
        wait "presentation-workbench" { visible = css(".product-file-workbench[data-workbench-kind=presentation] .work-presentation-editor") }
        click "select-second-slide" { target = css(".work-presentation-editor [data-slide-thumbnail][data-slide-index='1']") }
        expect "second-slide" { text = "用一句可以独立成立的话，说明我们看到了什么。" }
        click "back-from-presentation" { target = css("[data-file-workbench-back]") }

        fill "find-pdf" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "visual-acceptance-report.pdf" }
        click "select-pdf" { target = css(".product-file-manager [data-file-manager-item]") }
        press "quick-look-pdf" { key = "Enter" }
        click "open-pdf" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }
        wait "pdf-workbench" { visible = css(".product-file-workbench[data-workbench-kind=pdf] .work-pdf-viewer") }
        wait "pdf-navigation-ready" { visible = css(".work-pdf-viewer button[aria-label='下一页']:not(:disabled)") }
        expect "pdf-file-header-visible" { visible = css(".product-file-workbench[data-workbench-kind=pdf] > .product-file-workbench__header") }
        expect "pdf-toolbar-visible" { visible = css(".product-file-workbench[data-workbench-kind=pdf] .work-pdf-toolbar") }
        screenshot "pdf-before-assistant" { path = "product/file-pdf-before-assistant-desktop.png" }
        click "next-pdf-page" { target = role("button", "下一页") }
        expect "pdf-page-updated" { visible = css(".work-pdf-viewer button[aria-label='上一页']:not(:disabled)") }
        expect "pdf-at-last-page" { visible = css(".work-pdf-viewer button[aria-label='下一页']:disabled") }
        click "open-file-assistant" { target = role("button", "打开文件助手") }
        expect "file-assistant" { visible = css("[data-file-assistant]") }
        expect "pdf-canvas-visible-with-assistant" { visible = css(".product-file-workbench[data-assistant-open=true] .work-pdf-viewer [role=application]") }
        click "previous-page-with-assistant" { target = css(".product-file-workbench[data-assistant-open=true] .work-pdf-viewer button[aria-label='上一页']:not(:disabled)") }
        expect "pdf-remains-interactive-with-assistant" { visible = css(".work-pdf-viewer button[aria-label='下一页']:not(:disabled)") }
        screenshot "pdf-with-assistant" { path = "product/file-pdf-with-assistant-desktop.png" }
        click "close-file-assistant" { target = css(".product-file-workbench__header button[aria-label='关闭文件助手']") }
        expect "pdf-canvas-visible-after-assistant" { visible = css(".product-file-workbench:not([data-assistant-open]) .work-pdf-viewer [role=application]") }

        screenshot "desktop-evidence" { path = "product/file-workbenches-desktop.png" }
        console "console" { path = "product/file-workbenches-console.json" clear = false }
        page_errors "page-errors" { path = "product/file-workbenches-page-errors.json" clear = false }
    }

    scenario "workspace-file-intake-and-code-roundtrip" {
        name = "Imported files remain available through task context, workspace references, and the code workbench"
        surface = "web"
        timeout_ms = 120000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-composer" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        wait "composer-ready" { visible = css(".product-start .product-composer[data-state=ready]") }

        upload "import-text-file" {
            target = css(".product-start [data-composer-attachment] > input[type=file]")
            paths = ["tests/fixtures/workspace-drop-note.txt"]
        }
        wait "file-attached-to-task" { visible = css(".product-start [data-composer-resources] [data-resource-id^='workspace:']") }
        expect "imported-name-visible" { text = "workspace-drop-note.txt" }

        type "open-at-picker" { target = css(".product-start [role=textbox][aria-label='任务指令']") value = "@" }
        expect "at-picker-open" { visible = css("[data-composer-suggestions][aria-label='工作区文件'] [role=tree]") }
        expect "imported-session-group" { visible = css("[data-composer-suggestions] [role=treeitem][aria-expanded=true]:first-child") }
        expect "imported-file-in-at-picker" { visible = css("[data-composer-suggestions] [role=treeitem]:nth-child(2)") }
        press "close-at-picker" { key = "Escape" }

        click "open-more" { target = css(".product-sidebar__more > summary") }
        click "open-files" { target = css(".product-sidebar__more a[href$='/playground/resources/files.html']") }
        wait "files-route" { url = "http://127.0.0.1:4178/UI/playground/resources/files.html" }
        click "open-workspace" { target = role("tab", "工作区") }
        fill "find-imported-file" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "workspace-drop-note.txt" }
        expect "imported-workspace-entry" { visible = css(".product-file-manager [data-file-manager-item] strong[title='workspace-drop-note.txt']") }
        click "select-imported-file" { target = css(".product-file-manager [data-file-manager-item]") }
        press "quick-look-imported-file" { key = "Enter" }
        click "open-code-workbench" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }

        wait "real-file-loaded" { visible = css(".product-code-workbench[data-code-load-state=ready]") }
        expect "clean-on-open" { visible = css(".product-code-workbench [data-code-tabs] button:not([data-dirty])") }
        click "preview-real-file" { target = role("button", "预览文件") }
        expect "real-file-content" { text = "Workspace intake verification" }

        click "edit-real-file" { target = role("button", "编辑文件") }
        type "edit-real-file-content" {
            target = css(".product-code-workbench textarea[aria-label='编辑 workspace-drop-note.txt']")
            value = "\n\nSaved content survives reopening."
        }
        expect "dirty-after-edit" { visible = css(".product-code-workbench [data-code-tabs] button[data-dirty=true]") }
        click "save-real-file" { target = role("button", "保存文件") }
        expect "clean-after-save" { visible = css(".product-code-workbench [data-code-tabs] button:not([data-dirty])") }
        click "back-to-files" { target = css("[data-file-workbench-back]") }
        click "reopen-code-workbench" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }
        wait "saved-file-reloaded" { visible = css(".product-code-workbench[data-code-load-state=ready]") }
        click "preview-saved-file" { target = role("button", "预览文件") }
        expect "saved-content-preserved" { text = "Saved content survives reopening." }

        screenshot "desktop-evidence" { path = "product/workspace-code-roundtrip-desktop.png" }
        console "console" { path = "product/workspace-code-roundtrip-console.json" clear = false }
        page_errors "page-errors" { path = "product/workspace-code-roundtrip-page-errors.json" clear = false }
    }

    scenario "file-workbench-mobile" {
        name = "The code workbench and file assistant remain usable on a phone viewport"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open-files" { url = "http://127.0.0.1:4178/UI/playground/resources/files.html" }
        wait "loaded" { load = "networkidle" }
        click "open-workspace" { target = role("tab", "工作区") }
        wait "files-ready" { visible = css(".product-file-manager[data-file-manager-initialized=true]") }
        fill "find-code" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "release-readiness.md" }
        click "select-code" { target = css(".product-file-manager [data-file-manager-item]") }
        press "quick-look-code" { key = "Enter" }
        click "open-code" { target = css("[data-file-manager-quicklook] footer button[data-primary]") }

        wait "code-workbench" { visible = css(".product-file-workbench[data-workbench-kind=code] .product-code-workbench") }
        expect "mobile-file-header" { visible = css(".product-file-workbench__header") }
        expect "mobile-code-toolbar" { visible = css(".product-code-workbench [data-code-toolbar]") }
        click "preview-code" { target = role("button", "预览文件") }
        expect "mobile-code-preview" { visible = css(".product-code-workbench [data-markdown-preview]") }
        click "open-file-assistant" { target = role("button", "打开文件助手") }
        expect "mobile-file-assistant" { visible = css(".product-file-workbench[data-assistant-open=true] [data-file-assistant]") }
        expect "mobile-assistant-input-visible" { visible = css("[data-file-assistant] textarea:focus") }
        fill "ask-about-file" { target = css("[data-file-assistant] textarea") value = "检查当前文件的发布风险" }
        expect "mobile-assistant-send-visible" { visible = css("[data-file-assistant] form > button:not(:disabled)") }

        screenshot "mobile-evidence" { path = "product/file-workbench-mobile.png" }
        press "close-assistant" { key = "Escape" }
        expect "assistant-closed" { visible = css(".product-file-workbench:not([data-assistant-open])") }
        expect "assistant-trigger-restored" { visible = css(".product-file-workbench__header button[aria-label='打开文件助手']:focus") }
        console "console" { path = "product/file-workbench-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/file-workbench-mobile-page-errors.json" clear = false }
    }

    scenario "memory-evolution-workflow" {
        name = "Memory supports traceable review, reversible removal, and task reuse"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-memory" { url = "http://127.0.0.1:4178/UI/playground/memory.html" }
        wait "loaded" { load = "networkidle" }
        wait "memory-ready" { visible = css("[data-product-surface=memory]") }
        expect "timeline-default" { visible = css(".product-memory > nav button[role=tab][aria-selected=true][tabindex='0'][aria-controls$='timeline-panel']") }
        expect "timeline-panel-labelled" { visible = css(".product-memory [role=tabpanel][aria-labelledby$='timeline-tab'] .product-memory__timeline") }

        click "open-memory-settings" { target = role("button", "管理记忆设置") }
        expect "memory-settings-open" { visible = css(".product-settings[open] aside button[aria-current=page]") }
        expect "memory-settings-title" { text = "记忆" }
        click "close-memory-settings" { target = role("button", "关闭设置") }

        focus "focus-timeline-tab" { target = css(".product-memory > nav button[aria-controls$='timeline-panel']") }
        press "next-tab" { key = "ArrowRight" }
        expect "graph-tab-focused" { visible = css(".product-memory > nav button[aria-controls$='graph-panel'][aria-selected=true]:focus") }
        expect "graph-canvas" { visible = css(".product-memory__graph [data-memory-graph-viewport]") }
        click "zoom-graph" { target = role("button", "放大") }
        expect "graph-zoom-updated" { text = "120%" }
        screenshot "graph-evidence" { path = "product/memory-graph-desktop.png" }

        click "open-evolution" { target = css(".product-memory > nav button[aria-controls$='evolution-panel']") }
        expect "pending-count-before-review" { visible = css("[data-memory-pending-count='2']") }
        expect "pending-candidate" { visible = css(".product-memory__evolution article[data-state=pending]") }
        click "accept-candidate" { target = css("[data-memory-candidate-id=terminology] button[data-primary]") }
        expect "candidate-accepted" { visible = css("[data-memory-candidate-id=terminology][data-state=accepted]") }
        expect "pending-count-after-review" { visible = css("[data-memory-pending-count='1']") }
        expect "accepted-record-created" { visible = css(".product-memory[data-memory-record-count='6']") }
        screenshot "evolution-evidence" { path = "product/memory-evolution-desktop.png" }

        click "return-to-timeline" { target = role("tab", "时间线") }
        expect "accepted-memory-visible" { visible = css(".product-memory__timeline [data-memory-id='evolution-terminology']") }
        click "inspect-accepted-memory" { target = css(".product-memory__timeline [data-memory-id='evolution-terminology'] > button") }
        expect "accepted-memory-inspector" { text = "统一使用“工作空间”术语" }

        click "open-source-evidence" { target = role("button", "查看来源") }
        expect "source-evidence-visible" { visible = css(".product-memory__inspector [data-memory-source-detail]") }
        expect "source-locator-visible" { text = "memory/evolution/terminology" }
        press "close-source-with-escape" { key = "Escape" }
        expect "source-trigger-restored" { visible = css(".product-memory__inspector button[aria-expanded=false]:focus") }

        click "request-removal" { target = role("button", "请求遗忘") }
        expect "removal-confirmation" { text = "请求遗忘这条记忆？" }
        click "confirm-removal" { target = role("button", "确认请求") }
        expect "removal-pending" { visible = css(".product-memory__inspector[data-removal=pending] button[data-primary]:disabled") }
        screenshot "removal-evidence" { path = "product/memory-removal-desktop.png" }
        click "undo-removal" { target = role("button", "撤销遗忘") }
        expect "removal-restored" { visible = css(".product-memory__inspector:not([data-removal]) button[data-primary]:not(:disabled)") }

        click "review-evolution-again" { target = css(".product-memory > nav button[aria-controls$='evolution-panel']") }
        click "reopen-candidate-review" { target = css("[data-memory-candidate-id=terminology] footer button") }
        expect "candidate-reopened" { visible = css("[data-memory-candidate-id=terminology][data-state=pending]") }
        expect "generated-record-removed" { visible = css(".product-memory[data-memory-record-count='5']") }
        expect "pending-count-restored" { visible = css("[data-memory-pending-count='2']") }

        click "return-to-seed-memory" { target = role("tab", "时间线") }
        click "inspect-seed-memory" { target = css(".product-memory__timeline [data-memory-id=visual-evidence] > button") }
        click "use-memory-in-task" { target = role("button", "用于新任务") }
        wait "task-composer-route" { url = "http://127.0.0.1:4178/UI/playground.html" }
        expect "memory-resource-preserved" { visible = css(".product-start [data-composer-resources] [data-resource-id='memory:visual-evidence']") }
        expect "memory-prompt-preserved" { text = "发布前必须保留视觉验收证据" }
        click "create-memory-task" { target = role("button", "发送任务") }
        wait "memory-task-created" { url = "http://127.0.0.1:4178/UI/playground/sessions/current.html" }
        expect "memory-task-context" { text = "发布前必须保留视觉验收证据" }

        navigate "return-to-clean-composer" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "clean-composer-ready" { visible = css(".product-start .product-composer[data-state=ready]") }
        expect "pending-memory-draft-cleared" { visible = css(".product-start button[aria-label='发送任务']:disabled") }

        console "console" { path = "product/memory-evolution-console.json" clear = false }
        page_errors "page-errors" { path = "product/memory-evolution-page-errors.json" clear = false }
    }

    scenario "memory-inspector-mobile" {
        name = "Memory details remain complete and keyboard-safe in compact layouts"
        surface = "web"
        timeout_ms = 60000
        viewport "compact" { width = 1024 height = 800 }

        navigate "open-memory" { url = "http://127.0.0.1:4178/UI/playground/memory.html" }
        wait "loaded" { load = "networkidle" }
        wait "memory-ready" { visible = css("[data-product-surface=memory]") }

        click "open-memory-detail" { target = css(".product-memory__timeline [data-memory-id=visual-evidence] > button") }
        expect "detail-drawer-visible" { visible = css(".product-memory__inspector[role=dialog][data-open=true]") }
        expect "close-focused" { visible = css(".product-memory__inspector [data-memory-inspector-close]:focus") }
        screenshot "compact-drawer" { path = "product/memory-inspector-compact.png" }
        press "close-compact-drawer" { key = "Escape" }
        expect "compact-record-focus-restored" { visible = css(".product-memory__timeline [data-memory-id=visual-evidence] > button:focus") }

        viewport "phone" { width = 390 height = 844 }
        click "reopen-memory-detail" { target = css(".product-memory__timeline [data-memory-id=visual-evidence] > button") }
        expect "phone-detail-visible" { visible = css(".product-memory__inspector[role=dialog][data-open=true]") }

        click "open-source" { target = role("button", "查看来源") }
        expect "source-visible" { visible = css(".product-memory__inspector [data-memory-source-detail]:focus") }
        screenshot "mobile-drawer" { path = "product/memory-inspector-mobile.png" }

        press "close-source" { key = "Escape" }
        expect "source-focus-restored" { visible = css(".product-memory__inspector button[aria-expanded=false]:focus") }
        press "close-drawer" { key = "Escape" }
        expect "record-focus-restored" { visible = css(".product-memory__timeline [data-memory-id=visual-evidence] > button:focus") }

        console "console" { path = "product/memory-inspector-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/memory-inspector-mobile-page-errors.json" clear = false }
    }

    scenario "extension-host-boundary" {
        name = "Installed extensions open in an isolated host and require review before contributing context"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-extensions" { url = "http://127.0.0.1:4178/UI/playground/extensions.html" }
        wait "loaded" { load = "networkidle" }
        wait "marketplace-ready" { visible = css("[data-product-surface=marketplace]") }
        expect "permissions-visible" { text = "请求的权限" }
        click "open-extension" { target = role("button", "打开扩展") }
        expect "isolated-host" { visible = css("[data-product-surface=extension-host]") }
        click "reload-host" { target = role("button", "重新加载扩展宿主") }
        expect "host-reloading" { visible = css("[data-product-surface=extension-host][data-reload-state=reloading]") }
        wait "host-ready-again" { visible = css("[data-product-surface=extension-host][data-reload-state=ready][data-reload-count='1']") }
        expect "reload-feedback" { text = "扩展宿主已重新加载" }
        expect "proposal-pending" { visible = css(".product-extension-host__proposal[data-state=pending]") }
        screenshot "isolated-host-evidence" { path = "product/extension-isolated-host-desktop.png" }
        click "accept-proposal" { target = role("button", "添加到当前任务") }
        expect "proposal-accepted" { visible = css(".product-extension-host__proposal[data-state=accepted]") }
        click "back-to-marketplace" { target = role("button", "返回扩展市场") }
        click "open-sources" { target = role("tab", "来源") }
        expect "sources-table" { visible = css("[role=table][aria-label='扩展来源']") }

        screenshot "desktop-evidence" { path = "product/extension-host-desktop.png" }
        console "console" { path = "product/extension-host-console.json" clear = false }
        page_errors "page-errors" { path = "product/extension-host-page-errors.json" clear = false }
    }

    scenario "extension-install-lifecycle" {
        name = "Installing requires permission review, persists across reload, and uninstalling explains its consequences"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-extensions" { url = "http://127.0.0.1:4178/UI/playground/extensions.html" }
        wait "loaded" { load = "networkidle" }
        wait "marketplace-ready" { visible = css("[data-product-surface=marketplace][data-hydrated=true]") }

        click "review-uninstalled-extension" { target = css("[data-extension-id=dependency-watch] [data-extension-review]") }
        expect "permission-review-visible" { visible = css(".product-marketplace__detail [data-extension-permissions]") }
        expect "not-installed" { visible = css(".product-marketplace__detail dd[data-installed=false]") }
        click "confirm-install" { target = role("button", "确认并安装") }
        expect "installing-state" { visible = css(".product-marketplace__detail button[aria-busy=true]:disabled") }
        wait "installed-state" { visible = css("[data-extension-id=dependency-watch][data-installed=true]") }
        expect "install-feedback" { text = "依赖巡检 已安装" }

        navigate "reload-extensions" { url = "http://127.0.0.1:4178/UI/playground/extensions.html" }
        wait "reloaded" { load = "networkidle" }
        wait "restored-install" { visible = css("[data-product-surface=marketplace][data-hydrated=true] [data-extension-id=dependency-watch][data-installed=true]") }

        click "review-installed-extension" { target = css("[data-extension-id=dependency-watch] [data-extension-review]") }
        click "request-uninstall" { target = role("button", "卸载") }
        expect "uninstall-consequences" { text = "已经生成的任务内容和证据不会被删除" }
        click "cancel-uninstall" { target = role("button", "取消") }
        expect "uninstall-focus-restored" { visible = css(".product-marketplace__detail button[data-danger]:focus") }
        click "request-uninstall-again" { target = role("button", "卸载") }
        click "confirm-uninstall" { target = role("button", "确认卸载") }
        expect "uninstalled-state" { visible = css("[data-extension-id=dependency-watch][data-installed=false]") }
        expect "uninstall-feedback" { text = "已有任务内容保持不变" }

        select "sort-by-updated" {
            target = css("select[aria-label='扩展排序']")
            values = ["updated"]
        }
        expect "real-updated-order" { visible = css(".product-marketplace__directory article:first-child[data-extension-id=dependency-watch]") }

        screenshot "install-lifecycle" { path = "product/extension-install-lifecycle.png" }
        console "console" { path = "product/extension-install-lifecycle-console.json" clear = false }
        page_errors "page-errors" { path = "product/extension-install-lifecycle-page-errors.json" clear = false }
    }

    scenario "extension-detail-mobile" {
        name = "Phone users can review permissions, install actions, and return focus from extension details"
        surface = "web"
        timeout_ms = 60000
        viewport "phone" { width = 390 height = 844 }

        navigate "open-extensions" { url = "http://127.0.0.1:4178/UI/playground/extensions.html" }
        wait "loaded" { load = "networkidle" }
        wait "marketplace-ready" { visible = css("[data-product-surface=marketplace][data-hydrated=true]") }
        click "open-mobile-detail" { target = css("[data-extension-id=dependency-watch] [data-extension-review]") }
        expect "mobile-detail-visible" { visible = css("[data-extension-detail-dialog][open]") }
        expect "mobile-permissions-visible" { visible = css("[data-extension-detail-dialog] [data-extension-permissions]") }
        expect "mobile-close-focused" { visible = css("[data-extension-detail-dialog] [data-extension-detail-close]:focus") }
        screenshot "mobile-detail" { path = "product/extension-detail-mobile.png" }
        press "close-mobile-detail" { key = "Escape" }
        expect "mobile-card-focus-restored" { visible = css("[data-extension-id=dependency-watch] [data-extension-review]:focus") }

        console "console" { path = "product/extension-detail-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/extension-detail-mobile-page-errors.json" clear = false }
    }

    scenario "extension-marketplace-dark-english" {
        name = "Extension controls preserve their meaning in English and dark appearance"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-english-extensions" { url = "http://127.0.0.1:4178/UI/en/playground/extensions.html" }
        wait "loaded" { load = "networkidle" }
        wait "marketplace-ready" { visible = css("[data-product-surface=marketplace][data-hydrated=true]") }
        click "open-account-menu" { target = css(".product-sidebar__footer > button:first-child") }
        click "enable-dark-appearance" { target = role("menuitemcheckbox", "Dark appearance") }
        expect "dark-appearance-active" { visible = css("html.dark [data-product-surface=marketplace]") }
        click "review-extension" { target = css("[data-extension-id=dependency-watch] [data-extension-review]") }
        expect "english-permissions" { text = "Requested permissions" }
        expect "english-install-action" { visible = css(".product-marketplace__detail button[data-primary]") }
        screenshot "dark-english" { path = "product/extension-marketplace-dark-english.png" }

        console "console" { path = "product/extension-marketplace-dark-english-console.json" clear = false }
        page_errors "page-errors" { path = "product/extension-marketplace-dark-english-page-errors.json" clear = false }
    }

    scenario "extension-source-management" {
        name = "Source management exposes refresh progress, validation recovery, and static source records"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-extensions" { url = "http://127.0.0.1:4178/UI/playground/extensions.html" }
        wait "loaded" { load = "networkidle" }
        click "open-sources" { target = role("tab", "来源") }
        expect "sources-table" { visible = css("[role=table][aria-label='扩展来源'] [data-source-id=verified]") }

        click "refresh-sources" { target = role("button", "刷新来源") }
        expect "refreshing-sources" { visible = css("button[data-source-refresh-state=refreshing]:disabled") }
        wait "sources-refreshed" { visible = css("button[data-source-refresh-state=ready]:not(:disabled)") }
        expect "refresh-result" { text = "未自动加载新内容" }

        click "open-add-source" { target = role("button", "添加来源") }
        expect "source-name-focused" { visible = css(".product-marketplace__source-dialog[open] input[aria-label='来源名称']:focus") }
        click "submit-empty-source" { target = role("button", "加入待验证清单") }
        expect "required-name-error" { text = "请输入来源名称" }
        fill "source-name" { target = css(".product-marketplace__source-dialog input[aria-label='来源名称']") value = "Design registry" }
        fill "invalid-source-address" { target = css(".product-marketplace__source-dialog input[aria-label='来源地址']") value = "http://extensions.example.com" }
        press "submit-insecure-source" { key = "Enter" }
        expect "https-validation" { text = "远程来源必须使用 HTTPS" }
        fill "valid-source-address" { target = css(".product-marketplace__source-dialog input[aria-label='来源地址']") value = "https://extensions.example.com" }
        press "submit-valid-source" { key = "Enter" }
        expect "source-added" { visible = css("[data-source-count='3'] [data-source-id='custom-3'] [data-trust=pending]") }
        expect "source-safety-feedback" { text = "身份验证完成前不会加载可执行内容" }

        screenshot "source-management" { path = "product/extension-source-management.png" }
        console "console" { path = "product/extension-source-management-console.json" clear = false }
        page_errors "page-errors" { path = "product/extension-source-management-page-errors.json" clear = false }
    }

    scenario "automation-run-recovery" {
        name = "Automation history exposes inputs, outputs, failed steps, and bounded retry"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open-automations" { url = "http://127.0.0.1:4178/UI/playground/automations.html" }
        wait "loaded" { load = "networkidle" }
        wait "automation-ready" { visible = css("[data-product-surface=automation]") }
        click "open-history" { target = css("[data-product-surface=automation] [role=tab][aria-controls$='history-panel']") }
        expect "history-ready" { visible = css(".product-run-history[aria-label='运行记录']") }
        click "filter-failed" { target = role("button", "失败") }
        expect "failed-run" { visible = css(".product-run-history__list [role=option] [data-state=failed]") }
        click "select-failed-run" { target = css(".product-run-history__list [role=option]:first-of-type") }
        expect "recovery-action" { visible = css(".product-run-history__detail footer button") }
        click "retry-failed-step" { target = role("button", "从失败步骤重试") }
        expect "retrying" { text = "正在重试" }

        screenshot "desktop-evidence" { path = "product/automation-recovery-desktop.png" }
        console "console" { path = "product/automation-recovery-console.json" clear = false }
        page_errors "page-errors" { path = "product/automation-recovery-page-errors.json" clear = false }
    }
}
