suite "a3s-ui-product-composer-controls" {
    version = 1

    scenario "composer-context-and-run-controls" {
        name = "The production composer attaches every supported context type and preserves run configuration"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        wait "composer-ready" { visible = css(".product-start .product-composer[data-state=ready]") }
        expect "execution-target-control-contract" { visible = css("[data-composer-control=target]") }

        click "open-context-for-file" { target = role("button", "添加任务上下文") }
        click "open-file-menu" { target = role("menuitem", "添加文件") }
        click "choose-workspace-file" { target = css("[data-composer-attachment-submenu=file] [role=menuitem]:nth-child(2)") }
        expect "workspace-tree" { visible = css("[data-composer-suggestions][aria-label='工作区文件'] [role=tree]") }
        screenshot "workspace-picker-evidence" { path = "product/composer-workspace-picker-desktop.png" }
        click "expand-css-folder" { target = css("[data-composer-suggestions] [role=treeitem]:nth-child(2)") }
        click "attach-file" { target = css("[data-composer-suggestions] [role=treeitem]:nth-child(3)") }
        expect "file-chip" { visible = css("[data-composer-resources] [data-resource-kind=file]") }

        click "open-context-for-skill" { target = role("button", "添加任务上下文") }
        click "choose-skill" { target = css("[data-composer-attachment-menu] [role=menuitem]:nth-child(4)") }
        expect "skill-list" { visible = css("[data-composer-suggestions][aria-label='选择技能'] [role=listbox]") }
        click "attach-skill" { target = css("[data-composer-suggestions] [role=option]:first-child") }
        expect "skill-chip" { visible = css("[data-composer-resources] [data-resource-kind=skill]") }

        click "open-context-for-assistant" { target = role("button", "添加任务上下文") }
        click "choose-assistant" { target = css("[data-composer-attachment-menu] [role=menuitem]:nth-child(3)") }
        expect "assistant-picker" { visible = css("[data-composer-resource-picker=assistant][role=dialog]") }
        click "attach-assistant" { target = css("[data-composer-resource-picker=assistant] [role=option][data-configured=true]:first-child") }
        expect "assistant-chip" { visible = css("[data-composer-resources] [data-resource-kind=assistant]") }

        click "open-context-for-connector" { target = role("button", "添加任务上下文") }
        click "choose-connector" { target = css("[data-composer-attachment-menu] [role=menuitem]:nth-child(5)") }
        expect "connector-picker" { visible = css("[data-composer-resource-picker=connector][role=dialog]") }
        click "attach-connector" { target = css("[data-composer-resource-picker=connector] [role=option][data-configured=true]:first-child") }
        expect "connector-chip" { visible = css("[data-composer-resources] [data-resource-kind=connector]") }

        click "open-run-settings" { target = css(".product-start [data-composer-control=run] > button") }
        expect "run-panel" { visible = css(".product-start [data-control-panel=run][role=dialog]") }
        click "enable-research" { target = css(".product-start [data-control-panel=run] [data-run-settings-row] > button") }
        expect "research-enabled" { visible = css(".product-start [data-run-settings-row] button[data-research-active=true][aria-pressed=true]") }

        click "open-effort" { target = css(".product-start [data-run-settings-row] > div > button:first-child") }
        expect "effort-picker" { visible = css(".product-start [data-run-detail=effort]") }
        focus "focus-effort" { target = css(".product-start [data-run-detail=effort] input[type=range]") }
        press "increase-effort" { key = "ArrowRight" }
        expect "effort-updated" { visible = css(".product-start [data-run-detail=effort] input[aria-valuetext='深入']") }
        click "close-effort" { target = role("button", "关闭努力程度") }

        click "open-models" { target = css(".product-start [data-run-settings-row] > div > button:last-child") }
        expect "model-picker" { visible = css(".product-start [data-run-detail=model]") }
        fill "find-default-model" { target = css(".product-start [data-run-detail=model] input[aria-label='搜索模型']") value = "当前默认" }
        click "choose-default-model" { target = css(".product-start [data-run-detail=model] [role=option]:first-child") }
        expect "model-selected" { visible = css(".product-start [data-composer-control=run] > button[aria-label*='当前默认模型']") }

        click "reopen-models" { target = css(".product-start [data-run-settings-row] > div > button:last-child") }
        click "configure-models" { target = role("button", "配置模型与提供方") }
        expect "model-settings-open" { visible = css(".product-settings[open] > aside button[aria-current=page]") }
        expect "model-settings-heading" { text = "管理默认模型、Provider 连接、模型目录和运行参数。凭据由宿主安全保管。" }
        click "close-model-settings" { target = role("button", "关闭设置") }

        click "open-execution-mode" { target = css(".product-start [data-composer-control=mode] > button") }
        click "choose-automatic-mode" { target = css(".product-start [data-mode-options] [role=option]:nth-child(3)") }
        expect "automatic-mode-selected" { visible = css(".product-start [data-composer-control=mode] [data-setting-label]") }

        click "open-workspaces" { target = css(".product-start [data-composer-control=workspace] > button") }
        click "choose-local-workspace" { target = css(".product-start [data-workspace-options] [role=option]:nth-child(2)") }
        expect "workspace-control-selected" { visible = css(".product-start [data-composer-control=workspace]:has(> button [data-workspace-copy] strong)") }
        expect "local-workspace-selected" { text = "本地工作区" }

        upload "upload-file-through-composer" {
            target = css(".product-start .product-composer input[type=file]")
            paths = ["tests/fixtures/workspace-drop-note.txt"]
        }
        expect "uploaded-file-attached" { visible = css(".product-start [data-composer-resources] [data-resource-id^='workspace:'][data-resource-kind=file]:has([data-resource-label])") }
        expect "uploaded-file-name" { text = "workspace-drop-note.txt" }

        click "remove-file" { target = css("[data-composer-resources] [data-resource-kind=file] [data-composer-action=remove-resource]") }
        click "remove-skill" { target = css("[data-composer-resources] [data-resource-kind=skill] [data-composer-action=remove-resource]") }
        click "remove-assistant" { target = css("[data-composer-resources] [data-resource-kind=assistant] [data-composer-action=remove-resource]") }
        click "remove-connector" { target = css("[data-composer-resources] [data-resource-kind=connector] [data-composer-action=remove-resource]") }
        click "remove-uploaded-file" { target = role("button", "移除 workspace-drop-note.txt") }
        expect "composer-remains-ready" { visible = css(".product-start .product-composer[data-state=ready]") }

        screenshot "desktop-evidence" { path = "product/composer-controls-desktop.png" }
        console "console" { path = "product/composer-controls-desktop-console.json" clear = false }
        page_errors "page-errors" { path = "product/composer-controls-desktop-page-errors.json" clear = false }
    }

    scenario "composer-overlays-short-desktop" {
        name = "Tall composer overlays stay fully contained on a short desktop viewport"
        surface = "web"
        timeout_ms = 60000
        viewport "short-desktop" { width = 1024 height = 700 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        wait "composer-ready" { visible = css(".product-start .product-composer[data-state=ready]") }

        click "open-context" { target = role("button", "添加任务上下文") }
        click "open-file-menu" { target = role("menuitem", "添加文件") }
        click "open-workspace-picker" { target = role("menuitem", "工作区文件 @") }
        expect "workspace-picker-positioned" { visible = css(".product-start [data-composer-suggestions][data-a3s-positioned=true]") }
        expect "workspace-picker-contained" {
            target = css(".product-start [data-composer-suggestions]")
            viewport_coverage_at_least = 100
        }
        expect "workspace-heading-contained" {
            target = css(".product-start [data-composer-suggestions] > header")
            viewport_coverage_at_least = 100
        }
        expect "workspace-footer-contained" {
            target = css(".product-start [data-composer-suggestions] > footer")
            viewport_coverage_at_least = 100
        }
        screenshot "short-workspace-evidence" { path = "product/composer-workspace-short-desktop.png" }
        press "close-workspace-picker" { key = "Escape" }

        click "open-context-for-assistant" { target = role("button", "添加任务上下文") }
        click "open-assistant-picker" { target = role("menuitem", "专家") }
        expect "assistant-picker-positioned" { visible = css(".product-start [data-composer-resource-picker=assistant][data-a3s-positioned=true]") }
        expect "assistant-picker-contained" {
            target = css(".product-start [data-composer-resource-picker=assistant]")
            viewport_coverage_at_least = 100
        }
        expect "assistant-picker-header-contained" {
            target = css(".product-start [data-composer-resource-picker=assistant] > header")
            viewport_coverage_at_least = 100
        }
        expect "assistant-picker-footer-contained" {
            target = css(".product-start [data-composer-resource-picker=assistant] > footer")
            viewport_coverage_at_least = 100
        }
        expect "assistant-picker-close-reachable" { pointer_reachable = role("button", "关闭资源选择") }
        press "close-assistant-picker" { key = "Escape" }
        expect "attachment-trigger-restored-after-assistant" { visible = css(".product-start [data-composer-attachment-trigger]:focus") }

        click "open-context-for-connector" { target = role("button", "添加任务上下文") }
        click "open-connector-picker" { target = role("menuitem", "连接器") }
        expect "connector-picker-positioned" { visible = css(".product-start [data-composer-resource-picker=connector][data-a3s-positioned=true]") }
        expect "connector-picker-contained" {
            target = css(".product-start [data-composer-resource-picker=connector]")
            viewport_coverage_at_least = 100
        }
        press "close-connector-picker" { key = "Escape" }
        expect "attachment-trigger-restored-after-connector" { visible = css(".product-start [data-composer-attachment-trigger]:focus") }

        click "open-workspace-control" { target = css(".product-start [data-composer-control=workspace] > button") }
        expect "workspace-control-contained" {
            target = css(".product-start [data-control-panel=workspace]")
            viewport_coverage_at_least = 100
        }
        expect "workspace-control-close-reachable" { pointer_reachable = role("button", "关闭工作区") }
        press "close-workspace-control" { key = "Escape" }
        expect "workspace-trigger-restored" { visible = css(".product-start [data-composer-control=workspace] > button:focus") }

        click "open-permission-control" { target = css(".product-start [data-composer-control=mode] > button") }
        expect "permission-control-contained" {
            target = css(".product-start [data-control-panel=mode]")
            viewport_coverage_at_least = 100
        }
        expect "permission-control-close-reachable" { pointer_reachable = role("button", "关闭权限边界") }
        press "close-permission-control" { key = "Escape" }
        expect "permission-trigger-restored" { visible = css(".product-start [data-composer-control=mode] > button:focus") }

        click "open-run-settings" { target = css(".product-start [data-composer-control=run] > button") }
        click "open-model-picker" { target = css(".product-start [data-run-settings-row] > div > button:last-child") }
        expect "model-picker-positioned" { visible = css(".product-start [data-control-panel=run][data-control-detail=model][data-a3s-positioned=true]") }
        expect "model-picker-contained" {
            target = css(".product-start [data-control-panel=run][data-control-detail=model]")
            viewport_coverage_at_least = 100
        }
        expect "model-heading-contained" {
            target = css(".product-start [data-control-panel=run][data-control-detail=model] > header")
            viewport_coverage_at_least = 100
        }
        expect "model-close-reachable" { pointer_reachable = role("button", "关闭模型选择") }

        screenshot "short-desktop-evidence" { path = "product/composer-controls-short-desktop.png" }
        console "console" { path = "product/composer-controls-short-desktop-console.json" clear = false }
        page_errors "page-errors" { path = "product/composer-controls-short-desktop-page-errors.json" clear = false }
    }

    scenario "composer-overlays-mobile" {
        name = "Composer overlays remain reachable and contained on a phone viewport"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "loaded" { load = "networkidle" }
        wait "composer-ready" { visible = css(".product-start .product-composer[data-state=ready]") }

        click "open-context" { target = role("button", "添加任务上下文") }
        expect "context-menu" { visible = css(".product-start [data-composer-attachment-menu][role=menu]") }
        click "open-skill-picker" { target = role("menuitem", "技能 $") }
        expect "skill-picker-contained" {
            target = css(".product-start [data-composer-suggestions][data-suggestion-kind=skill]")
            viewport_coverage_at_least = 100
        }
        expect "skill-picker-footer-copy" { visible = css(".product-start [data-composer-suggestions][data-suggestion-kind=skill] [data-suggestion-primary-action=add]") }
        screenshot "skill-picker-mobile-evidence" { path = "product/composer-skill-picker-mobile.png" }
        click "close-skill-picker" { target = role("button", "关闭选择技能") }

        click "reopen-context" { target = role("button", "添加任务上下文") }
        click "open-connector-picker" { target = role("menuitem", "连接器") }
        expect "connector-picker" { visible = css(".product-start [data-composer-resource-picker=connector][role=dialog]") }
        expect "connector-picker-contained" {
            target = css(".product-start [data-composer-resource-picker=connector]")
            viewport_coverage_at_least = 100
        }
        press "close-picker" { key = "Escape" }
        expect "trigger-focus-restored" { visible = css(".product-start [data-composer-attachment-trigger]:focus") }

        click "open-run-settings" { target = css(".product-start [data-composer-control=run] > button") }
        expect "run-panel" { visible = css(".product-start [data-control-panel=run][role=dialog]") }

        screenshot "mobile-evidence" { path = "product/composer-controls-mobile.png" }
        console "console" { path = "product/composer-controls-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/composer-controls-mobile-page-errors.json" clear = false }
    }
}
