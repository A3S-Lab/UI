suite "a3s-ui-site-and-overlays" {
    version = 1

    scenario "first-load-responsive-navigation" {
        name = "Responsive navigation works before client hydration"
        surface = "web"
        timeout_ms = 90000

        viewport "responsive" {
            width = 1280
            height = 900
        }

        network_route "block-client-javascript" {
            pattern = "**/*.js"
            abort = true
        }

        navigate "open-component" {
            url = "http://127.0.0.1:4178/UI/components/button.html"
        }

        wait "server-rendered-page" {
            load = "domcontentloaded"
        }

        click "open-primary-navigation" {
            target = role("button", "打开主导航")
        }

        expect "navigation-open" {
            visible = css(".a3s-responsive-navigation[open] .a3s-responsive-navigation__surface")
        }

        click "open-resource-navigation" {
            target = role("button", "资源")
        }

        expect "changelog-destination-visible" {
            visible = css(".a3s-responsive-navigation[open] a[href='https://github.com/A3S-Lab/UI/blob/main/CHANGELOG.md']")
        }

        expect "playground-destination-visible" {
            visible = css(".a3s-responsive-navigation[open] a[href='/UI/playground.html']")
        }

        screenshot "first-load-navigation" {
            path = "documentation/first-load-navigation.png"
        }

        click "open-playground" {
            target = css(".a3s-responsive-navigation[open] a[href='/UI/playground.html']")
        }

        wait "playground-loaded" {
            url = "http://127.0.0.1:4178/UI/playground.html"
        }

        network_unroute "restore-client-javascript" {
            pattern = "**/*.js"
        }
    }

    scenario "first-load-sidebar-navigation" {
        name = "Nested documentation navigation works before client hydration"
        surface = "web"
        timeout_ms = 90000

        viewport "desktop" {
            width = 1440
            height = 900
        }

        network_route "block-client-javascript" {
            pattern = "**/*.js"
            abort = true
        }

        navigate "open-component" {
            url = "http://127.0.0.1:4178/UI/components/button.html"
        }

        wait "server-rendered-page" {
            load = "domcontentloaded"
        }

        click "open-selection-group" {
            target = css("details.a3s-docs-sidebar__group[data-sidebar-group-label='选择与筛选'] > summary")
        }

        expect "selection-link-visible" {
            visible = css("details.a3s-docs-sidebar__group[data-sidebar-group-label='选择与筛选'][open] a[href='/UI/components/select.html']")
        }

        click "open-harness-group" {
            target = css("details.a3s-docs-sidebar__group[data-sidebar-group-label='Harness'] > summary")
        }

        click "open-conversation-group" {
            target = css("details.a3s-docs-sidebar__group[data-sidebar-group-label='会话与消息'] > summary")
        }

        expect "workbench-link-visible" {
            visible = css("details.a3s-docs-sidebar__group[data-sidebar-group-label='会话与消息'][open] a[href='/UI/components/agent-workbench.html']")
        }

        screenshot "first-load-sidebar" {
            path = "documentation/first-load-sidebar.png"
        }

        click "open-workbench" {
            target = css("details.a3s-docs-sidebar__group[data-sidebar-group-label='会话与消息'][open] a[href='/UI/components/agent-workbench.html']")
        }

        wait "workbench-loaded" {
            url = "http://127.0.0.1:4178/UI/components/agent-workbench.html"
        }

        network_unroute "restore-client-javascript" {
            pattern = "**/*.js"
        }
    }

    scenario "homepage-theme-customizer" {
        name = "Homepage theme customizer applies and persists product choices"
        surface = "web"
        timeout_ms = 60000

        navigate "open-homepage" {
            url = "http://127.0.0.1:4178/UI/en/"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        viewport "show-customizer" {
            width = 1280
            height = 1600
        }

        expect "customizer-visible" {
            visible = css("[data-a3s-customizer]")
        }

        focus "choose-violet" {
            target = css("[data-theme-accent=violet]")
        }

        press "confirm-violet" {
            key = "Enter"
        }

        focus "choose-rounded" {
            target = css("[data-theme-radius=rounded]")
        }

        press "confirm-rounded" {
            key = "Enter"
        }

        focus "choose-comfortable" {
            target = css("[data-theme-density=comfortable]")
        }

        press "confirm-comfortable" {
            key = "Enter"
        }

        focus "choose-dark" {
            target = css("[data-theme-appearance=dark]")
        }

        press "confirm-dark" {
            key = "Enter"
        }

        expect "customization-applied" {
            visible = css("html.dark.rp-dark[data-a3s-accent=violet][data-a3s-radius=rounded][data-a3s-density=comfortable]")
        }

        screenshot "customizer-evidence" {
            path = "theme/customizer.png"
        }

        navigate "open-component" {
            url = "http://127.0.0.1:4178/UI/en/components/button.html"
        }

        wait "component-loaded" {
            load = "networkidle"
        }

        wait "component-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        expect "customization-persisted" {
            visible = css("html.dark.rp-dark[data-a3s-accent=violet][data-a3s-radius=rounded][data-a3s-density=comfortable]")
        }
    }

    scenario "component-catalog" {
        name = "Component catalog exposes all documented families"
        surface = "web"
        timeout_ms = 45000

        navigate "open-catalog" {
            url = "http://127.0.0.1:4178/UI/en/components/index.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        expect "catalog-visible" {
            visible = css("[data-component-catalog] .component-catalog__group-section")
        }

        expect "harness-family-visible" {
            visible = css("[data-component-catalog] [data-component-group=harness]")
        }

        fill "search-for-button" {
            target = placeholder("Search by name, slug, or group…")
            value = "button"
        }

        expect "button-result-visible" {
            visible = css("[data-component-catalog] .component-catalog__results a[href$='/components/button.html']")
        }
    }

    scenario "component-preview-tooling" {
        name = "Component previews expose source, viewport, theme, and direction controls"
        surface = "web"
        timeout_ms = 45000

        navigate "open-button" {
            url = "http://127.0.0.1:4178/UI/en/components/button.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        viewport "desktop" {
            width = 1440
            height = 1000
        }

        click "show-source" {
            target = role("button", "Show source")
        }

        expect "highlighted-source-visible" {
            visible = css(".a3s-preview [data-preview-source-panel]:not([hidden]) .line span[style]")
        }

        click "use-dark-preview" {
            target = role("button", "Preview in dark mode")
        }

        expect "dark-preview-applied" {
            visible = css(".a3s-preview[data-preview-scheme=dark] .a3s-preview__canvas.dark")
        }

        click "use-rtl-preview" {
            target = role("button", "Preview right-to-left layout")
        }

        expect "rtl-preview-applied" {
            visible = css(".a3s-preview[data-preview-direction=rtl] .a3s-preview__canvas[dir=rtl]")
        }

        click "use-phone-width" {
            target = role("button", "Phone width")
        }

        expect "phone-width-applied" {
            visible = css(".a3s-preview[data-preview-viewport=phone] button[aria-label='Phone width'][aria-pressed=true]")
        }

        expect "phone-shell-visible" {
            visible = css(".a3s-preview[data-preview-viewport=phone] .a3s-preview__viewport-shell")
        }

        expect "phone-frame-visible" {
            visible = css(".a3s-preview[data-preview-viewport=phone] iframe[title='Common actions phone preview']")
        }

        screenshot "preview-tooling-evidence" {
            path = "documentation/preview-tooling.png"
        }
    }

    scenario "responsive-documentation-navigation" {
        name = "Responsive documentation navigation preserves language and version routes"
        surface = "web"
        timeout_ms = 60000

        navigate "open-device-simulator" {
            url = "http://127.0.0.1:4178/UI/components/device-simulator.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        viewport "responsive-boundary" {
            width = 1024
            height = 900
        }

        expect "responsive-menu-visible" {
            visible = css(".a3s-responsive-navigation > summary")
        }

        click "open-navigation" {
            target = role("button", "打开主导航")
        }

        expect "navigation-open" {
            visible = css(".a3s-responsive-navigation[open] .a3s-responsive-navigation__surface")
        }

        click "open-language-switcher" {
            target = css(".a3s-responsive-navigation [data-preference=language] > summary")
        }

        click "switch-to-english" {
            target = css(".a3s-responsive-navigation [data-preference=language] a[lang=en]")
        }

        wait "english-route-loaded" {
            url = "http://127.0.0.1:4178/UI/en/components/device-simulator.html"
        }

        navigate "open-versioned-component" {
            url = "http://127.0.0.1:4178/UI/en/components/button.html"
        }

        wait "component-loaded" {
            load = "networkidle"
        }

        click "open-component-navigation" {
            target = role("button", "Open primary navigation")
        }

        click "open-version-switcher" {
            target = css(".a3s-responsive-navigation [data-preference=version] > summary")
        }

        focus "focus-v0-1" {
            target = css(".a3s-responsive-navigation [data-preference=version] a[href^='/UI/v0.1.0/en/components/button']")
        }

        press "switch-to-v0-1" {
            key = "Enter"
        }

        wait "version-route-loaded" {
            url = "http://127.0.0.1:4178/UI/v0.1.0/en/components/button.html"
        }
    }

    scenario "theme-realtime" {
        name = "Theme changes update the documentation and previews immediately"
        surface = "web"
        timeout_ms = 60000

        navigate "open-theme-switcher" {
            url = "http://127.0.0.1:4178/UI/en/components/theme-switcher.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        viewport "desktop-navigation" {
            width = 1440
            height = 900
        }

        expect "visible-site-theme-control" {
            visible = css(".rp-nav__others .rp-switch-appearance")
        }

        click "switch-site-to-dark" {
            target = css(".rp-nav__others .rp-switch-appearance")
        }

        wait "dark-applied" {
            visible = css("html.dark.rp-dark")
        }

        screenshot "dark-theme-evidence" {
            path = "theme/dark.png"
        }

        click "switch-site-to-light" {
            target = css(".rp-nav__others .rp-switch-appearance")
        }

        wait "light-applied" {
            visible = css("html:not(.dark):not(.rp-dark)")
        }

        screenshot "light-theme-evidence" {
            path = "theme/light.png"
        }
    }

    scenario "dropdown-overlay" {
        name = "Dropdown escapes the MDX preview frame"
        surface = "web"
        timeout_ms = 60000

        navigate "open-dropdown" {
            url = "http://127.0.0.1:4178/UI/en/components/dropdown-menu.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        click "trigger-dropdown" {
            target = css("#demo-dropdown-menu-trigger")
        }

        wait "overlay-ready" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false]")
        }

        expect "dropdown-positioned" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false][data-a3s-positioned=true][data-resolved-side]")
        }

        screenshot "dropdown-evidence" {
            path = "overlays/dropdown.png"
        }
    }

    scenario "popover-overlay" {
        name = "Popover escapes the MDX preview frame"
        surface = "web"
        timeout_ms = 60000

        navigate "open-popover" {
            url = "http://127.0.0.1:4178/UI/en/components/popover.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        click "trigger-popover" {
            target = css("#demo-popover-trigger")
        }

        wait "overlay-ready" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false]")
        }

        expect "popover-positioned" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false][data-a3s-positioned=true][data-resolved-side]")
        }

        screenshot "popover-evidence" {
            path = "overlays/popover.png"
        }
    }

    scenario "select-overlay" {
        name = "Select menu escapes the MDX preview frame"
        surface = "web"
        timeout_ms = 60000

        navigate "open-select" {
            url = "http://127.0.0.1:4178/UI/en/components/select.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        click "trigger-select" {
            target = css("#select-demo-trigger")
        }

        wait "overlay-ready" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false]")
        }

        expect "select-positioned" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false][data-a3s-positioned=true][data-resolved-side]")
        }

        screenshot "select-evidence" {
            path = "overlays/select.png"
        }
    }

    scenario "combobox-overlay" {
        name = "Combobox menu escapes the MDX preview frame"
        surface = "web"
        timeout_ms = 60000

        navigate "open-combobox" {
            url = "http://127.0.0.1:4178/UI/en/components/combobox.html"
        }

        wait "page-loaded" {
            load = "networkidle"
        }

        wait "interactive-ready" {
            visible = css("html:not([data-a3s-defer-init])")
        }

        click "trigger-combobox" {
            target = css("#framework-combobox > input[role=combobox]")
        }

        wait "overlay-ready" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false]")
        }

        expect "combobox-positioned" {
            visible = css(".a3s-preview[data-overlay-open] [data-popover][aria-hidden=false][data-a3s-positioned=true][data-resolved-side]")
        }

        screenshot "combobox-evidence" {
            path = "overlays/combobox.png"
        }
    }
}
