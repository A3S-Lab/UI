suite "a3s-ui-product-session-detail" {
    version = 1

    scenario "session-detail-conversation" {
        name = "Session detail stays a focused conversation instead of a component showcase"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/sessions/fix-session-recovery.html" }
        wait "loaded" { load = "networkidle" }
        wait "session-ready" { visible = css(".a3s-product-application[data-view=session] [data-product-surface=session]") }

        expect "session-title" { text = "修复会话恢复" }
        expect "conversation-only" { visible = css("[data-product-surface=session]:not(:has(.a3s-workspace-playground))") }
        expect "search-action" { visible = css("button[aria-label='在会话中搜索']") }
        expect "details-secondary" { visible = css(".product-session__actions button[aria-label='打开任务详情']") }
        expect "details-hidden-by-default" { visible = css("[data-product-surface=session][data-inspector=hidden]:has(aside[aria-label='任务详情'][hidden][inert])") }
        expect "empty-send-disabled" { visible = css(".product-session__composer button[aria-label='发送任务']:disabled") }
        expect "execution-boundary" { visible = css(".product-session-execution") }
        expect "completed-plan-collapsed" { visible = css("details.product-execution-plan[data-state=complete]:not([open])") }
        expect "response-actions-match-icons" { visible = css(".product-session__message-actions:has(button[aria-label='复制回复'] svg[data-icon=copy]):has(button[aria-label='回复有帮助'] svg[data-icon=thumb-up]):has(button[aria-label='回复没有帮助'] svg[data-icon=thumb-down]):has(button[aria-label='朗读回复'] svg[data-icon=volume]):has(summary[aria-label='更多回复操作'] svg[data-icon=more])") }

        click "expand-completed-plan" { target = css(".product-execution-plan > summary") }
        expect "completed-plan-steps-visible" { visible = css(".product-execution-plan[open] ol") }
        click "collapse-completed-plan" { target = css(".product-execution-plan > summary") }
        expect "completed-plan-collapsed-again" { visible = css(".product-execution-plan:not([open])") }

        click "open-test-log" { target = css(".product-tool-timeline > ol > li:nth-child(4) > details > summary") }
        expect "log-viewer-public-contract" { visible = css(".product-session-execution .log-viewer[aria-label='测试日志'][data-a3s-components~='log-viewer'] [role=log][aria-label='按时间排序的测试输出']") }
        expect "ordered-log-records" { visible = css(".product-session-execution .log-viewer [role=log]:has([data-log-record]:first-child [data-log-sequence]):has([data-log-record]:last-child [data-log-sequence])") }
        click "copy-test-log" { target = role("button", "复制完整测试日志") }
        expect "test-log-copy-feedback" { visible = css(".product-session-execution .log-viewer button[aria-label='复制完整测试日志'] svg[data-icon=check]") }
        screenshot "test-log-evidence" { path = "product/session-test-log-desktop.png" }

        click "open-primary-review-action" { target = role("button", "设备预览") }
        wait "primary-review-opens-preview" { visible = css(".product-session-inspector .device-simulator[data-variant=compact][data-device-simulator-initialized=true]") }
        click "close-primary-review" { target = css(".product-session-inspector__header > button[aria-label='关闭任务详情']") }
        expect "primary-review-focus-restored" { visible = css(".product-delivery-summary button[data-primary]:focus") }

        click "open-search" { target = css("button[aria-label='在会话中搜索']") }
        fill "search-focus" { target = css("input[aria-label='搜索当前会话']") value = "焦点" }
        expect "search-results" { text = "3 个结果" }
        click "close-search" { target = css("button[aria-label='关闭会话搜索']") }

        expect "artifacts-stay-in-session" { visible = css(".a3s-product-application[data-view=session]:not(:has(.a3s-workspace-playground))") }
        click "reopen-details" { target = css("button[aria-label='打开任务详情']") }
        expect "details-visible-again" { visible = css("aside[aria-label='任务详情']") }
        click "open-overview-tab" { target = role("tab", "概览") }
        expect "overview-panel-boundary" { visible = css(".product-inspector-overview") }
        click "open-artifacts-tab" { target = role("tab", "产物") }
        expect "artifacts-panel-boundary" { visible = css(".product-inspector-artifacts") }
        click "open-session-artifact" { target = css(".product-inspector-file-list button") }
        expect "artifact-public-contract" { visible = css(".artifact-card[data-variant=inspector] .highlighter [data-code-line]") }
        expect "artifact-copy-public-contract" { visible = css(".artifact-card[data-variant=inspector] .copy-button[data-copy-button-initialized=true]") }
        click "close-details" { target = css(".product-session-inspector__header > button[aria-label='关闭任务详情']") }
        expect "details-trigger-restored" { visible = css("button[aria-label='打开任务详情']:focus") }

        click "open-full-diff" { target = role("button", "查看完整差异") }
        wait "file-explorer-public-contract" { visible = css(".product-session-inspector .file-explorer[data-file-explorer-initialized=true]") }
        expect "files-panel-boundary" { visible = css(".product-inspector-files") }
        expect "diff-public-contract" { visible = css(".product-session-inspector .code-diff[data-line-numbers]") }
        expect "diff-lines-visible" { visible = css(".code-diff[data-line-numbers] [data-diff-line='+']") }
        screenshot "diff-evidence" { path = "product/session-diff-desktop.png" }
        click "switch-diff-to-device-preview" { target = role("tab", "预览") }
        wait "device-preview-public-contract" { visible = css(".product-session-inspector .device-simulator[data-variant=compact][data-device-simulator-initialized=true]") }
        select "choose-desktop-preview" { target = css(".device-simulator[data-variant=compact] [data-device-simulator-select]") values = ["desktop"] }
        expect "desktop-shell-visible" { visible = css(".device-simulator[data-variant=compact][data-device=desktop][data-device-kind=desktop][data-width='1920'][data-height='1080']") }
        click "open-full-device-simulator" { target = role("button", "打开完整设备模拟器") }
        expect "full-device-simulator-visible" { visible = css(".product-session-inspector[data-preview-expanded=true] .device-simulator[data-device-simulator-initialized=true]") }
        select "choose-desktop-device" { target = css(".product-session-device-simulator [data-device-simulator-select]") values = ["desktop"] }
        expect "desktop-device-ready" { visible = css(".product-session-device-simulator[data-device=desktop][data-device-kind=desktop][data-width='1920'][data-height='1080']") }
        expect "webview-command-visible" { visible = css(".product-session-device-simulator [data-device-simulator-command]") }
        click "collapse-device-simulator" { target = css(".product-inspector-preview .product-inspector-section-heading > button") }
        wait "compact-device-preview-restored" { visible = css(".product-session-inspector:not([data-preview-expanded=true]) .device-simulator[data-variant=compact][data-device-simulator-initialized=true]") }
        expect "preview-panel-restored" { visible = css(".product-inspector-preview:has(.device-simulator[data-variant=compact])") }
        click "open-code-graph" { target = role("tab", "图谱") }
        expect "code-graph-public-contract" { visible = css(".product-session-inspector .code-graph[data-code-graph-initialized=true] [data-code-graph-canvas]") }
        expect "expand-graph-icon" { visible = css(".product-inspector-graph button[aria-label='展开代码依赖图谱'][aria-expanded=false] svg[data-icon=expand]") }
        click "expand-code-graph" { target = role("button", "展开代码依赖图谱") }
        expect "expanded-graph-icon" { visible = css(".product-session-inspector[data-graph-expanded=true] .product-inspector-graph button[aria-label='收起代码依赖图谱'][aria-expanded=true] svg[data-icon=contract]") }
        screenshot "expanded-graph-evidence" { path = "product/session-code-graph-expanded-desktop.png" }
        click "collapse-code-graph" { target = role("button", "收起代码依赖图谱") }
        expect "graph-collapsed" { visible = css(".product-session-inspector:not([data-graph-expanded=true]) .product-inspector-graph button[aria-expanded=false] svg[data-icon=expand]") }
        fill "filter-code-graph" { target = css(".product-session-code-graph [data-code-graph-search]") value = "ToolCall" }
        click "show-code-list" { target = role("button", "列表") }
        expect "filtered-code-node" { visible = css(".product-session-code-graph[data-view=list] [data-code-node][data-node-id='tool-calls']:not([hidden])") }
        click "select-tool-call-node" { target = css(".product-session-code-graph [data-node-id='tool-calls'] > button") }
        expect "tool-call-node-selected" { visible = css(".product-session-code-graph [data-node-id='tool-calls'][aria-selected=true]") }
        click "close-result-details" { target = css(".product-session-inspector__header > button[aria-label='关闭任务详情']") }

        focus "focus-response-menu" { target = css(".product-session__message-menu > summary") }
        press "open-response-menu" { key = "Enter" }
        wait "response-menu-visible" { visible = css(".product-session__message-menu[open] [role=menu]") }
        click "save-response-memory" { target = role("menuitem", "保存到记忆") }
        expect "response-memory-status" { text = "回复已保存到记忆" }

        fill "continue-session" { target = css(".product-session__composer [role=textbox][aria-label='任务指令']") value = "继续检查移动端焦点顺序" }
        expect "send-enabled" { visible = css(".product-session__composer button[aria-label='发送任务']:not(:disabled)") }
        click "send-follow-up" { target = css(".product-session__composer button[aria-label='发送任务']") }
        expect "follow-up-visible" { text = "继续检查移动端焦点顺序" }

        screenshot "desktop-evidence" { path = "product/session-detail-desktop.png" }
        console "console" { path = "product/session-detail-desktop-console.json" clear = false }
        page_errors "page-errors" { path = "product/session-detail-desktop-page-errors.json" clear = false }
    }

    scenario "session-detail-mobile" {
        name = "Session detail preserves the conversation and composer on a phone viewport"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/sessions/fix-session-recovery.html" }
        wait "loaded" { load = "networkidle" }
        wait "session-ready" { visible = css(".a3s-product-application[data-view=session] [data-product-surface=session]") }

        expect "mobile-navigation" { visible = css("button[aria-label='打开应用导航']") }
        expect "mobile-composer" { visible = css(".product-session__composer .ProseMirror") }
        expect "mobile-send-disabled" { visible = css(".product-session__composer button[aria-label='发送任务']:disabled") }
        expect "mobile-tool-calls" { visible = css(".product-tool-timeline") }

        click "open-mobile-test-log" { target = css(".product-tool-timeline > ol > li:nth-child(4) > details > summary") }
        expect "mobile-log-viewer-public-contract" { visible = css(".product-session-execution .log-viewer[data-a3s-components~='log-viewer'] [role=log][aria-label='按时间排序的测试输出']") }
        expect "mobile-log-records-contained" { visible = css(".product-session-execution .log-viewer [role=log]:has([data-log-record]:nth-child(4))") }
        screenshot "mobile-test-log-evidence" { path = "product/session-test-log-mobile.png" }

        click "open-mobile-details" { target = css("button[aria-label='打开任务详情']") }
        expect "mobile-details" { visible = css("aside[aria-label='任务详情']") }
        expect "mobile-details-full-width" { visible = css(".product-session-inspector[role=dialog]") }

        screenshot "mobile-evidence" { path = "product/session-detail-mobile.png" }
        press "close-mobile-details" { key = "Escape" }
        expect "mobile-details-trigger-restored" { visible = css("button[aria-label='打开任务详情']:focus") }
        expect "mobile-session-restored" { visible = css("[data-product-surface=session][data-inspector=hidden]:has(.product-session__viewport):has(.product-session__composer .ProseMirror):has(aside[aria-label='任务详情'][hidden][inert])") }
        screenshot "mobile-restored-evidence" { path = "product/session-detail-mobile-restored.png" }
        console "console" { path = "product/session-detail-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/session-detail-mobile-page-errors.json" clear = false }
    }
}
