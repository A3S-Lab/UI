        press "dark-close-public-root" { key = "Escape" }
        wait "dark-public-root-closed" { visible = css(".a3s-preview[data-preview-component=dialog][data-preview-integration=complete]:not(:has([data-a3s-components~='dialog'][open]))") }

        viewport "compact" { width = 390 height = 844 }
        navigate "compact-reload" { url = "http://127.0.0.1:4178/UI/en/components/dialog.html" }
