        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=bulk-action-bar]") }
        wait "state-specimens-ready" { visible = css(".a3s-component-state-matrix[open][data-component=bulk-action-bar] [data-state-specimen=empty]:has([data-a3s-components~='bulk-action-bar'][data-a3s-state~='empty'])") }
        expect "semantic-state-empty" { visible = css(".a3s-component-state-matrix[open][data-component=bulk-action-bar] [data-state-specimen=empty]:has([data-a3s-components~='bulk-action-bar'][data-a3s-state~='empty'])") }
        expect "semantic-state-selected" { visible = css(".a3s-component-state-matrix[open][data-component=bulk-action-bar] [data-state-specimen=selected]:has([data-a3s-components~='bulk-action-bar'][data-a3s-state~='selected'][data-selected=true])") }
        expect "semantic-state-loading" { visible = css(".a3s-component-state-matrix[open][data-component=bulk-action-bar] [data-state-specimen=loading]:has([data-a3s-components~='bulk-action-bar'][data-a3s-state~='loading'][aria-busy=true])") }
