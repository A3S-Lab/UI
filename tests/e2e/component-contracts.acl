    scenario "component-contract-bulk-action-bar" {
        name = "Bulk Action Bar keeps one public contract across documentation integrations and responsive states"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/bulk-action-bar.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar][data-preview-integration=complete][data-preview-source=ready]") }
        wait "public-preview-ready" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar][data-preview-integration=complete][data-preview-source=ready]") }
        expect "public-root" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar][data-preview-integration=complete] [data-a3s-components~='bulk-action-bar']") }
        expect "light-ltr-contract" { visible = css(".a3s-preview[data-preview-component=bulk-action-bar][data-preview-integration=complete][data-preview-scheme=inherit][data-preview-direction=ltr]") }
        screenshot "desktop-light" { path = "components/contracts/bulk-action-bar-desktop-light.png" }

