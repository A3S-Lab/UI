        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=scroll-area]") }
        wait "state-specimens-ready" { visible = css(".a3s-component-state-matrix[open][data-component=scroll-area] [data-state-specimen=ready]:has([data-a3s-components~='scroll-area'][data-a3s-state~='ready'])") }
        expect "semantic-state-ready" { visible = css(".a3s-component-state-matrix[open][data-component=scroll-area] [data-state-specimen=ready]:has([data-a3s-components~='scroll-area'][data-a3s-state~='ready'])") }
        screenshot "state-matrix" { path = "components/contracts/scroll-area-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-preview-control=states]:focus") }

        focus "focus-source" { target = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-preview-control=source]") }
        press "open-source" { key = "Enter" }
        expect "source-open" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-preview-source-panel]:not([hidden])") }
        expect "framework-panel" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-component-integration=scroll-area][data-mode=complete]") }
        focus "focus-html-tab" { target = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-component-integration=scroll-area] [role=tab]:nth-child(1)") }
        press "select-html" { key = "Enter" }
        expect "html-selected" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-component-integration=scroll-area][data-framework=html] [role=tab]:nth-child(1)[aria-selected=true]:focus") }
        press "select-react" { key = "ArrowRight" }
        expect "react-selected" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-component-integration=scroll-area][data-framework=react] [role=tab]:nth-child(2)[aria-selected=true]:focus") }
        press "select-vue" { key = "ArrowRight" }
        expect "vue-selected" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-component-integration=scroll-area][data-framework=vue] [role=tab]:nth-child(3)[aria-selected=true]:focus") }

        focus "focus-appearance" { target = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-preview-control=appearance]") }
        press "enable-dark-preview" { key = "Enter" }
        expect "dark-preview" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete][data-preview-scheme=dark]") }
        focus "focus-direction" { target = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-preview-control=direction]") }
        press "enable-rtl-preview" { key = "Enter" }
        expect "rtl-preview" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete][data-preview-direction=rtl]") }
        expect "dark-public-root" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-a3s-components~='scroll-area']") }
        screenshot "desktop-dark-rtl" { path = "components/contracts/scroll-area-desktop-dark-rtl.png" }


        viewport "compact" { width = 390 height = 844 }
        expect "compact-preview" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete][data-preview-scheme=dark][data-preview-direction=rtl]") }
        expect "compact-public-root" { visible = css(".a3s-preview[data-preview-component=scroll-area][data-preview-integration=complete] [data-a3s-components~='scroll-area']") }
        screenshot "capture-compact" { path = "components/contracts/scroll-area-compact.png" }
        accessibility "tree" { path = "components/contracts/scroll-area-accessibility.json" interactive = true }
        console "console" { path = "components/contracts/scroll-area-console.json" clear = false }
        page_errors "errors" { path = "components/contracts/scroll-area-errors.json" clear = false }

    }

    scenario "component-contract-theme-switcher" {
        name = "Theme Switcher keeps one public contract across documentation integrations and responsive states"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/theme-switcher.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete][data-preview-source=ready]") }
        wait "public-preview-ready" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete][data-preview-source=ready]") }
        expect "public-root" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-a3s-components~='theme-switcher']") }
        expect "light-ltr-contract" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete][data-preview-scheme=inherit][data-preview-direction=ltr]") }
        screenshot "desktop-light" { path = "components/contracts/theme-switcher-desktop-light.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=theme-switcher]") }
        wait "state-specimens-ready" { visible = css(".a3s-component-state-matrix[open][data-component=theme-switcher] [data-state-specimen=ready]:has([data-a3s-components~='theme-switcher'][data-a3s-state~='ready'])") }
        expect "semantic-state-ready" { visible = css(".a3s-component-state-matrix[open][data-component=theme-switcher] [data-state-specimen=ready]:has([data-a3s-components~='theme-switcher'][data-a3s-state~='ready'])") }
        expect "semantic-state-light" { visible = css(".a3s-component-state-matrix[open][data-component=theme-switcher] [data-state-specimen=light]:has([data-a3s-components~='theme-switcher'][data-a3s-state~='light'])") }
        expect "semantic-state-dark" { visible = css(".a3s-component-state-matrix[open][data-component=theme-switcher] [data-state-specimen=dark]:has([data-a3s-components~='theme-switcher'][data-a3s-state~='dark'])") }
        screenshot "state-matrix" { path = "components/contracts/theme-switcher-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-preview-control=states]:focus") }

        focus "focus-source" { target = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-preview-control=source]") }
        press "open-source" { key = "Enter" }
        expect "source-open" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-preview-source-panel]:not([hidden])") }
        expect "framework-panel" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-component-integration=theme-switcher][data-mode=complete]") }
        focus "focus-html-tab" { target = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-component-integration=theme-switcher] [role=tab]:nth-child(1)") }
        press "select-html" { key = "Enter" }
        expect "html-selected" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-component-integration=theme-switcher][data-framework=html] [role=tab]:nth-child(1)[aria-selected=true]:focus") }
        press "select-react" { key = "ArrowRight" }
        expect "react-selected" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-component-integration=theme-switcher][data-framework=react] [role=tab]:nth-child(2)[aria-selected=true]:focus") }
        press "select-vue" { key = "ArrowRight" }
        expect "vue-selected" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-component-integration=theme-switcher][data-framework=vue] [role=tab]:nth-child(3)[aria-selected=true]:focus") }

        focus "focus-appearance" { target = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-preview-control=appearance]") }
        press "enable-dark-preview" { key = "Enter" }
        expect "dark-preview" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete][data-preview-scheme=dark]") }
        focus "focus-direction" { target = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-preview-control=direction]") }
        press "enable-rtl-preview" { key = "Enter" }
        expect "rtl-preview" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete][data-preview-direction=rtl]") }
        expect "dark-public-root" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-a3s-components~='theme-switcher']") }
        screenshot "desktop-dark-rtl" { path = "components/contracts/theme-switcher-desktop-dark-rtl.png" }


        viewport "compact" { width = 390 height = 844 }
        expect "compact-preview" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete][data-preview-scheme=dark][data-preview-direction=rtl]") }
        expect "compact-public-root" { visible = css(".a3s-preview[data-preview-component=theme-switcher][data-preview-integration=complete] [data-a3s-components~='theme-switcher']") }
        screenshot "capture-compact" { path = "components/contracts/theme-switcher-compact.png" }
        accessibility "tree" { path = "components/contracts/theme-switcher-accessibility.json" interactive = true }
        console "console" { path = "components/contracts/theme-switcher-console.json" clear = false }
        page_errors "errors" { path = "components/contracts/theme-switcher-errors.json" clear = false }

