        expect "compact-preview" { visible = css(".a3s-preview[data-preview-component=dialog][data-preview-integration=complete][data-preview-scheme=inherit][data-preview-direction=ltr]") }
        click "compact-open-public-root" { target = role("button", "Open Dialog") }
        wait "compact-public-root-ready" { visible = css(".a3s-preview[data-preview-component=dialog][data-preview-integration=complete] [data-a3s-components~='dialog'][open] > :is(div, article)") }
        expect "compact-public-root" { visible = css(".a3s-preview[data-preview-component=dialog][data-preview-integration=complete] [data-a3s-components~='dialog'][open] > :is(div, article)") }
        screenshot "capture-compact" { path = "components/contracts/dialog-compact.png" }
        accessibility "tree" { path = "components/contracts/dialog-accessibility.json" interactive = true }
        console "console" { path = "components/contracts/dialog-console.json" clear = false }
        page_errors "errors" { path = "components/contracts/dialog-errors.json" clear = false }

        press "compact-close-public-root" { key = "Escape" }
        wait "compact-public-root-closed" { visible = css(".a3s-preview[data-preview-component=dialog][data-preview-integration=complete]:not(:has([data-a3s-components~='dialog'][open]))") }
    }

