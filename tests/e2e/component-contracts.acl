        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=button-group]") }
        wait "state-specimens-ready" { visible = css(".a3s-component-state-matrix[open][data-component=button-group] [data-state-specimen=ready]:has([data-a3s-components~='button-group'][data-a3s-state~='ready'])") }
        expect "semantic-state-ready" { visible = css(".a3s-component-state-matrix[open][data-component=button-group] [data-state-specimen=ready]:has([data-a3s-components~='button-group'][data-a3s-state~='ready'])") }
        expect "semantic-state-disabled" { visible = css(".a3s-component-state-matrix[open][data-component=button-group] [data-state-specimen=disabled]:has([data-a3s-components~='button-group'][data-a3s-state~='disabled']:is([disabled],[aria-disabled=true],:has([disabled]),:has([aria-disabled=true])))") }
        screenshot "state-matrix" { path = "components/contracts/button-group-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-preview-control=states]:focus") }

        focus "focus-source" { target = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-preview-control=source]") }
        press "open-source" { key = "Enter" }
        expect "source-open" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-preview-source-panel]:not([hidden])") }
        expect "framework-panel" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-component-integration=button-group][data-mode=complete]") }
        focus "focus-html-tab" { target = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-component-integration=button-group] [role=tab]:nth-child(1)") }
        press "select-html" { key = "Enter" }
        expect "html-selected" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-component-integration=button-group][data-framework=html] [role=tab]:nth-child(1)[aria-selected=true]:focus") }
        press "select-react" { key = "ArrowRight" }
        expect "react-selected" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-component-integration=button-group][data-framework=react] [role=tab]:nth-child(2)[aria-selected=true]:focus") }
        press "select-vue" { key = "ArrowRight" }
        expect "vue-selected" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-component-integration=button-group][data-framework=vue] [role=tab]:nth-child(3)[aria-selected=true]:focus") }

        focus "focus-appearance" { target = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-preview-control=appearance]") }
        press "enable-dark-preview" { key = "Enter" }
        expect "dark-preview" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete][data-preview-scheme=dark]") }
        focus "focus-direction" { target = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-preview-control=direction]") }
        press "enable-rtl-preview" { key = "Enter" }
        expect "rtl-preview" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete][data-preview-direction=rtl]") }
        expect "dark-public-root" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-a3s-components~='button-group']") }
        screenshot "desktop-dark-rtl" { path = "components/contracts/button-group-desktop-dark-rtl.png" }


        viewport "compact" { width = 390 height = 844 }
        expect "compact-preview" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete][data-preview-scheme=dark][data-preview-direction=rtl]") }
        expect "compact-public-root" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-a3s-components~='button-group']") }
