suite "a3s-ui-component-contracts" {
    version = 1

    scenario "component-contract-button" {
        name = "Button keeps one public contract across documentation integrations and responsive states"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/button.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete][data-preview-source=ready]") }
        wait "public-preview-ready" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete][data-preview-source=ready]") }
        expect "public-root" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-a3s-components~='button']") }
        expect "light-ltr-contract" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete][data-preview-scheme=inherit][data-preview-direction=ltr]") }
        screenshot "desktop-light" { path = "components/contracts/button-desktop-light.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=button]") }
        wait "state-specimens-ready" { visible = css(".a3s-component-state-matrix[open][data-component=button] [data-state-specimen=ready]:has([data-a3s-components~='button'][data-a3s-state~='ready'])") }
        expect "semantic-state-ready" { visible = css(".a3s-component-state-matrix[open][data-component=button] [data-state-specimen=ready]:has([data-a3s-components~='button'][data-a3s-state~='ready'])") }
        expect "semantic-state-disabled" { visible = css(".a3s-component-state-matrix[open][data-component=button] [data-state-specimen=disabled]:has([data-a3s-components~='button'][data-a3s-state~='disabled']:is([disabled],[aria-disabled=true],:has([disabled]),:has([aria-disabled=true])))") }
        expect "semantic-state-loading" { visible = css(".a3s-component-state-matrix[open][data-component=button] [data-state-specimen=loading]:has([data-a3s-components~='button'][data-a3s-state~='loading'][aria-busy=true])") }
        expect "semantic-state-pressed" { visible = css(".a3s-component-state-matrix[open][data-component=button] [data-state-specimen=pressed]:has([data-a3s-components~='button'][data-a3s-state~='pressed'][aria-pressed=true])") }
        screenshot "state-matrix" { path = "components/contracts/button-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-preview-control=states]:focus") }

        focus "focus-source" { target = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-preview-control=source]") }
        press "open-source" { key = "Enter" }
        expect "source-open" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-preview-source-panel]:not([hidden])") }
        expect "framework-panel" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-component-integration=button][data-mode=complete]") }
        focus "focus-html-tab" { target = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-component-integration=button] [role=tab]:nth-child(1)") }
        press "select-html" { key = "Enter" }
        expect "html-selected" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-component-integration=button][data-framework=html] [role=tab]:nth-child(1)[aria-selected=true]:focus") }
        press "select-react" { key = "ArrowRight" }
        expect "react-selected" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-component-integration=button][data-framework=react] [role=tab]:nth-child(2)[aria-selected=true]:focus") }
        press "select-vue" { key = "ArrowRight" }
        expect "vue-selected" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-component-integration=button][data-framework=vue] [role=tab]:nth-child(3)[aria-selected=true]:focus") }

        focus "focus-appearance" { target = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-preview-control=appearance]") }
        press "enable-dark-preview" { key = "Enter" }
        expect "dark-preview" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete][data-preview-scheme=dark]") }
        focus "focus-direction" { target = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-preview-control=direction]") }
        press "enable-rtl-preview" { key = "Enter" }
        expect "rtl-preview" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete][data-preview-direction=rtl]") }
        expect "dark-public-root" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-a3s-components~='button']") }
        screenshot "desktop-dark-rtl" { path = "components/contracts/button-desktop-dark-rtl.png" }


        viewport "compact" { width = 390 height = 844 }
        expect "compact-preview" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete][data-preview-scheme=dark][data-preview-direction=rtl]") }
        expect "compact-public-root" { visible = css(".a3s-preview[data-preview-component=button][data-preview-integration=complete] [data-a3s-components~='button']") }
        screenshot "capture-compact" { path = "components/contracts/button-compact.png" }
        accessibility "tree" { path = "components/contracts/button-accessibility.json" interactive = true }
        console "console" { path = "components/contracts/button-console.json" clear = false }
        page_errors "errors" { path = "components/contracts/button-errors.json" clear = false }

    }

    scenario "component-contract-button-group" {
        name = "Button Group keeps one public contract across documentation integrations and responsive states"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/button-group.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete][data-preview-source=ready]") }
        wait "public-preview-ready" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete][data-preview-source=ready]") }
        expect "public-root" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete] [data-a3s-components~='button-group']") }
        expect "light-ltr-contract" { visible = css(".a3s-preview[data-preview-component=button-group][data-preview-integration=complete][data-preview-scheme=inherit][data-preview-direction=ltr]") }
