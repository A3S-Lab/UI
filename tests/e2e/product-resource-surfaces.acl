suite "a3s-ui-product-resource-surfaces" {
    version = 1

    scenario "mailbox-activation" {
        name = "Mailbox activation requires informed consent and exposes a usable ready state"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/mail.html" }
        wait "loaded" { load = "networkidle" }
        wait "mailbox-ready" { visible = css(".a3s-product-application[data-view=resources] .product-mail[data-resource=mail]") }
        expect "mail-surface-boundary" { visible = css("[data-product-surface=mail]") }

        expect "mailbox-title" { text = "智能体邮箱" }
        expect "consent-required" { visible = css(".product-mail__consent button[data-primary]:disabled") }
        screenshot "consent-desktop" { path = "product/mailbox-consent-desktop.png" }
        click "show-scope" { target = role("button", "查看说明") }
        expect "scope-visible" { visible = css(".product-mail__details[role=note]") }
        check "accept-scope" { target = css(".product-mail__consent input[type=checkbox]") }
        expect "activation-enabled" { visible = css(".product-mail__consent button[data-primary]:not(:disabled)") }
        click "activate" { target = role("button", "确认开通") }

        expect "ready-heading" { text = "智能体邮箱已开通" }
        expect "mailbox-address" { text = "tasks@local.a3s.dev" }
        expect "copy-action" { visible = css(".product-mail__ready button:not([data-danger])") }
        expect "disconnect-action" { visible = css(".product-mail__ready button[data-danger]") }

        screenshot "desktop-evidence" { path = "product/mailbox-activation-desktop.png" }
        viewport "mobile" { width = 390 height = 844 }
        expect "mobile-ready-actions" { visible = css(".product-mail__ready button[data-primary]") }
        screenshot "mobile-evidence" { path = "product/mailbox-activation-mobile.png" }

        viewport "desktop-restored" { width = 1440 height = 1000 }
        navigate "restore-mailbox" { url = "http://127.0.0.1:4178/UI/playground/resources/mail.html" }
        wait "restored-loaded" { load = "networkidle" }
        wait "connection-persisted" { visible = css(".product-mail__service[data-connected=true]") }
        focus "focus-use-mailbox" { target = css(".product-mail__ready button[data-primary]") }
        press "use-mailbox" { key = "Enter" }
        wait "mailbox-attached" { visible = css("[data-composer-resources] [data-resource-id='connector:agent-mailbox']") }
        navigate "return-to-mailbox" { url = "http://127.0.0.1:4178/UI/playground/resources/mail.html" }
        wait "return-loaded" { load = "networkidle" }
        focus "focus-disconnect" { target = css(".product-mail__ready button[data-danger]") }
        press "disconnect" { key = "Enter" }
        wait "disconnect-dialog" { visible = css(".product-mail__dialog[open]") }
        focus "focus-cancel-disconnect" { target = css(".product-mail__dialog[open] footer button:first-child") }
        press "cancel-disconnect" { key = "Enter" }
        expect "connection-kept" { visible = css(".product-mail__service[data-connected=true]") }
        expect "disconnect-focus-restored" { visible = css(".product-mail__ready button[data-danger]:focus") }
        press "disconnect-again" { key = "Enter" }
        wait "disconnect-dialog-again" { visible = css(".product-mail__dialog[open]") }
        focus "focus-confirm-disconnect" { target = css(".product-mail__dialog[open] footer button[data-danger]") }
        press "confirm-disconnect" { key = "Enter" }
        wait "connection-cleared" { visible = css(".product-mail__service[data-connected=false]") }
        console "console" { path = "product/mailbox-activation-console.json" clear = false }
        page_errors "page-errors" { path = "product/mailbox-activation-page-errors.json" clear = false }
    }

    scenario "document-connection-lifecycle" {
        name = "Document connection requires informed consent, persists, hands context to a task, and disconnects safely"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/documents.html" }
        wait "loaded" { load = "networkidle" }
        expect "resources-surface-boundary" { visible = css("[data-product-surface=resources]") }
        wait "connection-ready" { visible = css(".product-connection[data-state=inactive]") }
        expect "consent-required" { visible = css(".product-connection__actions button[data-primary]:disabled") }
        check "accept-scope" { target = css(".product-connection__consent input[type=checkbox]") }
        expect "connect-enabled" { visible = css(".product-connection__actions button[data-primary]:not(:disabled)") }
        click "connect" { target = role("button", "连接协作文档") }
        expect "connecting" { visible = css(".product-connection[data-state=connecting][aria-busy=true]") }
        wait "connection-active" { visible = css(".product-connection[data-state=active][data-connected=true]") }
        expect "ready-heading" { text = "协作文档已连接" }
        screenshot "connected-desktop" { path = "product/document-connection-desktop.png" }

        viewport "mobile" { width = 390 height = 844 }
        expect "mobile-primary-action" { visible = css(".product-connection__actions button[data-primary]") }
        screenshot "connected-mobile" { path = "product/document-connection-mobile.png" }

        viewport "desktop-restored" { width = 1440 height = 1000 }
        navigate "restore" { url = "http://127.0.0.1:4178/UI/playground/resources/documents.html" }
        wait "restored-loaded" { load = "networkidle" }
        wait "connection-persisted" { visible = css(".product-connection[data-state=active][data-connected=true]") }
        focus "focus-use-in-task" { target = css(".product-connection__actions button[data-primary]") }
        press "use-in-task" { key = "Enter" }
        wait "document-context-attached" { visible = css("[data-composer-resources] [data-resource-id='connector:documents']") }

        navigate "return" { url = "http://127.0.0.1:4178/UI/playground/resources/documents.html" }
        wait "return-loaded" { load = "networkidle" }
        focus "focus-disconnect" { target = css(".product-connection__actions button[data-danger]") }
        press "disconnect" { key = "Enter" }
        wait "disconnect-dialog" { visible = css(".product-connection__dialog[open]") }
        focus "focus-cancel-disconnect" { target = css(".product-connection__dialog[open] footer button:first-child") }
        press "cancel-disconnect" { key = "Enter" }
        expect "disconnect-focus-restored" { visible = css(".product-connection__actions button[data-danger]:focus") }
        press "disconnect-again" { key = "Enter" }
        wait "disconnect-dialog-again" { visible = css(".product-connection__dialog[open]") }
        focus "focus-confirm-disconnect" { target = css(".product-connection__dialog[open] footer button[data-danger]") }
        press "confirm-disconnect" { key = "Enter" }
        wait "connection-cleared" { visible = css(".product-connection[data-state=inactive][data-connected=false]") }

        console "console" { path = "product/document-connection-console.json" clear = false }
        page_errors "page-errors" { path = "product/document-connection-page-errors.json" clear = false }
    }

    scenario "files-mobile-hierarchy" {
        name = "Finder-style workspace files remain searchable, selectable, and previewable on mobile"
        surface = "web"
        timeout_ms = 60000
        viewport "mobile" { width = 390 height = 844 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/files.html" }
        wait "loaded" { load = "networkidle" }
        expect "file-manager-surface-boundary" { visible = css("[data-product-surface=files]") }
        wait "artifacts-ready" { visible = css(".product-file-artifacts table") }
        expect "artifacts-default" { visible = css(".product-files[data-file-surface=artifacts]") }
        click "open-artifact-workbench" { target = role("button", "打开 release-readiness.md") }
        wait "artifact-workbench-ready" { visible = css(".product-file-workbench[data-workbench-kind=code]") }
        expect "matching-workbench-file" { visible = css(".product-file-workbench input[aria-label='文件名'][value='release-readiness.md']") }
        click "back-to-workspace" { target = role("button", "返回文件") }
        expect "quick-look-after-workbench" { visible = css(".product-file-manager [data-file-manager-quicklook]") }
        click "close-quick-look" { target = role("button", "关闭文件预览") }
        click "open-workspace" { target = role("tab", "工作区") }
        wait "files-ready" { visible = css(".a3s-product-application[data-view=resources] .product-file-manager[data-file-manager-initialized=true]") }

        expect "mobile-navigation" { visible = css("button[aria-label='打开应用导航']") }
        expect "file-listbox" { visible = css(".product-file-manager [data-file-manager-viewport][role=listbox]") }
        fill "find-release-readiness" { target = css(".product-file-manager input[aria-label='搜索文件']") value = "release-readiness" }
        expect "matching-file" { visible = css(".product-file-manager [data-file-manager-item] strong[title='release-readiness.md']") }
        click "select-file" { target = css(".product-file-manager [data-file-manager-item]") }
        expect "selection-visible" { visible = css(".product-file-manager [data-file-manager-item][aria-selected=true]") }
        expect "selection-actions" { visible = css(".product-file-manager [data-file-manager-selection-toolbar]") }
        press "open-quick-look" { key = "Enter" }
        expect "quick-look-visible" { visible = css(".product-file-manager [data-file-manager-quicklook]") }

        screenshot "mobile-evidence" { path = "product/files-mobile-hierarchy.png" }
        console "console" { path = "product/files-mobile-console.json" clear = false }
        page_errors "page-errors" { path = "product/files-mobile-page-errors.json" clear = false }
    }

    scenario "files-icon-identity" {
        name = "Workspace files preserve recognizable type identity across views, preview, theme, and viewport"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/files.html" }
        wait "loaded" { load = "networkidle" }
        click "open-workspace" { target = role("tab", "工作区") }
        wait "files-ready" { visible = css(".product-file-manager[data-file-manager-initialized=true]") }

        expect "file-icon-component-boundary" { visible = css("[data-file-manager-item] [data-file-icon]") }
        expect "default-list-view" { visible = css("[data-file-manager-viewport][data-view=list] [data-file-icon-size=list]") }
        expect "folder-identity" { visible = css("[data-file-manager-item][data-kind=folder] [data-file-icon-size=list][data-file-type=folder]") }
        expect "code-identity" { visible = css("[data-file-manager-item]:has(strong[title='release-readiness.md']) [data-file-type=code] [data-file-extension=MD]") }
        expect "document-identity" { visible = css("[data-file-manager-item]:has(strong[title='experience-brief.docx']) [data-file-type=document] [data-file-extension=DOCX]") }
        expect "spreadsheet-identity" { visible = css("[data-file-manager-item]:has(strong[title='quality-scorecard.xlsx']) [data-file-type=spreadsheet] [data-file-extension=XLSX]") }
        expect "presentation-identity" { visible = css("[data-file-manager-item]:has(strong[title='release-review.pptx']) [data-file-type=presentation] [data-file-extension=PPTX]") }
        expect "pdf-identity" { visible = css("[data-file-manager-item]:has(strong[title='visual-acceptance-report.pdf']) [data-file-type=pdf] [data-file-extension=PDF]") }
        expect "image-identity" { visible = css("[data-file-manager-item]:has(strong[title='device-shell-review.png']) [data-file-type=image] [data-file-extension=PNG]") }
        expect "favorite-is-contained" { visible = css("[data-file-manager-item]:has(strong[title='release-readiness.md']) [data-file-favorite] svg[data-favorite][data-icon=heart]") }
        screenshot "desktop-list" { path = "product/files-icon-identity-list.png" }

        click "grid-view" { target = role("button", "图标视图") }
        expect "grid-icon-scale" { visible = css("[data-file-manager-viewport][data-view=grid] [data-file-icon-size=grid][data-file-type=folder]") }
        screenshot "desktop-grid" { path = "product/files-icon-identity-desktop.png" }
        double_click "open-image-preview" { target = css("[data-file-manager-item]:has(strong[title='device-shell-review.png'])") }
        expect "preview-dialog-boundary" { visible = css("dialog[data-file-preview-dialog][open]") }
        expect "preview-keeps-image-identity" { visible = css("[data-file-manager-quicklook] [data-file-icon-size=preview][data-file-type=image] [data-file-extension=PNG]") }
        click "enter-preview-fullscreen" { target = role("button", "全屏预览") }
        expect "preview-fullscreen-state" { visible = css("dialog[data-file-preview-dialog][data-fullscreen=true] button[aria-label='退出全屏预览'][aria-pressed=true]") }
        click "exit-preview-fullscreen" { target = role("button", "退出全屏预览") }
        expect "preview-windowed-state" { visible = css("dialog[data-file-preview-dialog][data-fullscreen=false] button[aria-label='全屏预览'][aria-pressed=false]") }
        screenshot "quick-look" { path = "product/files-icon-identity-quick-look.png" }
        click "close-preview" { target = role("button", "关闭文件预览") }
        click "list-view-after-preview" { target = role("button", "列表视图") }
        expect "list-view-restored" { visible = css("[data-file-manager-viewport][data-view=list] [data-file-icon-size=list][data-file-type=folder]") }
        click "grid-view-after-preview" { target = role("button", "图标视图") }
        click "clear-selection" { target = role("button", "清除选择") }

        click "open-account-menu" { target = role("button", "本地用户") }
        click "enable-dark-appearance" { target = role("menuitemcheckbox", "深色外观") }
        expect "dark-manager" { visible = css("html.dark .product-file-manager") }
        press "close-account-menu" { key = "Escape" }
        expect "account-trigger-restored" { visible = css(".product-sidebar__footer > button[aria-expanded=false]:focus") }
        screenshot "desktop-dark" { path = "product/files-icon-identity-dark.png" }

        viewport "mobile" { width = 390 height = 844 }
        expect "mobile-grid-identity" { visible = css("[data-file-manager-viewport][data-view=grid] [data-file-icon-size=grid][data-file-type=folder]") }
        screenshot "mobile-dark" { path = "product/files-icon-identity-mobile-dark.png" }
        accessibility "tree" { path = "product/files-icon-identity-accessibility.json" interactive = true }
        console "console" { path = "product/files-icon-identity-console.json" clear = false }
        page_errors "page-errors" { path = "product/files-icon-identity-page-errors.json" clear = false }
    }

    scenario "knowledge-library-recovery" {
        name = "Knowledge library management exposes a failed update and its recovery without losing the usable version"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/knowledge.html" }
        wait "loaded" { load = "networkidle" }
        wait "library-ready" { visible = css(".product-knowledge-library[data-knowledge-library-initialized=true][data-layout=wide]") }
        expect "initial-detail-visible" { visible = css(".product-knowledge-library [data-knowledge-library-detail]") }
        click "show-attention" { target = css(".product-knowledge-library [data-knowledge-filter=attention]") }
        click "select-failed-library" { target = css(".product-knowledge-library [data-knowledge-library-item][data-phase=failed]") }
        expect "failed-detail-visible" { visible = css(".product-knowledge-library [data-knowledge-compilation][data-phase=failed] [role=alert]") }
        expect "recovery-action-visible" { visible = css(".product-knowledge-library [data-knowledge-compilation][data-phase=failed] button") }

        screenshot "failed-desktop-evidence" { path = "product/knowledge-library-failed-desktop.png" }
        click "retry-update" { target = role("button", "再次更新") }
        expect "retry-queued" { visible = css(".product-knowledge-library [data-knowledge-compilation][data-phase=queued]") }
        expect "previous-error-retained-during-retry" { visible = css(".product-knowledge-library [data-knowledge-compilation][data-phase=queued] [role=status]") }
        wait "recovery-complete" { visible = css(".product-knowledge-library [data-knowledge-compilation][data-phase=succeeded]") }
        click "open-recovered-sources" { target = role("tab", "来源") }
        expect "source-tab-complete" { visible = css(".product-knowledge-library [role=tab][aria-selected=true][tabindex='0'][aria-controls$='-sources-panel']") }
        expect "skipped-source-recovered" { visible = css(".product-knowledge-library [data-source-id=missing] [data-source-status=indexed]") }
        expect "all-source-states-consistent" { visible = css(".product-knowledge-library [data-knowledge-sources]:not(:has([data-source-status=pending])):not(:has([data-source-status=skipped]))") }
        screenshot "recovered-desktop-evidence" { path = "product/knowledge-library-recovered-desktop.png" }

        viewport "mobile" { width = 390 height = 844 }
        expect "mobile-detail-visible" { visible = css(".product-knowledge-library [data-knowledge-library-detail] button[aria-label='关闭知识库详情']") }
        screenshot "mobile-evidence" { path = "product/knowledge-library-recovery-mobile.png" }
        click "close-detail" { target = css(".product-knowledge-library [data-knowledge-library-detail] button[aria-label='关闭知识库详情']") }
        expect "library-list-restored" { visible = css(".product-knowledge-library [data-knowledge-library-group]") }
        console "console" { path = "product/knowledge-library-console.json" clear = false }
        page_errors "page-errors" { path = "product/knowledge-library-page-errors.json" clear = false }
    }

    scenario "knowledge-source-management" {
        name = "Knowledge sources can be added, reindexed, and disconnected without deleting workspace files"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1478 height = 900 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/knowledge.html" }
        wait "loaded" { load = "networkidle" }
        wait "library-ready" { visible = css(".product-knowledge-library [data-knowledge-library-detail]") }
        click "open-sources" { target = role("tab", "来源") }
        expect "sources-selected" { visible = css(".product-knowledge-library [role=tab][aria-selected=true][tabindex='0'][aria-controls$='-sources-panel']") }
        press "move-to-settings" { key = "ArrowRight" }
        expect "settings-selected-and-focused" { visible = css(".product-knowledge-library [role=tab][aria-selected=true][tabindex='0'][aria-controls$='-settings-panel']:focus") }
        press "return-to-sources" { key = "ArrowLeft" }
        expect "sources-selected-and-focused" { visible = css(".product-knowledge-library [role=tab][aria-selected=true][tabindex='0'][aria-controls$='-sources-panel']:focus") }

        click "open-source-form" { target = role("button", "添加来源") }
        expect "source-path-focused" { visible = css(".product-knowledge-library [data-knowledge-source-form] input[aria-label='来源路径']:focus") }
        fill "invalid-source-path" { target = css(".product-knowledge-library [data-knowledge-source-form] input[aria-label='来源路径']") value = "../private" }
        click "submit-invalid-source" { target = css(".product-knowledge-library [data-knowledge-source-form] button[type=submit]") }
        expect "source-validation" { visible = css(".product-knowledge-library [data-knowledge-source-form] [role=alert]") }
        fill "valid-source-path" { target = css(".product-knowledge-library [data-knowledge-source-form] input[aria-label='来源路径']") value = "/workspace/docs/product-notes" }
        fill "source-name" { target = css(".product-knowledge-library [data-knowledge-source-form] input[aria-label='来源显示名称']") value = "Product notes" }
        click "add-source" { target = css(".product-knowledge-library [data-knowledge-source-form] button[type=submit]") }
        expect "source-added-pending" { visible = css(".product-knowledge-library [data-source-path='/workspace/docs/product-notes'] [data-source-status=pending]") }
        expect "add-trigger-focus-restored" { visible = css(".product-knowledge-library [data-knowledge-sources] > header button:focus") }

        click "manage-indexed-source" { target = role("button", "管理 DESIGN.md") }
        expect "source-action-focused" { visible = css(".product-knowledge-library [data-source-id=design] [data-knowledge-source-actions] button:first-of-type:focus") }
        screenshot "source-actions-evidence" { path = "product/knowledge-source-actions-desktop.png" }
        click "mark-for-reindex" { target = role("button", "下次更新时重新索引") }
        expect "source-marked-pending" { visible = css(".product-knowledge-library [data-source-id=design] [data-source-status=pending]") }
        expect "manage-trigger-focus-restored" { visible = css(".product-knowledge-library button[aria-label='管理 DESIGN.md']:focus") }

        click "manage-added-source" { target = role("button", "管理 Product notes") }
        click "request-remove-connection" { target = role("button", "移除关联") }
        expect "safe-removal-copy" { text = "工作空间中的原文件会保留" }
        expect "cancel-removal-focused" { visible = css(".product-knowledge-library [data-source-remove-confirmation] button:first-of-type:focus") }
        screenshot "remove-confirmation-evidence" { path = "product/knowledge-source-removal-desktop.png" }
        click "confirm-remove-connection" { target = role("button", "确认移除") }
        expect "source-disconnected" { visible = css(".product-knowledge-library [data-knowledge-sources]:not(:has([data-source-path='/workspace/docs/product-notes']))") }
        expect "stable-focus-after-removal" { visible = css(".product-knowledge-library [data-knowledge-sources] > header button:focus") }

        viewport "mobile" { width = 390 height = 844 }
        click "reopen-source-form" { target = role("button", "添加来源") }
        expect "mobile-form-focused" { visible = css(".product-knowledge-library [data-knowledge-source-form] input[aria-label='来源路径']:focus") }
        screenshot "mobile-source-form" { path = "product/knowledge-source-form-mobile.png" }
        press "close-form-with-escape" { key = "Escape" }
        expect "mobile-add-trigger-restored" { visible = css(".product-knowledge-library [data-knowledge-sources] > header button:focus") }

        screenshot "mobile-evidence" { path = "product/knowledge-source-management-mobile.png" }
        console "console" { path = "product/knowledge-source-management-console.json" clear = false }
        page_errors "page-errors" { path = "product/knowledge-source-management-page-errors.json" clear = false }
    }

    scenario "knowledge-context-to-task" {
        name = "Knowledge context survives the route transition into a new task and clears after task creation"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/knowledge.html" }
        wait "loaded" { load = "networkidle" }
        wait "library-ready" { visible = css(".product-knowledge-library[data-knowledge-library-initialized=true]") }
        expect "detail-ready" { visible = css(".product-knowledge-library [data-knowledge-library-detail]") }
        click "use-in-task" { target = role("button", "引用到任务") }

        wait "task-route" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "composer-ready" { visible = css(".product-start [role=textbox][aria-label='任务指令']") }
        expect "knowledge-resource-preserved" { visible = css(".product-start [data-composer-resources] [data-resource-id^='knowledge:']") }
        expect "knowledge-prompt-preserved" { text = "并为关键结论标注可追溯来源" }
        expect "workspace-preserved" { visible = css(".product-start [data-context-workspace] button") }
        click "create-task" { target = role("button", "发送任务") }

        wait "created-route" { url = "http://127.0.0.1:4178/UI/playground/sessions/current.html" }
        wait "created-session" { visible = css("[data-product-surface=session][data-session-state=ready][data-variant=created]") }
        click "start-another-task" { target = css(".product-sidebar__primary > a:first-of-type") }
        wait "clean-task-route" { url = "http://127.0.0.1:4178/UI/playground.html" }
        expect "pending-draft-cleared" { visible = css(".product-start .product-composer:not(:has([data-resource-id^='knowledge:']))") }
        expect "clean-composer-disabled" { visible = css(".product-start button[aria-label='发送任务']:disabled") }

        screenshot "desktop-evidence" { path = "product/knowledge-context-to-task.png" }
        console "console" { path = "product/knowledge-context-to-task-console.json" clear = false }
        page_errors "page-errors" { path = "product/knowledge-context-to-task-page-errors.json" clear = false }
    }

    scenario "inspiration-gallery-to-task" {
        name = "Inspiration keeps a dense gallery, focused detail, and usable task handoff across viewports"
        surface = "web"
        timeout_ms = 60000
        viewport "desktop" { width = 1478 height = 852 }

        navigate "open" { url = "http://127.0.0.1:4178/UI/playground/resources/inspiration.html" }
        wait "loaded" { load = "networkidle" }
        expect "inspiration-surface-boundary" { visible = css("[data-product-surface=inspiration]") }
        wait "gallery-ready" { visible = css(".product-inspiration__gallery article:nth-child(4)") }
        expect "all-category-selected" { visible = css(".product-inspiration__categories button[aria-pressed=true]") }
        expect "favorites-filter-idle" { visible = css(".product-inspiration > header button[aria-pressed=false]") }
        screenshot "desktop-gallery" { path = "product/inspiration-gallery-desktop.png" }

        click "open-personal-workbench" { target = role("button", "打开个人工作台") }
        expect "focused-detail" { visible = css(".product-inspiration__detail[open][aria-labelledby='product-inspiration-detail-title']") }
        expect "detail-preview" { visible = css(".product-inspiration__detail [data-inspiration-detail-preview] [data-preview=workbench]") }
        click "favorite-detail" { target = css(".product-inspiration__detail button[aria-label='收藏个人工作台']") }
        expect "favorite-selected" { visible = css(".product-inspiration__detail button[aria-pressed=true][aria-label='取消收藏个人工作台']") }
        screenshot "desktop-detail" { path = "product/inspiration-detail-desktop.png" }

        viewport "mobile" { width = 390 height = 844 }
        expect "mobile-detail-controls" { visible = css(".product-inspiration__detail[open] > footer button[data-primary]") }
        screenshot "mobile-detail" { path = "product/inspiration-detail-mobile.png" }

        click "create-task" { target = role("button", "一键创建任务") }
        wait "task-route" { url = "http://127.0.0.1:4178/UI/playground.html" }
        wait "composer-ready" { visible = css(".product-start [role=textbox][aria-label='任务指令']") }
        expect "inspiration-resource-preserved" { visible = css(".product-start [data-composer-resources] [data-resource-id='inspiration:personal-workbench']") }
        expect "inspiration-prompt-preserved" { text = "以“个人工作台”为起点" }
        screenshot "task-handoff" { path = "product/inspiration-task-handoff-mobile.png" }

        console "console" { path = "product/inspiration-gallery-console.json" clear = false }
        page_errors "page-errors" { path = "product/inspiration-gallery-page-errors.json" clear = false }
    }
}
