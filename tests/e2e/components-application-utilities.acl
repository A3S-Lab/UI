        expect "phone-submit-visible" { visible = css(".a3s-preview[data-preview-component=task-start] .task-start button[type=submit]") }
        screenshot "task-start-phone" { path = "components/task-start-phone.png" }
    }

    scenario "task-plan" {
        name = "Task Plan exposes ordered progress and keeps its active step readable on phones"
