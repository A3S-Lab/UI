        surface = "web"
        timeout_ms = 60000
        navigate "open-home" { url = "http://127.0.0.1:4178/UI/en/" }
        wait "home-loaded" { load = "networkidle" }
        wait "home-ready" { visible = css("html:not([data-a3s-defer-init])") }
        click "force-light" { target = css("[data-theme-appearance=light]") }
        expect "light-ready" { visible = css("html:not(.dark):not(.rp-dark)") }
        navigate "open-component" { url = "http://127.0.0.1:4178/UI/en/components/theme-switcher.html" }
        wait "component-loaded" { load = "networkidle" }
        wait "component-ready" { visible = css("html:not([data-a3s-defer-init])") }
        click "toggle-theme" { target = css(".a3s-preview[data-preview-component=theme-switcher] button[aria-label='Toggle dark mode']") }
        expect "dark-applied" { visible = css("html.dark.rp-dark") }
        screenshot "theme-switcher" { path = "components/theme-switcher.png" }
    }

    scenario "file-explorer" {
        name = "File Explorer preserves selection through filtering and recovers an invalid inline rename"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/file-explorer.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "explorer-ready" { visible = css(".a3s-preview[data-preview-component=file-explorer] .file-explorer[data-state=ready]") }
        expect "tree-ready" { visible = css(".a3s-preview[data-preview-component=file-explorer] .tree[data-tree-initialized=true]") }
        fill "filter-status-files" { target = css("#file-explorer-demo-en [data-file-explorer-search]") value = "status" }
        expect "filter-result-visible" { visible = css("#file-explorer-demo-en[data-filter=results] [data-value='src/components/Status.tsx']:not([hidden])") }
        fill "clear-status-filter" { target = css("#file-explorer-demo-en [data-file-explorer-search]") value = "" }
        expect "collapsed-branch-restored" { visible = css("#file-explorer-demo-en [data-value=tests][aria-expanded=false]:not([hidden])") }
        click "select-status-file" { target = css(".a3s-preview[data-preview-component=file-explorer] [data-value='src/components/Status.tsx'] > [data-tree-row]") }
        expect "status-file-selected" { visible = css(".a3s-preview[data-preview-component=file-explorer] [data-value='src/components/Status.tsx'][aria-selected=true]") }
        focus "focus-status-file" { target = css(".a3s-preview[data-preview-component=file-explorer] [data-value='src/components/Status.tsx']") }
        press "open-file-menu" { key = "Shift+F10" }
        expect "file-menu-open" { visible = css(".a3s-preview[data-preview-component=file-explorer] [data-context-content][aria-hidden=false]") }
        click "rename-status-file" { target = css("#file-explorer-demo-en [data-context-content] [data-value=rename]") }
        fill "enter-invalid-name" { target = css("#file-explorer-demo-en [data-file-editor]") value = "bad/name.tsx" }
        press "reject-invalid-name" { key = "Enter" }
        expect "rename-error-visible" { visible = css("#file-explorer-demo-en [data-rename-state=error] [data-file-editor][aria-invalid=true]") }
        fill "recover-valid-name" { target = css("#file-explorer-demo-en [data-file-editor]") value = "Health.tsx" }
        press "commit-valid-name" { key = "Enter" }
        expect "renamed-file-visible" { text = "Health.tsx" }
        expect "file-focus-restored" { visible = css(".a3s-preview[data-preview-component=file-explorer] [data-value='src/components/Status.tsx']:focus") }
        viewport "phone" { width = 390 height = 844 }
        expect "phone-explorer-visible" { visible = css(".a3s-preview[data-preview-component=file-explorer] .file-explorer") }
    }

    scenario "file-manager" {
        name = "File Manager filters, selects, previews, and changes view without losing its workspace boundary"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/file-manager.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "manager-ready" { visible = css("#file-manager-demo-en[data-file-manager-initialized=true][data-state=ready]") }
        fill "filter-report" { target = css("#file-manager-demo-en [data-file-manager-search] input") value = "visual" }
        expect "report-visible" { visible = css("#file-manager-demo-en [data-file-value=report]:not([hidden])") }
        fill "clear-filter" { target = css("#file-manager-demo-en [data-file-manager-search] input") value = "" }
        click "select-design" { target = css("#file-manager-demo-en [data-file-value=design]") }
        expect "design-selected" { visible = css("#file-manager-demo-en [data-file-value=design][aria-selected=true]") }
        click "open-quick-look" { target = css("#file-manager-demo-en [data-file-action=preview]") }
        expect "quick-look-visible" { visible = css("#file-manager-demo-en [data-file-manager-preview]:not([hidden]) [data-preview-for=design]:not([hidden])") }
        click "close-quick-look" { target = css("#file-manager-demo-en [data-file-action=close-preview]") }
        click "switch-grid" { target = css("#file-manager-demo-en [data-file-view=grid]") }
        expect "grid-active" { visible = css("#file-manager-demo-en[data-view=grid] [data-file-manager-viewport][data-view=grid]") }
        viewport "phone" { width = 390 height = 844 }
        expect "phone-manager-visible" { visible = css("#file-manager-demo-en.file-manager") }
        screenshot "file-manager-phone" { path = "components/file-manager-phone.png" }
    }

    scenario "knowledge-library" {
        name = "Knowledge Library filters phases and opens recoverable indexing details"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/knowledge-library.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "library-ready" { visible = css("#knowledge-library-demo-en[data-knowledge-library-initialized=true][data-state=ready]") }
        fill "filter-migration" { target = css("#knowledge-library-demo-en [data-knowledge-library-search] input") value = "migration" }
        expect "migration-visible" { visible = css("#knowledge-library-demo-en [data-knowledge-value=migration]:not([hidden])") }
        fill "clear-search" { target = css("#knowledge-library-demo-en [data-knowledge-library-search] input") value = "" }
        click "show-updating" { target = css("#knowledge-library-demo-en [data-knowledge-filter=updating]") }
        expect "release-visible" { visible = css("#knowledge-library-demo-en [data-knowledge-value=release]:not([hidden])") }
        click "show-all" { target = css("#knowledge-library-demo-en [data-knowledge-filter=all]") }
        click "select-migration" { target = css("#knowledge-library-demo-en [data-knowledge-value=migration]") }
        expect "migration-selected" { visible = css("#knowledge-library-demo-en [data-knowledge-value=migration][aria-selected=true]") }
        expect "failure-recovery-visible" { visible = css("#knowledge-library-demo-en [data-knowledge-detail-for=migration]:not([hidden]) [data-knowledge-action=retry]") }
        viewport "phone" { width = 390 height = 844 }
        expect "phone-library-visible" { visible = css("#knowledge-library-demo-en.knowledge-library") }
        screenshot "knowledge-library-phone" { path = "components/knowledge-library-phone.png" }
    }
}
