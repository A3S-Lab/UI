        focus "focus-language" { target = css(".a3s-preview[data-preview-component=setting-row] select[aria-label=Language]") }
        expect "language-focused" { visible = css(".a3s-preview[data-preview-component=setting-row] select[aria-label=Language]:focus") }
        viewport "phone" { width = 390 height = 844 }
        expect "phone-control-visible" { visible = css(".a3s-preview[data-preview-component=setting-row] .setting-row [data-setting-control]") }
        screenshot "setting-row-phone" { path = "components/setting-row-phone.png" }
    }

    scenario "task-start" {
        name = "Task Start keeps suggestions and the first instruction in one responsive flow"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/task-start.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "suggestions-visible" { visible = css(".a3s-preview[data-preview-component=task-start] .task-start [data-task-suggestions] button") }
        expect "composer-visible" { visible = css(".a3s-preview[data-preview-component=task-start] .task-start form.agent-composer") }
        focus "focus-instruction" { target = css(".a3s-preview[data-preview-component=task-start] .task-start textarea[aria-label=Instruction]") }
