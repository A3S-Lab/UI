suite "a3s-ui-application-and-utilities" {
    version = 1

    scenario "app-shell" {
        name = "App Shell collapses navigation, covers ready through mobile-open matrix, and confirms Chinese title"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/app-shell.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=app-shell][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-app-shell-primary-demo=en].app-shell[data-navigation=expanded]") }
        expect "title-copy" { text = "Design system workspace" }
        expect "current-nav-visible" { visible = css("[data-app-shell-primary-demo=en] [data-app-nav-current][aria-current=page]") }
        focus "focus-collapse-navigation" { target = css("[data-app-shell-primary-demo=en] [data-app-navigation-trigger]") }
        press "collapse-navigation" { key = "Enter" }
        expect "shell-collapsed" { visible = css("[data-app-shell-primary-demo=en].app-shell[data-navigation=collapsed]") }
        screenshot "app-shell-desktop" { path = "components/app-shell-desktop.png" }

        viewport "compact" { width = 768 height = 900 }
        wait "compact-toggle-ready" { visible = css("[data-app-shell-primary-demo=en] [data-app-navigation-trigger][aria-expanded=false][aria-label='Open navigation']") }
        expect "compact-toggle-updated" { visible = css("[data-app-shell-primary-demo=en] [data-app-navigation-trigger][aria-expanded=false][aria-label='Open navigation']") }
        navigate "reopen-compact" { url = "http://127.0.0.1:4178/UI/en/components/app-shell.html" }
        wait "compact-loaded" { load = "networkidle" }
        wait "compact-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "compact-preview-ready" { visible = css(".a3s-preview[data-preview-component=app-shell][data-preview-integration=complete][data-preview-source=ready]") }
        expect "compact-navigation-closed" { visible = css("[data-app-shell-primary-demo=en] [data-app-navigation-trigger][aria-expanded=false][aria-label='Open navigation']") }
        focus "focus-open-compact-navigation" { target = css("[data-app-shell-primary-demo=en] [data-app-navigation-trigger]") }
        press "open-compact-navigation" { key = "Enter" }
        wait "wait-compact-navigation-open" { visible = css("[data-app-shell-primary-demo=en].app-shell[data-mobile-navigation=open] [data-app-navigation]") }
        expect "compact-navigation-open" { visible = css("[data-app-shell-primary-demo=en].app-shell[data-mobile-navigation=open] [data-app-navigation]") }
        expect "compact-main-inert" { visible = css("[data-app-shell-primary-demo=en] [data-app-main][inert][aria-hidden=true]") }
        wait "wait-compact-navigation-focused" { visible = css("[data-app-shell-primary-demo=en] [data-app-navigation] a:first-of-type:focus") }
        expect "compact-navigation-focused" { visible = css("[data-app-shell-primary-demo=en] [data-app-navigation] a:first-of-type:focus") }
        press "close-compact-navigation" { key = "Escape" }
        expect "compact-main-restored" { visible = css("[data-app-shell-primary-demo=en] [data-app-main]:not([inert]):not([aria-hidden])") }
        expect "compact-navigation-restored" { visible = css("[data-app-shell-primary-demo=en].app-shell:not([data-mobile-navigation=open]) [data-app-navigation-trigger]:focus") }
        screenshot "app-shell-compact" { path = "components/app-shell-compact.png" }

        viewport "restore-desktop" { width = 1440 height = 1000 }
        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=app-shell][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=app-shell]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=app-shell] [data-state-specimen=ready]") }
        expect "state-specimen-expanded" { visible = css(".a3s-component-state-matrix[open][data-component=app-shell] [data-state-specimen=expanded]") }
        expect "state-specimen-collapsed" { visible = css(".a3s-component-state-matrix[open][data-component=app-shell] [data-state-specimen=collapsed]") }
        expect "state-specimen-hidden" { visible = css(".a3s-component-state-matrix[open][data-component=app-shell] [data-state-specimen=hidden]") }
        expect "state-specimen-mobile-open" { visible = css(".a3s-component-state-matrix[open][data-component=app-shell] [data-state-specimen=mobile-open]") }
        screenshot "app-shell-states" { path = "components/app-shell-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=app-shell][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/app-shell.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-app-shell-primary-demo=zh] [data-app-shell-title]") }
        expect "chinese-title" { text = "设计系统工作区" }
        expect "chinese-nav-toggle" { visible = css("[data-app-shell-primary-demo=zh] [data-app-navigation-trigger][aria-expanded=false]") }
        focus "focus-chinese-nav" { target = css("[data-app-shell-primary-demo=zh] [data-app-navigation-trigger]") }
        press "open-chinese-nav" { key = "Enter" }
        wait "chinese-nav-open" { visible = css("[data-app-shell-primary-demo=zh].app-shell[data-mobile-navigation=open] [data-app-nav-current][aria-current=page]") }
        expect "chinese-nav-visible" { visible = css("[data-app-shell-primary-demo=zh].app-shell[data-mobile-navigation=open] [data-app-nav-current][aria-current=page]") }
        expect "chinese-workspace-label" { text = "工作区" }
        screenshot "app-shell-chinese-phone" { path = "components/app-shell-chinese-phone.png" }
        accessibility "app-shell-accessibility" { path = "components/app-shell-accessibility.json" interactive = true }
        console "app-shell-console" { path = "components/app-shell-console.json" clear = false }
        page_errors "app-shell-errors" { path = "components/app-shell-errors.json" clear = false }
    }

    scenario "task-workspace" {
        name = "Task Workspace opens attach, covers ready through inspector-open matrix, and confirms Chinese title"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/task-workspace.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=task-workspace][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-task-workspace-primary-demo=en].task-workspace") }
        expect "title-copy" { text = "Release readiness review" }
        expect "transcript-visible" { visible = css("[data-task-workspace-primary-demo=en] [data-transcript-viewport] > li[data-role=agent]") }
        expect "inspector-visible" { visible = css("[data-task-workspace-primary-demo=en] [data-task-inspector] [data-task-inspector-title]") }
        click "open-attach" { target = css("[data-task-workspace-primary-demo=en] [data-task-attach]") }
        expect "attach-opened" { visible = css("[data-task-workspace-primary-demo=en][data-attach-opened=true] [data-task-attach][aria-pressed=true]") }
        screenshot "task-workspace-desktop" { path = "components/task-workspace-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=task-workspace][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=task-workspace]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=task-workspace] [data-state-specimen=ready]") }
        expect "state-specimen-streaming" { visible = css(".a3s-component-state-matrix[open][data-component=task-workspace] [data-state-specimen=streaming]") }
        expect "state-specimen-waiting" { visible = css(".a3s-component-state-matrix[open][data-component=task-workspace] [data-state-specimen=waiting]") }
        expect "state-specimen-complete" { visible = css(".a3s-component-state-matrix[open][data-component=task-workspace] [data-state-specimen=complete]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=task-workspace] [data-state-specimen=error]") }
        expect "state-specimen-inspector-open" { visible = css(".a3s-component-state-matrix[open][data-component=task-workspace] [data-state-specimen=inspector-open]") }
        screenshot "task-workspace-states" { path = "components/task-workspace-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=task-workspace][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/task-workspace.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-task-workspace-primary-demo=zh] [data-task-workspace-title]") }
        expect "chinese-title" { text = "发布就绪审查" }
        expect "chinese-inspector-closed" { visible = css("[data-task-workspace-primary-demo=zh] [data-task-inspector-trigger][aria-expanded=false][aria-controls='task-workspace-changes-zh']") }
        click "open-chinese-inspector" { target = css("[data-task-workspace-primary-demo=zh] [data-task-inspector-trigger]") }
        expect "chinese-inspector-open" { visible = css("[data-task-workspace-primary-demo=zh].task-workspace[data-inspector=open] [data-task-inspector]:not([inert])") }
        press "close-chinese-inspector" { key = "Escape" }
        expect "chinese-inspector-focus-restored" { visible = css("[data-task-workspace-primary-demo=zh].task-workspace:not([data-inspector=open]) [data-task-inspector-trigger]:focus") }
        screenshot "task-workspace-chinese-phone" { path = "components/task-workspace-chinese-phone.png" }
        accessibility "task-workspace-accessibility" { path = "components/task-workspace-accessibility.json" interactive = true }
        console "task-workspace-console" { path = "components/task-workspace-console.json" clear = false }
        page_errors "task-workspace-errors" { path = "components/task-workspace-errors.json" clear = false }
    }

    scenario "agent-workbench" {
        name = "Agent Workbench builds a release, covers ready through context-open matrix, and confirms Chinese title"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/agent-workbench.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=agent-workbench][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-agent-workbench-primary-demo=en].agent-workbench") }
        expect "title-copy" { text = "Agent context" }
        expect "context-visible" { visible = css("[data-agent-workbench-primary-demo=en] [data-agent-context]") }
        expect "canvas-visible" { visible = css("[data-agent-workbench-primary-demo=en] article[data-agent-canvas]") }
        expect "inspector-visible" { visible = css("[data-agent-workbench-primary-demo=en] [data-agent-inspector]") }
        expect "activity-visible" { visible = css("[data-agent-workbench-primary-demo=en] [data-agent-activity]") }
        select "choose-provider" {
            target = css("[data-agent-workbench-primary-demo=en] [data-agent-provider]")
            values = ["a3s-code-0.9.0"]
        }
        expect "provider-selected" { visible = css("[data-agent-workbench-primary-demo=en][data-provider-selected='a3s-code-0.9.0'] [data-agent-provider]:has(option[value='a3s-code-0.9.0']:checked)") }
        click "build-release" { target = css("[data-agent-workbench-primary-demo=en] [data-agent-build-release]") }
        expect "release-built" { visible = css("[data-agent-workbench-primary-demo=en][data-release-built=true] [data-agent-activity-status][data-state=success]") }
        expect "built-status" { text = "Built" }
        screenshot "agent-workbench-desktop" { path = "components/agent-workbench-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=agent-workbench][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench] [data-state-specimen=ready]") }
        expect "state-specimen-running" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench] [data-state-specimen=running]") }
        expect "state-specimen-waiting" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench] [data-state-specimen=waiting]") }
        expect "state-specimen-complete" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench] [data-state-specimen=complete]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench] [data-state-specimen=error]") }
        expect "state-specimen-inspector-open" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench] [data-state-specimen=inspector-open]") }
        expect "state-specimen-context-open" { visible = css(".a3s-component-state-matrix[open][data-component=agent-workbench] [data-state-specimen=context-open]") }
        screenshot "agent-workbench-states" { path = "components/agent-workbench-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=agent-workbench][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/agent-workbench.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-agent-workbench-primary-demo=zh] [data-agent-workbench-title]") }
        expect "chinese-title" { text = "Agent 上下文" }
        click "build-chinese-release" { target = css("[data-agent-workbench-primary-demo=zh] [data-agent-build-release]") }
        expect "chinese-release-built" { visible = css("[data-agent-workbench-primary-demo=zh][data-release-built=true] [data-agent-activity-status][data-state=success]") }
        expect "chinese-built-status" { text = "已构建" }
        screenshot "agent-workbench-chinese-phone" { path = "components/agent-workbench-chinese-phone.png" }
        accessibility "agent-workbench-accessibility" { path = "components/agent-workbench-accessibility.json" interactive = true }
        console "agent-workbench-console" { path = "components/agent-workbench-console.json" clear = false }
        page_errors "agent-workbench-errors" { path = "components/agent-workbench-errors.json" clear = false }
    }

    scenario "agent-composer" {
        name = "Agent Composer stops a streaming task, covers ready through invalid matrix, and confirms Chinese status"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/agent-composer.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=agent-composer][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-agent-composer-primary-demo=en].agent-composer[data-state=streaming]") }
        expect "status-copy" { text = "A task is running. New instructions will be queued." }
        expect "resources-visible" { visible = css("[data-agent-composer-primary-demo=en] [data-composer-resources] > li") }
        expect "queue-visible" { visible = css("[data-agent-composer-primary-demo=en] [data-composer-queue] > ol > li") }
        focus "focus-instruction" { target = css("[data-agent-composer-primary-demo=en] [data-composer-input][aria-label='Task instruction']") }
        expect "instruction-focused" { visible = css("[data-agent-composer-primary-demo=en] [data-composer-input][aria-label='Task instruction']:focus") }
        click "stop-streaming" { target = css("[data-agent-composer-primary-demo=en] [data-composer-action=stop]") }
        expect "composer-ready" { visible = css("[data-agent-composer-primary-demo=en].agent-composer[data-state=ready][data-composer-stopped=true]") }
        expect "stopped-status" { visible = css("[data-agent-composer-primary-demo=en][data-composer-stopped=true] [data-composer-status]") }
        screenshot "agent-composer-desktop" { path = "components/agent-composer-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=agent-composer][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=ready]") }
        expect "state-specimen-submitting" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=submitting]") }
        expect "state-specimen-streaming" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=streaming]") }
        expect "state-specimen-queued" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=queued]") }
        expect "state-specimen-stopping" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=stopping]") }
        expect "state-specimen-offline" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=offline]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=error]") }
        expect "state-specimen-disabled" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=disabled]") }
        expect "state-specimen-invalid" { visible = css(".a3s-component-state-matrix[open][data-component=agent-composer] [data-state-specimen=invalid]") }
        screenshot "agent-composer-states" { path = "components/agent-composer-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=agent-composer][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/agent-composer.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-agent-composer-primary-demo=zh].agent-composer[data-state=streaming]") }
        expect "chinese-status" { text = "当前任务正在运行，新指令将进入队列。" }
        click "stop-chinese-streaming" { target = css("[data-agent-composer-primary-demo=zh] [data-composer-action=stop]") }
        expect "chinese-composer-ready" { visible = css("[data-agent-composer-primary-demo=zh].agent-composer[data-state=ready][data-composer-stopped=true]") }
        expect "chinese-stopped-status" { visible = css("[data-agent-composer-primary-demo=zh][data-composer-stopped=true] [data-composer-status]") }
        screenshot "agent-composer-chinese-phone" { path = "components/agent-composer-chinese-phone.png" }
        accessibility "agent-composer-accessibility" { path = "components/agent-composer-accessibility.json" interactive = true }
        console "agent-composer-console" { path = "components/agent-composer-console.json" clear = false }
        page_errors "agent-composer-errors" { path = "components/agent-composer-errors.json" clear = false }
    }

    scenario "agent-transcript" {
        name = "Agent Transcript jumps to latest, covers ready through empty matrix, and confirms Chinese title"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/agent-transcript.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=agent-transcript][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-agent-transcript-primary-demo=en].agent-transcript") }
        expect "title-copy" { text = "Cancellation test" }
        expect "user-turn-visible" { visible = css("[data-agent-transcript-primary-demo=en] [data-transcript-viewport] > li[data-role=user]") }
        expect "agent-turn-visible" { visible = css("[data-agent-transcript-primary-demo=en] [data-transcript-viewport] > li[data-role=agent]") }
        expect "system-turn-visible" { visible = css("[data-agent-transcript-primary-demo=en] [data-transcript-viewport] > li[data-role=system]") }
        expect "execution-visible" { visible = css("[data-agent-transcript-primary-demo=en] details.execution-item") }
        click "jump-to-latest" { target = css("[data-agent-transcript-primary-demo=en] [data-transcript-jump]") }
        expect "jumped" { visible = css("[data-agent-transcript-primary-demo=en][data-jumped=true] [data-transcript-viewport]:focus") }
        expect "jumped-status" { text = "Showing latest turn" }
        screenshot "agent-transcript-desktop" { path = "components/agent-transcript-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=agent-transcript][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=agent-transcript]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=agent-transcript] [data-state-specimen=ready]") }
        expect "state-specimen-streaming" { visible = css(".a3s-component-state-matrix[open][data-component=agent-transcript] [data-state-specimen=streaming]") }
        expect "state-specimen-waiting" { visible = css(".a3s-component-state-matrix[open][data-component=agent-transcript] [data-state-specimen=waiting]") }
        expect "state-specimen-complete" { visible = css(".a3s-component-state-matrix[open][data-component=agent-transcript] [data-state-specimen=complete]") }
