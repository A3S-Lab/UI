        expect "results-visible" { visible = css(".a3s-preview[data-preview-component=catalog] .catalog [data-catalog-results] .resource-card") }
        focus "focus-search" { target = css(".a3s-preview[data-preview-component=catalog] .catalog input[type=search]") }
