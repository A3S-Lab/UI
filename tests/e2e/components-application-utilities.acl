        expect "title-copy" { text = "Knowledge library" }
        fill "filter-migration" { target = css("[data-knowledge-library-primary-demo=en] [data-knowledge-library-search] input") value = "migration" }
        expect "migration-visible" { visible = css("[data-knowledge-library-primary-demo=en] [data-knowledge-value=migration]:not([hidden])") }
        fill "clear-search" { target = css("[data-knowledge-library-primary-demo=en] [data-knowledge-library-search] input") value = "" }
        focus "focus-show-updating" { target = css("[data-knowledge-library-primary-demo=en] [data-knowledge-filter=updating]") }
        press "show-updating" { key = "Enter" }
