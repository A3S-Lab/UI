        press "select-migration" { key = "Enter" }
        expect "migration-selected" { visible = css("[data-knowledge-library-primary-demo=en] [data-knowledge-value=migration][aria-selected=true]") }
        expect "failure-recovery-visible" { visible = css("[data-knowledge-library-primary-demo=en] [data-knowledge-detail-for=migration]:not([hidden]) [data-knowledge-action=retry]") }
