        expect "state-specimen-empty" { visible = css(".a3s-component-state-matrix[open][data-component=knowledge-library] [data-state-specimen=empty]") }
        expect "state-specimen-partial" { visible = css(".a3s-component-state-matrix[open][data-component=knowledge-library] [data-state-specimen=partial]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=knowledge-library] [data-state-specimen=error]") }
        expect "state-specimen-offline" { visible = css(".a3s-component-state-matrix[open][data-component=knowledge-library] [data-state-specimen=offline]") }
        expect "state-specimen-permission-denied" { visible = css(".a3s-component-state-matrix[open][data-component=knowledge-library] [data-state-specimen=permission-denied]") }
