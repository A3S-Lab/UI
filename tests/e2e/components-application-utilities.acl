    }

    scenario "file-manager" {
        name = "File Manager opens Quick Look, covers ready through readonly matrix, and confirms Chinese title"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/file-manager.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=file-manager][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-file-manager-primary-demo=en].file-manager[data-file-manager-initialized=true][data-state=ready]") }
        expect "title-copy" { text = "Files" }
        fill "filter-report" { target = css("[data-file-manager-primary-demo=en] [data-file-manager-search] input") value = "visual" }
        expect "report-visible" { visible = css("[data-file-manager-primary-demo=en] [data-file-value=report]:not([hidden])") }
        fill "clear-filter" { target = css("[data-file-manager-primary-demo=en] [data-file-manager-search] input") value = "" }
        focus "focus-src" { target = css("[data-file-manager-primary-demo=en] [data-file-value=src]") }
        press "select-design" { key = "ArrowRight" }
        expect "design-selected" { visible = css("[data-file-manager-primary-demo=en] [data-file-value=design][aria-selected=true]") }
        focus "focus-open-quick-look" { target = css("[data-file-manager-primary-demo=en] [data-file-action=preview]") }
        press "open-quick-look" { key = "Enter" }
        wait "quick-look-ready" { visible = css("[data-file-manager-primary-demo=en] [data-file-manager-preview]:not([hidden]) [data-preview-for=design]:not([hidden])") }
        expect "quick-look-visible" { visible = css("[data-file-manager-primary-demo=en] [data-file-manager-preview]:not([hidden]) [data-preview-for=design]:not([hidden])") }
        focus "focus-close-quick-look" { target = css("[data-file-manager-primary-demo=en] [data-file-action=close-preview]") }
        press "close-quick-look" { key = "Enter" }
        focus "focus-switch-grid" { target = css("[data-file-manager-primary-demo=en] [data-file-view=grid]") }
        press "switch-grid" { key = "Enter" }
        expect "grid-active" { visible = css("[data-file-manager-primary-demo=en][data-view=grid] [data-file-manager-viewport][data-view=grid]") }
        screenshot "file-manager-desktop" { path = "components/file-manager-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=file-manager][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=ready]") }
        expect "state-specimen-loading" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=loading]") }
        expect "state-specimen-empty" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=empty]") }
        expect "state-specimen-partial" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=partial]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=error]") }
        expect "state-specimen-offline" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=offline]") }
        expect "state-specimen-permission-denied" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=permission-denied]") }
        expect "state-specimen-readonly" { visible = css(".a3s-component-state-matrix[open][data-component=file-manager] [data-state-specimen=readonly]") }
        screenshot "file-manager-states" { path = "components/file-manager-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=file-manager][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/file-manager.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-file-manager-primary-demo=zh][data-file-manager-initialized=true] [data-file-manager-viewport]") }
        expect "chinese-title" { text = "文件" }
        expect "chinese-primary-demo" { visible = css("[data-file-manager-primary-demo=zh] [data-file-manager-search]") }
        focus "focus-chinese-grid" { target = css("[data-file-manager-primary-demo=zh] [data-file-view=grid]") }
        press "switch-chinese-grid" { key = "Enter" }
        expect "chinese-grid-active" { visible = css("[data-file-manager-primary-demo=zh][data-view=grid] [data-file-manager-viewport][data-view=grid]") }
        expect "chinese-grid-label" { text = "图标" }
        expect "grid-type-below-filename" {
            target = css("[data-file-manager-primary-demo=zh] [data-file-value=design] > span:first-of-type")
            relative_to = css("[data-file-manager-primary-demo=zh] [data-file-value=design] > [data-file-label]")
            layout = "below"
            tolerance_px = 0
        }
        expect "grid-comparison-metadata-hidden" { hidden = css("[data-file-manager-primary-demo=zh] [data-file-value=design] > span:nth-of-type(2)") }
        screenshot "file-manager-chinese-phone" { path = "components/file-manager-chinese-phone.png" }
        accessibility "file-manager-accessibility" { path = "components/file-manager-accessibility.json" interactive = true }
        console "file-manager-console" { path = "components/file-manager-console.json" clear = false }
        page_errors "file-manager-errors" { path = "components/file-manager-errors.json" clear = false }
    }

    scenario "knowledge-library" {
        name = "Knowledge Library opens recoverable indexing details, covers ready through permission-denied matrix, and confirms Chinese title"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/knowledge-library.html" }
