        focus "focus-primary-action" { target = css(".a3s-preview[data-preview-component=app-page] .app-page [data-page-actions] button") }
        expect "primary-action-focused" { visible = css(".a3s-preview[data-preview-component=app-page] .app-page [data-page-actions] button:focus") }
        screenshot "app-page-phone" { path = "components/app-page-phone.png" }
    }

    scenario "catalog" {
