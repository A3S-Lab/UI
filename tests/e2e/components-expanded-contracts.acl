    scenario "table-of-contents" {
        name = "Table of Contents updates the current real anchor"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/table-of-contents.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        focus "focus-contract" { target = css(".a3s-preview[data-preview-component=table-of-contents] a[href='#contract']") }
        press "open-contract" { key = "Enter" }
        expect "contract-current" { visible = css(".a3s-preview[data-preview-component=table-of-contents] a[href='#contract'][aria-current=location]") }
    }
