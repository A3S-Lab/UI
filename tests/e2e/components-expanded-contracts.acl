        click "zoom-in" { target = css("[data-image-viewer-primary-demo=en] [data-image-viewer-action=zoom-in]") }
        expect "zoom-applied" { visible = css("[data-image-viewer-primary-demo=en][style*='--image-viewer-zoom: 1.25']") }
        screenshot "image-viewer-desktop" { path = "components/image-viewer-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=image-viewer][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=image-viewer]") }
        wait "state-specimen-open" { visible = css(".a3s-component-state-matrix[open][data-component=image-viewer] [data-state-specimen=open]") }
        expect "state-specimen-closed" { visible = css(".a3s-component-state-matrix[open][data-component=image-viewer] [data-state-specimen=closed]") }
        expect "state-specimen-loading" { visible = css(".a3s-component-state-matrix[open][data-component=image-viewer] [data-state-specimen=loading]") }
        screenshot "image-viewer-states" { path = "components/image-viewer-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=image-viewer][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/image-viewer.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-image-viewer-primary-demo=zh] [data-image-viewer-action=zoom-in]") }
        expect "chinese-title" { text = "图像预览" }
        expect "chinese-caption" { text = "检查图像而不修改源文件。" }
        click "chinese-zoom-in" { target = css("[data-image-viewer-primary-demo=zh] [data-image-viewer-action=zoom-in]") }
        expect "chinese-zoom-applied" { visible = css("[data-image-viewer-primary-demo=zh][style*='--image-viewer-zoom: 1.25']") }
        screenshot "image-viewer-chinese-phone" { path = "components/image-viewer-chinese-phone.png" }
        accessibility "image-viewer-accessibility" { path = "components/image-viewer-accessibility.json" interactive = true }
        console "image-viewer-console" { path = "components/image-viewer-console.json" clear = false }
        page_errors "image-viewer-errors" { path = "components/image-viewer-errors.json" clear = false }
    }

