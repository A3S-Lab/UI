suite "a3s-ui-expanded-contracts" {
    version = 1

    scenario "back-to-bottom" {
        name = "Back to Bottom exposes unread context and a reachable return action"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/back-to-bottom.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        expect "updates-visible" { visible = css(".a3s-preview[data-preview-component=back-to-bottom] .back-to-bottom[data-state=unread] [data-unread-count]") }
        click "return-to-latest" { target = css(".a3s-preview[data-preview-component=back-to-bottom] .back-to-bottom") }
        expect "return-action-stays-available" { visible = css(".a3s-preview[data-preview-component=back-to-bottom] .back-to-bottom[data-always-visible]") }
    }

    scenario "code-diff" {
        name = "Code Diff preserves addition/removal markers, covers state matrix, and confirms Chinese caption"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/code-diff.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=code-diff][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-code-diff-primary-demo=en] [data-diff-line='+']") }
        expect "removal-visible" { visible = css("[data-code-diff-primary-demo=en] [data-diff-line='-']") }
        expect "caption-copy" { text = "src/session.ts" }
        focus "focus-diff-code" { target = css("[data-code-diff-primary-demo=en] [data-diff-scroller]") }
        expect "diff-code-focused" { visible = css("[data-code-diff-primary-demo=en] [data-diff-scroller]:focus") }
        screenshot "code-diff-desktop" { path = "components/code-diff-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=code-diff][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=code-diff]") }
        wait "state-specimen-ready" { visible = css(".a3s-component-state-matrix[open][data-component=code-diff] [data-state-specimen=ready]") }
        expect "state-specimen-loading" { visible = css(".a3s-component-state-matrix[open][data-component=code-diff] [data-state-specimen=loading]") }
        expect "state-specimen-empty" { visible = css(".a3s-component-state-matrix[open][data-component=code-diff] [data-state-specimen=empty]") }
        screenshot "code-diff-states" { path = "components/code-diff-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=code-diff][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/code-diff.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-code-diff-primary-demo=zh] [data-diff-caption]") }
        expect "chinese-caption" { text = "会话重连差异" }
        screenshot "code-diff-chinese-phone" { path = "components/code-diff-chinese-phone.png" }
        accessibility "code-diff-accessibility" { path = "components/code-diff-accessibility.json" interactive = true }
        console "code-diff-console" { path = "components/code-diff-console.json" clear = false }
        page_errors "code-diff-errors" { path = "components/code-diff-errors.json" clear = false }
    }

    scenario "collapsible" {
        name = "Collapsible keeps native keyboard disclosure, covers state matrix, and confirms Chinese copy"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/collapsible.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=collapsible][data-preview-integration=complete][data-preview-source=ready]") }
        expect "primary-demo" { visible = css("[data-collapsible-primary-demo=en][open] [data-collapsible-content]") }
        expect "open-copy" { text = "The folder is read only until access is approved." }
        focus "focus-summary" { target = css("[data-collapsible-primary-demo=en] [data-collapsible-summary]") }
        press "close-details" { key = "Enter" }
        expect "closed-root" { visible = css("[data-collapsible-primary-demo=en]:not([open])") }
        press "reopen-details" { key = "Enter" }
        expect "content-visible" { visible = css("[data-collapsible-primary-demo=en][open] [data-collapsible-content]") }
        screenshot "collapsible-desktop" { path = "components/collapsible-desktop.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=collapsible][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=collapsible]") }
        wait "state-specimen-open" { visible = css(".a3s-component-state-matrix[open][data-component=collapsible] [data-state-specimen=open]") }
        expect "state-specimen-closed" { visible = css(".a3s-component-state-matrix[open][data-component=collapsible] [data-state-specimen=closed]") }
        screenshot "collapsible-states" { path = "components/collapsible-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=collapsible][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/collapsible.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("[data-collapsible-primary-demo=zh][open] [data-collapsible-summary]") }
        expect "chinese-summary" { text = "为什么需要此权限" }
        focus "focus-chinese-summary" { target = css("[data-collapsible-primary-demo=zh] [data-collapsible-summary]") }
        press "close-chinese" { key = "Enter" }
        expect "chinese-closed" { visible = css("[data-collapsible-primary-demo=zh]:not([open])") }
        screenshot "collapsible-chinese-phone" { path = "components/collapsible-chinese-phone.png" }
        accessibility "collapsible-accessibility" { path = "components/collapsible-accessibility.json" interactive = true }
        console "collapsible-console" { path = "components/collapsible-console.json" clear = false }
        page_errors "collapsible-errors" { path = "components/collapsible-errors.json" clear = false }
    }

    scenario "color-swatches" {
        name = "Color Swatches changes a named native choice"
        surface = "web"
        timeout_ms = 45000
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/color-swatches.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        focus "focus-violet" { target = css(".a3s-preview[data-preview-component=color-swatches] input[aria-label=Violet]") }
        press "choose-violet" { key = "Space" }
        expect "violet-selected" { visible = css(".a3s-preview[data-preview-component=color-swatches] label:has(input[aria-label=Violet]:checked) [data-swatch]") }
    }

    scenario "copy-button" {
        name = "Copy Button preserves keyboard copy, empty rejection, busy duplicate protection, reset, and compact Chinese feedback"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/copy-button.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=copy-button][data-preview-integration=complete][data-preview-source=ready]") }

        expect "canonical-ready-root" { visible = css("button.copy-button[data-copy-primary-demo=en][data-state=ready][data-copy-text]:has([data-copy-label]):has([data-copy-feedback][aria-live=polite])") }

        focus "focus-empty-copy" { target = css("button.copy-button[data-copy-empty-demo=en]") }
        press "activate-empty-copy" { key = "Enter" }
        expect "empty-source-errors" { visible = css("button.copy-button[data-copy-empty-demo=en][data-state=error]:has([data-copy-feedback])") }
        expect "empty-error-feedback" { text = "Copy failed" }
        screenshot "copy-button-empty-error" { path = "components/copy-button-empty-error.png" }

        focus "focus-primary-copy" { target = css("button.copy-button[data-copy-primary-demo=en]") }
        press "activate-primary-copy" { key = "Enter" }
        wait "copied-feedback" { visible = css("button.copy-button[data-copy-primary-demo=en][data-state=copied]:has([data-copy-feedback])") }
        expect "copied-feedback-text" { text = "Copied" }
        click "repeat-while-copied-or-ready" { target = css("button.copy-button[data-copy-primary-demo=en]") }
        wait "ready-after-reset" { visible = css("button.copy-button[data-copy-primary-demo=en][data-state=ready]:not([aria-busy])") }
        screenshot "copy-button-ready-reset" { path = "components/copy-button-ready-reset.png" }

        focus "focus-primary-for-space" { target = css("button.copy-button[data-copy-primary-demo=en]") }
        press "activate-with-space" { key = "Space" }
        wait "space-copied" { visible = css("button.copy-button[data-copy-primary-demo=en][data-state=copied]") }
        screenshot "copy-button-copied" { path = "components/copy-button-copied.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=copy-button][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=copy-button]") }
        expect "state-specimen-copying" { visible = css(".a3s-component-state-matrix[open][data-component=copy-button] [data-state-specimen=copying] button.copy-button[data-state-specimen-root=copying][data-state=copying][aria-busy=true]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=copy-button] [data-state-specimen=error] button.copy-button[data-state-specimen-root=error][data-state=error]") }
        screenshot "copy-button-states" { path = "components/copy-button-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=copy-button][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/copy-button.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("button.copy-button[data-copy-primary-demo=zh]") }
        focus "focus-chinese-copy" { target = css("button.copy-button[data-copy-primary-demo=zh]") }
        press "activate-chinese-copy" { key = "Enter" }
        wait "chinese-copied" { visible = css("button.copy-button[data-copy-primary-demo=zh][data-state=copied]") }
        expect "chinese-feedback" { text = "已复制" }
        screenshot "copy-button-chinese-phone" { path = "components/copy-button-chinese-phone.png" }
        accessibility "copy-button-accessibility" { path = "components/copy-button-accessibility.json" interactive = true }
        console "copy-button-console" { path = "components/copy-button-console.json" clear = false }
        page_errors "copy-button-errors" { path = "components/copy-button-errors.json" clear = false }
    }

    scenario "date-picker" {
        name = "Date Picker preserves min/max bounds, leap-day entry, empty and overflow recovery, native availability, and compact Chinese confirmation"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/date-picker.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=date-picker][data-preview-integration=complete][data-preview-source=ready]") }

        expect "canonical-bounded-root" { visible = css("form[data-date-picker-primary-demo=en][data-date-value='2026-08-14'] #date-target-en.date-picker[type=date][required][min='2024-01-01'][max='2028-12-31']:not([disabled]):not([readonly])") }
        expect "fixtures-ready" { visible = css("form[data-date-picker-primary-demo=en] [data-date-fixtures=en]") }

        click "load-leap-day" { target = css("form[data-date-picker-primary-demo=en] [data-date-fixture=leap-day]") }
        wait "leap-fixture-ready" { text = "Fixture loaded leap day 2028-02-29." }
        click "accept-leap-day" { target = role("button", "Check date") }
        wait "leap-day-status" { text = "Target date accepted as a local calendar day." }
        expect "leap-day-accepted" { text = "Target date accepted as a local calendar day." }
        expect "leap-day-recorded" { visible = css("form[data-date-picker-primary-demo=en][data-date-value='2028-02-29']") }
        screenshot "date-picker-leap-day" { path = "components/date-picker-leap-day.png" }

        click "load-overflow-date" { target = css("form[data-date-picker-primary-demo=en] [data-date-fixture=overflow]") }
        wait "overflow-fixture-ready" { text = "Fixture loaded overflow date 2029-01-01." }
        click "reject-overflow" { target = role("button", "Check date") }
        wait "overflow-status" { visible = css("form[data-date-picker-primary-demo=en] .field[data-invalid=true]:has(#date-target-en[aria-invalid=true])") }
        expect "overflow-invalid" { visible = css("form[data-date-picker-primary-demo=en] .field[data-invalid=true]:has(#date-target-en[aria-invalid=true])") }
        expect "overflow-message" { text = "Choose a date between 2024-01-01 and 2028-12-31." }
        screenshot "date-picker-overflow" { path = "components/date-picker-overflow.png" }

        click "clear-date-empty" { target = css("form[data-date-picker-primary-demo=en] [data-date-fixture=empty]") }
        wait "empty-fixture-ready" { text = "Fixture cleared the target date." }
        click "reject-empty" { target = role("button", "Check date") }
        wait "empty-status" { visible = css("form[data-date-picker-primary-demo=en] .field[data-invalid=true]:has(#date-target-en[aria-invalid=true])") }
        expect "empty-invalid" { visible = css("form[data-date-picker-primary-demo=en] .field[data-invalid=true]:has(#date-target-en[aria-invalid=true])") }
        expect "empty-message" { text = "Choose a target date." }
        screenshot "date-picker-empty" { path = "components/date-picker-empty.png" }

        expect "disabled-keeps-native-lock" { visible = css("[data-date-picker-availability=en] .field[data-disabled=true]:has(#date-disabled-en.date-picker[disabled][value='2025-12-01'])") }
        expect "readonly-keeps-native-lock" { visible = css("[data-date-picker-availability=en] .field[data-readonly=true]:has(#date-readonly-en.date-picker[readonly][value='2026-03-18'])") }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=date-picker][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=date-picker]") }
        expect "state-specimen-disabled" { visible = css(".a3s-component-state-matrix[open][data-component=date-picker] [data-state-specimen=disabled] input.date-picker[data-state-specimen-root=disabled][disabled]") }
        expect "state-specimen-invalid" { visible = css(".a3s-component-state-matrix[open][data-component=date-picker] [data-state-specimen=invalid] input.date-picker[data-state-specimen-root=invalid][aria-invalid=true]") }
        expect "state-specimen-readonly" { visible = css(".a3s-component-state-matrix[open][data-component=date-picker] [data-state-specimen=read-only] input.date-picker[data-state-specimen-root='read-only'][readonly]") }
        screenshot "date-picker-states" { path = "components/date-picker-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=date-picker][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
        navigate "open-chinese-phone" { url = "http://127.0.0.1:4178/UI/components/date-picker.html" }
        wait "chinese-phone-loaded" { load = "domcontentloaded" }
        wait "chinese-phone-page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "chinese-phone-ready" { visible = css("form[data-date-picker-primary-demo=zh] #date-target-zh") }
        click "load-chinese-leap" { target = css("form[data-date-picker-primary-demo=zh] [data-date-fixture=leap-day]") }
        wait "chinese-fixture-ready" { text = "已加载闰日夹具 2028-02-29。" }
        click "accept-chinese-date" { target = role("button", "检查日期") }
        wait "chinese-status" { text = "已接受本地日历日作为目标日期。" }
        expect "chinese-accepted" { text = "已接受本地日历日作为目标日期。" }
        screenshot "date-picker-chinese-phone" { path = "components/date-picker-chinese-phone.png" }
        accessibility "date-picker-accessibility" { path = "components/date-picker-accessibility.json" interactive = true }
        console "date-picker-console" { path = "components/date-picker-console.json" clear = false }
        page_errors "date-picker-errors" { path = "components/date-picker-errors.json" clear = false }
    }

    scenario "editable-text" {
        name = "Editable Text preserves Escape cancel, empty rejection, async save, focus return, and compact Chinese editing"
        surface = "web"
        timeout_ms = 90000
        viewport "desktop" { width = 1440 height = 1000 }
        navigate "open" { url = "http://127.0.0.1:4178/UI/en/components/editable-text.html" }
        wait "loaded" { load = "networkidle" }
        wait "page-ready" { visible = css("html:not([data-a3s-defer-init])") }
        wait "preview-ready" { visible = css(".a3s-preview[data-preview-component=editable-text][data-preview-integration=complete][data-preview-source=ready]") }

        expect "canonical-display-root" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=display][data-editable-required]:has([data-editable-value]):has([data-editable-action=edit]):has([data-editable-form][aria-hidden=true])") }

        focus "focus-begin-edit" { target = css("[data-editable-primary-demo=en] [data-editable-action=edit]") }
        press "begin-edit" { key = "Enter" }
        wait "edit-mode" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=editing] input[aria-label=Title]:not([disabled])") }
        fill "draft-then-escape" { target = css("[data-editable-primary-demo=en] input[aria-label=Title]") value = "Scratch draft" }
        press "cancel-with-escape" { key = "Escape" }
        expect "escape-restores-display" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=display]:has([data-editable-value])") }
        expect "escape-restores-authored-value" { text = "Release notes" }
        expect "escape-returns-focus-to-edit" { visible = css("[data-editable-primary-demo=en] [data-editable-action=edit]:focus") }

        focus "focus-edit-for-empty" { target = css("[data-editable-primary-demo=en] [data-editable-action=edit]") }
        press "begin-empty-edit" { key = "Enter" }
        wait "empty-edit-mode" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=editing] input[aria-label=Title]") }
        fill "clear-title" { target = css("[data-editable-primary-demo=en] input[aria-label=Title]") value = "x" }
        fill "clear-title-empty" { target = css("[data-editable-primary-demo=en] input[aria-label=Title]") value = "" }
        press "submit-empty-title" { key = "Enter" }
        expect "empty-rejected-as-error" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=error]:has(input[aria-label=Title][aria-invalid=true])") }
        screenshot "editable-text-empty-error" { path = "components/editable-text-empty-error.png" }
        press "escape-from-error" { key = "Escape" }
        expect "error-cancel-restores-display" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=display]:not([aria-busy])") }

        focus "focus-edit-for-save" { target = css("[data-editable-primary-demo=en] [data-editable-action=edit]") }
        press "begin-valid-edit" { key = "Enter" }
        wait "valid-edit-mode" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=editing] input[aria-label=Title]") }
        fill "change-title" { target = css("[data-editable-primary-demo=en] input[aria-label=Title]") value = "Release plan" }
        press "commit-title" { key = "Enter" }
        wait "saving-state" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=saving][aria-busy=true]:has(input[aria-label=Title][disabled])") }
        expect "saving-blocks-input" { visible = css(".editable-text[data-editable-primary-demo=en][aria-busy=true] input[aria-label=Title][disabled]") }
        screenshot "editable-text-saving" { path = "components/editable-text-saving.png" }
        wait "saved-display" { visible = css(".editable-text[data-editable-primary-demo=en][data-state=display]:not([aria-busy]):has([data-editable-value])") }
        expect "title-committed" { text = "Release plan" }
        expect "save-returns-focus-to-edit" { visible = css("[data-editable-primary-demo=en] [data-editable-action=edit]:focus") }
        screenshot "editable-text-saved" { path = "components/editable-text-saved.png" }

        focus "focus-state-matrix" { target = css(".a3s-preview[data-preview-component=editable-text][data-preview-integration=complete] [data-preview-control=states]") }
        press "open-state-matrix" { key = "Enter" }
        wait "state-matrix-open" { visible = css(".a3s-component-state-matrix[open][data-component=editable-text]") }
        expect "state-specimen-saving" { visible = css(".a3s-component-state-matrix[open][data-component=editable-text] [data-state-specimen=saving] .editable-text[data-state-specimen-root=saving][data-state=saving][aria-busy=true]") }
        expect "state-specimen-error" { visible = css(".a3s-component-state-matrix[open][data-component=editable-text] [data-state-specimen=error] .editable-text[data-state-specimen-root=error][data-state=error]") }
        screenshot "editable-text-states" { path = "components/editable-text-states.png" }
        press "close-state-matrix" { key = "Escape" }
        expect "state-trigger-restored" { visible = css(".a3s-preview[data-preview-component=editable-text][data-preview-integration=complete] [data-preview-control=states]:focus") }

        viewport "phone" { width = 390 height = 844 }
