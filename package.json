  "scripts": {
    "build": "node ./scripts/build.js",
    "check:coverage": "node ./scripts/check-reference-coverage.mjs",
    "check:coverage:strict": "node ./scripts/check-reference-coverage.mjs --strict",
    "check:framework-docs": "node ./scripts/generate-framework-docs.mjs --check",
    "check:boundaries": "node ./tests/reference-boundaries.mjs",
    "prepare": "node ./scripts/build.js",
    "prepack": "node ./scripts/build.js",
    "prepublishOnly": "npm run build && npm run check:package",
    "check:package": "node ./scripts/check-package.mjs",
    "check:frameworks": "node ./tests/framework-adapters.mjs",
    "release:check": "npm run check:coverage:strict && npm run check:framework-docs && npm run check:boundaries && npm run build && npm run check:package && npm run check:frameworks && npm run docs:build && npm run test:e2e:a3s:check",
    "docs:build": "npm run build && npm --prefix site clean-install --registry=https://registry.npmjs.org/ --replace-registry-host=never --progress=false && npm --prefix site run build && npm --prefix site run check:site",
    "docs:dev": "npm run build && npm --prefix site run dev",
    "docs:preview": "npm run docs:build && npm --prefix site run preview",
    "test:e2e:a3s": "npm run docs:build && node ./scripts/run-a3s-e2e.mjs",
    "test:e2e:a3s:check": "node ./scripts/run-a3s-e2e.mjs --check-only",
    "test:visual": "npm run build && playwright test --config playwright.config.ts",
    "test:components:semantic": "npm run build && playwright test visual-tests/component-ai-contracts.visual.spec.ts --config playwright.config.ts --project desktop-1280",
    "test:visual:update": "npm run build && playwright test --config playwright.config.ts --update-snapshots"
  },
