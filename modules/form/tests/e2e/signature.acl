suite "a3s-form-signature" {
    version = 1

    scenario "design-and-save-typed-signature" {
        name = "Designer configures and saves a typed signature"
        surface = "web"
        timeout_ms = 90000

        navigate "open-workspace" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "desktop" {
            width = 1440
            height = 1000
        }

        wait "workspace-ready" {
            text = "我的表单"
        }

        click "open-onboarding" {
            target = role("button", "打开新员工入职申请")
        }

        wait "compiled" {
            text = "编译通过"
        }

        click "open-components" {
            target = role("tab", "组件")
        }

        click "select-root" {
            target = css(".a3s-form-page-heading")
        }

        click "add-signature" {
            target = role("button", "添加签名字段")
        }

        expect "signature-on-canvas" {
            visible = css("article[data-node-type='a3s.signature'] .a3s-form-signature-design")
        }

        fill "rename-signature" {
            target = css("[aria-label='字段标题']")
            value = "发布确认签名"
        }

        select "typed-only" {
            target = css("select[aria-label='签名方式']")
            values = ["typed"]
        }

        expect "typed-setting-selected" {
            visible = css("select[aria-label='签名方式'] option[value='typed']:checked")
        }

        click "preview" {
            target = role("button", "预览")
        }

        expect "typed-editor" {
            visible = css(".a3s-form-signature input[aria-label='签署姓名']")
        }

        fill "signing-name" {
            target = label("签署姓名")
            value = "林予安"
        }

        click "save-signature" {
            target = role("button", "保存签名")
        }

        wait "signature-saved" {
            text = "签名已保存"
        }

        expect "closed-saved-state" {
            visible = css(".a3s-form-signature .a3s-form-signature-saved")
        }

        expect "typed-method-retained" {
            text = "键入签名"
        }

        viewport "mobile" {
            width = 390
            height = 844
            scale = 2
        }

        expect "mobile-saved-state" {
            visible = css(".a3s-form-designer[data-mode='preview'] .a3s-form-signature-saved")
        }

        screenshot "mobile-signature" {
            path = "screenshots/mobile-signature.png"
        }

        accessibility "mobile-tree" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "console" {
            path = "evidence/console.json"
            clear = false
        }

        page_errors "page-errors" {
            path = "evidence/page-errors.json"
            clear = false
        }
    }
}
