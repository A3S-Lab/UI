suite "a3s-form-wizard-onboarding" {
    version = 1

    scenario "branch-validation-review" {
        name = "Wizard branches validate pages and retain review values"
        surface = "web"
        timeout_ms = 120000

        navigate "open-workspace" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "desktop" {
            width = 1440
            height = 1000
        }

        wait "workspace-ready" {
            text = "我的表单"
        }

        click "open-wizard" {
            target = role("button", "打开组织入驻向导")
        }

        wait "compiled" {
            text = "编译通过"
        }

        click "preview" {
            target = role("button", "预览")
        }

        click "invalid-next" {
            target = role("button", "下一步")
        }

        expect "required-field-focused" {
            visible = css(".a3s-form-field[data-invalid] input:focus")
        }

        fill "workspace-name" {
            target = label("空间名称")
            value = "分布式产品组"
        }

        press "enter-to-advance" {
            key = "Enter"
        }

        expect "personal-branch-skips-verification" {
            visible = css(".a3s-form-wizard-page input[id*='contact-email']")
        }

        fill "reserved-email" {
            target = label("联系邮箱")
            value = "used@a3s.dev"
        }

        click "host-invalid-next" {
            target = role("button", "下一步")
        }

        expect "host-page-error" {
            text = "该企业邮箱已被占用。"
        }

        fill "valid-email" {
            target = label("联系邮箱")
            value = "owner@example.test"
        }

        click "open-personal-review" {
            target = role("button", "下一步")
        }

        expect "personal-value-retained" {
            text = "分布式产品组"
        }

        expect "email-value-retained" {
            text = "owner@example.test"
        }

        click "edit-workspace" {
            target = role("button", "编辑空间名称")
        }

        expect "edited-value-retained" {
            visible = css("input[id*='workspace-name'][value='分布式产品组']")
        }

        click "enterprise-branch" {
            target = css("input[type='radio'][value='enterprise']")
        }

        expect "enterprise-step-added" {
            text = "企业认证"
        }

        click "open-verification" {
            target = role("button", "下一步")
        }

        fill "registration-number" {
            target = label("企业登记号")
            value = "REG-2026-001"
        }

        click "return-to-contact" {
            target = role("button", "下一步")
        }

        expect "contact-value-survives-branch-change" {
            visible = css("input[id*='contact-email'][value='owner@example.test']")
        }

        click "open-enterprise-review" {
            target = role("button", "下一步")
        }

        expect "registration-in-review" {
            text = "REG-2026-001"
        }

        screenshot "desktop-review" {
            path = "screenshots/desktop-review.png"
        }

        viewport "mobile" {
            width = 390
            height = 844
        }

        expect "mobile-review" {
            visible = css(".a3s-form-designer[data-mode='preview'] .a3s-form-wizard-review")
        }

        screenshot "capture-mobile-review" {
            path = "screenshots/mobile-review.png"
        }

        accessibility "mobile-tree" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "console" {
            path = "evidence/console.json"
            clear = false
        }

        page_errors "page-errors" {
            path = "evidence/page-errors.json"
            clear = false
        }
    }
}
