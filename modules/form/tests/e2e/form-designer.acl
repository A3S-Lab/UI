suite "a3s-form-designer" {
    version = 1

    scenario "design-preview-submit" {
        name = "中文表单从设计到提交"
        surface = "web"
        timeout_ms = 60000

        navigate "open" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "desktop" {
            width = 1440
            height = 1100
        }

        wait "workspace-ready" {
            text = "我的表单"
        }

        expect "sample-form-ready" {
            text = "新员工入职申请"
        }

        expect "workspace-uses-a3s-shell" {
            visible = css("main.app-shell[data-navigation='expanded'] [data-app-main]")
        }

        click "open-sample-form" {
            target = role("button", "打开新员工入职申请")
        }

        wait "editor-ready" {
            text = "表单内容"
        }

        expect "designer-ready" {
            text = "● 编译通过"
        }

        expect "editor-uses-a3s-workspace-header" {
            visible = css(".playground-header.workspace-header")
        }

        expect "designer-uses-a3s-workspace-header" {
            visible = css(".a3s-form-designer-toolbar.workspace-header")
        }

        expect "export-action-has-accessible-name" {
            visible = css("button[aria-label='导出表单']")
        }

        expect "save-action-has-accessible-name" {
            visible = css("button[aria-label='保存表单']")
        }

        click "add-number" {
            target = role("button", "添加数字字段")
        }

        fill "rename-number" {
            target = css("[aria-label='字段标题']")
            value = "工龄"
        }

        click "validation-settings" {
            target = role("tab", "校验")
        }

        expect "validation-ready" {
            visible = css("label.a3s-form-toggle")
        }

        click "require-number" {
            target = css("label.a3s-form-toggle:has(input[aria-label='必填字段'])")
        }

        click "open-structure" {
            target = role("tab", "结构")
        }

        click "select-start-date" {
            target = role("treeitem", "选择入职日期")
        }

        click "start-date-validation" {
            target = role("tab", "校验")
        }

        expect "start-date-validation-ready" {
            visible = css("label.a3s-form-toggle")
        }

        click "optional-start-date" {
            target = css("label.a3s-form-toggle:has(input[aria-label='必填字段'])")
        }

        expect "field-updated" {
            text = "工龄"
        }

        click "preview" {
            target = role("button", "预览")
        }

        expect "preview-updated" {
            text = "工龄"
        }

        expect "preview-is-focused" {
            visible = css(".a3s-form-designer[data-mode='preview'] .a3s-form-designer-main.is-preview > .a3s-form-canvas .a3s-form-renderer")
        }

        expect "renderer-uses-a3s-fields" {
            visible = css(".a3s-form-renderer .field .input")
        }

        expect "renderer-uses-a3s-actions" {
            visible = css(".a3s-form-renderer .btn[data-variant='primary']")
        }

        click "submit-empty" {
            target = css(".a3s-form-renderer button[type='submit']")
        }

        expect "required-validation" {
            text = "此项为必填项。"
        }

        fill "name" {
            target = css("[id$='-name']")
            value = "张三"
        }

        fill "invalid-email" {
            target = css("[id$='-email']")
            value = "invalid-email"
        }

        select "department" {
            target = css("[id$='-department']")
            values = ["engineering"]
        }

        fill "years" {
            target = css("[id$='-field-1']")
            value = "3"
        }

        click "submit-invalid-email" {
            target = css(".a3s-form-renderer button[type='submit']")
        }

        expect "email-validation" {
            text = "请输入有效的电子邮箱。"
        }

        fill "valid-email" {
            target = css("[id$='-email']")
            value = "zhangsan@example.com"
        }

        click "submit-valid" {
            target = css(".a3s-form-renderer button[type='submit']")
        }

        expect "submitted" {
            text = "申请已提交，正在等待审批。"
        }

        click "save-draft" {
            target = role("button", "保存草稿")
        }

        expect "draft-saved" {
            text = "草稿已保存。"
        }

        click "design" {
            target = role("button", "设计")
        }

        click "open-components" {
            target = role("tab", "组件")
        }

        click "select-root" {
            target = css(".a3s-form-page-heading")
        }

        click "add-custom-rating" {
            target = role("button", "添加评分字段")
        }

        expect "custom-rating-on-canvas" {
            visible = css("article[data-node-type='a3s.rating']")
        }

        fill "configure-custom-rating" {
            target = css("[aria-label='评分最大星数']")
            value = "7"
        }

        click "preview-custom-rating" {
            target = role("button", "预览")
        }

        click "choose-custom-rating" {
            target = css(".playground-rating-node > div > label:nth-child(4)")
        }

        expect "custom-rating-value" {
            text = "4 / 7"
        }

        click "resume-design" {
            target = role("button", "设计")
        }

        click "select-root-for-layout" {
            target = css(".a3s-form-page-heading")
        }

        click "add-two-columns" {
            target = role("button", "添加两栏布局")
        }

        expect "first-column" {
            visible = css("[data-node-id='column-1']")
        }

        expect "second-column" {
            visible = css("[data-node-id='column-2']")
        }

        drag "field-into-column" {
            source = css("[aria-label='添加单行文本字段']")
            target = css("[aria-label='插入到column-1第1位']")
        }

        expect "field-in-column" {
            visible = css("[data-node-id='column-1'] .a3s-form-design-field")
        }

        click "select-root-again" {
            target = css(".a3s-form-page-heading")
        }

        click "add-tabs" {
            target = role("button", "添加标签页")
        }

        click "second-tab" {
            target = role("tab", "标签页 2")
        }

        click "save-document" {
            target = role("button", "保存表单")
        }

        expect "document-saved" {
            text = "已保存"
        }

        press "save-shortcut" {
            key = "Meta+s"
        }

        expect "shortcut-saved" {
            text = "已保存到当前浏览器。"
        }
    }

    scenario "create-and-restore-local-form" {
        name = "在线创建多个表单并从浏览器本地恢复"
        surface = "web"
        timeout_ms = 30000

        navigate "open-workspace" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "workspace-desktop" {
            width = 1440
            height = 1000
        }

        wait "form-list-ready" {
            text = "我的表单"
        }

        click "open-create-dialog" {
            target = role("button", "新建表单")
        }

        fill "new-form-title" {
            target = css("[aria-label='新表单名称']")
            value = "客户满意度调查"
        }

        fill "new-form-description" {
            target = css("[aria-label='新表单说明']")
            value = "收集产品使用反馈"
        }

        click "create-form" {
            target = role("button", "创建并开始设计")
        }

        wait "new-form-editor" {
            text = "客户满意度调查"
        }

        expect "blank-canvas-ready" {
            text = "从左侧添加字段和布局组件。"
        }

        click "back-to-form-list" {
            target = role("button", "返回表单列表")
        }

        expect "new-form-card" {
            visible = css("[aria-label='打开客户满意度调查']")
        }

        navigate "reload-workspace" {
            url = "http://127.0.0.1:4176/"
        }

        wait "restored-local-form" {
            text = "客户满意度调查"
        }

        expect "restored-form-card" {
            visible = css("[aria-label='打开客户满意度调查']")
        }
    }

    scenario "mobile-authoring-and-preview" {
        name = "移动端设计与聚焦预览"
        surface = "web"
        timeout_ms = 30000

        navigate "open-mobile-workspace" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "mobile" {
            width = 390
            height = 844
        }

        wait "mobile-workspace-ready" {
            text = "我的表单"
        }

        expect "mobile-navigation-closed" {
            visible = css("main.app-shell[data-mobile-navigation='closed'] [data-app-main]")
        }

        click "open-mobile-form" {
            target = role("button", "打开新员工入职申请")
        }

        wait "mobile-editor-ready" {
            text = "表单画布"
        }

        expect "mobile-panel-navigation" {
            visible = css(".a3s-form-mobile-panel-bar")
        }

        click "mobile-components" {
            target = role("button", "组件")
        }

        expect "mobile-catalog" {
            visible = css(".is-mobile-panel-components .a3s-form-palette")
        }

        click "mobile-canvas" {
            target = role("button", "画布")
        }

        expect "mobile-canvas-visible" {
            visible = css(".is-mobile-panel-canvas .a3s-form-canvas")
        }

        click "mobile-preview" {
            target = role("button", "预览")
        }

        expect "mobile-focused-preview" {
            visible = css(".a3s-form-designer[data-mode='preview'] .a3s-form-renderer")
        }

        screenshot "mobile-preview-evidence" {
            path = "screenshots/mobile-focused-preview.png"
        }
    }

    scenario "import-validated-form-json" {
        name = "导入并校验 A3S Form JSON"
        surface = "web"
        timeout_ms = 30000

        navigate "open-import-workspace" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "import-desktop" {
            width = 1440
            height = 1000
        }

        wait "import-workspace-ready" {
            text = "我的表单"
        }

        upload "import-form" {
            target = css("input[aria-label='导入表单 JSON']")
            paths = ["tests/fixtures/import-form.json"]
        }

        wait "imported-editor-ready" {
            text = "导入验收表单"
        }

        expect "imported-document-compiled" {
            text = "编译通过"
        }

        expect "imported-field-ready" {
            visible = css("[data-node-id='project-name']")
        }
    }
}
