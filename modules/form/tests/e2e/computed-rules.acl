suite "a3s-form-computed-rules" {
    version = 1

    scenario "computed-onboarding-record" {
        name = "计算字段按输入实时更新"
        surface = "web"
        timeout_ms = 90000

        navigate "open-workspace" {
            url = "http://127.0.0.1:4176/"
        }

        viewport "desktop" {
            width = 1440
            height = 1000
        }

        wait "workspace-ready" {
            text = "我的表单"
        }

        click "open-onboarding" {
            target = role("button", "打开新员工入职申请")
        }

        wait "compiled" {
            text = "编译通过"
        }

        click "preview" {
            target = role("button", "预览")
        }

        expect "computed-field-read-only" {
            visible = css("input[aria-label='入职记录']:disabled")
        }

        fill "name" {
            target = label("姓名")
            value = "张三"
        }

        select "department" {
            target = css("select[aria-label='所属部门']")
            values = ["engineering"]
        }

        expect "computed-value" {
            visible = css("input[aria-label='入职记录'][value='张三 · engineering']:disabled")
        }

        accessibility "computed-state" {
            path = "evidence/computed-state.json"
            interactive = true
        }

        console "console" {
            path = "evidence/console.json"
            clear = false
        }

        page_errors "page-errors" {
            path = "evidence/page-errors.json"
            clear = false
        }
    }
}
