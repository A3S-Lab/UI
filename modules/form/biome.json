{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!coverage",
      "!!.a3s-test",
      "!!node_modules",
      "!!node_modules.relocated-link",
      "!!assets/readme",
      "!!src/wasm/form-core-binary.ts",
      "!!crates/**/target",
      "!!wasm/**/target"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
